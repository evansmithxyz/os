   446 00003F4A 56                  <1>     push rsi
   447 00003F4B 57                  <1>     push rdi
   448 00003F4C 4154                <1>     push r12
   449                              <1> 
   450 00003F4E 8B06                <1>     mov eax, [rsi]              ; Target IP
   451                              <1> 
   452                              <1>     ; Fast path: If target is Gateway or DNS, route directly via Gateway MAC!
   453 00003F50 3B05D6F5FFFF        <1>     cmp eax, [net_gateway]
