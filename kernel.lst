   216                              <1> 
   217                              <1>     ; Build ARP Reply (28 bytes)
   218 00003D71 488D3D68FEFFFF      <1>     lea rdi, [arp_pkt_buf]
   219                              <1> 
   220                              <1>     ; HW Type = 0x0001
