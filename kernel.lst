   237                              <1> 
   238                              <1>     ; Check if mouse button is held while moving inside canvas (Brush Dragging)
   239 000090A8 F605CFEEFFFF01      <1>     test byte [mouse_buttons], 0x01
   240 000090AF 7405                <1>     jz .draw_new_cursor
   241 000090B1 E89D010000          <1>     call gui_handle_canvas_drag
   242                              <1> 
