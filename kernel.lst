   192                              <1> .no_payload:
   193                              <1>     ; Calculate total length for checksum = 12 (pseudo) + 20 (tcp) + payload_len
   194 000077F0 4C89D1              <1>     mov rcx, r10
   195 000077F3 4883C120            <1>     add rcx, 32
   196                              <1> 
   197                              <1>     ; Pad odd byte with zero for clean checksum calculation
   198 000077F7 48F7C101000000      <1>     test rcx, 1
   199 000077FE 740E                <1>     jz .do_csum
   200 00007800 488D3D39DFFFFF      <1>     lea rdi, [tcp_tx_packet]
   201 00007807 C6040F00            <1>     mov byte [rdi + rcx], 0
   202 0000780B 48FFC1              <1>     inc rcx
   203                              <1> 
   204                              <1> .do_csum:
   205                              <1>     ; Calculate checksum over pseudo-header + TCP header + payload
   206 0000780E 488D352BDFFFFF      <1>     lea rsi, [tcp_tx_packet]
   207 00007815 E820CFFFFF          <1>     call net_checksum
   208                              <1> 
   209                              <1>     ; If computed checksum is 0x0000, RFC specifies sending 0xFFFF
   210 0000781A 6685C0              <1>     test ax, ax
   211 0000781D 7504                <1>     jnz .store_csum
   212 0000781F 66B8FFFF            <1>     mov ax, 0xFFFF
   213                              <1> 
   214                              <1> .store_csum:
   215                              <1>     ; Write checksum into TCP Header (offset 12 + 16 = 28)
   216 00007823 66890532DFFFFF      <1>     mov [tcp_tx_packet + 28], ax
   217                              <1> 
   218                              <1>     ; 4. Transmit TCP Segment via IPv4 Layer
   219                              <1>     ; Payload for IPv4 = TCP Header (20 bytes) + TCP Payload (r10 bytes)
   220 0000782A 488D351BDFFFFF      <1>     lea rsi, [tcp_tx_packet + 12]
   221 00007831 4C89D1              <1>     mov rcx, r10
   222 00007834 4883C114            <1>     add rcx, 20
   223 00007838 488D3DEFDEFFFF      <1>     lea rdi, [tcp_remote_ip]
   224 0000783F B206                <1>     mov dl, IPV4_PROTO_TCP
   225 00007841 E83DCFFFFF          <1>     call ipv4_send_packet
   226                              <1> 
   227 00007846 415B                <1>     pop r11
   228 00007848 415A                <1>     pop r10
   229 0000784A 4159                <1>     pop r9
   230 0000784C 4158                <1>     pop r8
   231 0000784E 5F                  <1>     pop rdi
   232 0000784F 5E                  <1>     pop rsi
   233 00007850 5A                  <1>     pop rdx
   234 00007851 59                  <1>     pop rcx
   235 00007852 5B                  <1>     pop rbx
   236 00007853 C3                  <1>     ret
   237                              <1> 
   238                              <1> ; ------------------------------------------------------------------------------
   239                              <1> ; tcp_handle_packet: Dispatches incoming TCP packet from IPv4 layer
   240                              <1> ; Input:
   241                              <1> ;   RSI = Pointer to TCP packet (Header + Payload)
   242                              <1> ;   RCX = Packet length
   243                              <1> ;   RDX = Pointer to 4-byte Source IPv4 address
   244                              <1> ; ------------------------------------------------------------------------------
   245                              <1> tcp_handle_packet:
   246 00007854 50                  <1>     push rax
   247 00007855 53                  <1>     push rbx
   248 00007856 51                  <1>     push rcx
   249 00007857 52                  <1>     push rdx
   250 00007858 56                  <1>     push rsi
   251 00007859 57                  <1>     push rdi
   252 0000785A 4150                <1>     push r8
   253 0000785C 4151                <1>     push r9
   254 0000785E 4152                <1>     push r10
   255 00007860 4153                <1>     push r11
   256 00007862 4154                <1>     push r12
   257 00007864 4157                <1>     push r15
   258                              <1> 
   259 00007866 4989D7              <1>     mov r15, rdx                ; R15 = Source IP pointer
   260                              <1> 
   261                              <1>     ; TCP header is at least 20 bytes
   262 00007869 4883F914            <1>     cmp rcx, 20
   263 0000786D 0F821C020000        <1>     jb .drop
   264                              <1> 
   265                              <1>     ; Extract Source Port (Big Endian -> Host Order)
   266 00007873 0FB606              <1>     movzx eax, byte [rsi + 0]
   267 00007876 C1E008              <1>     shl eax, 8
   268 00007879 8A4601              <1>     mov al, [rsi + 1]
   269 0000787C 664189C3            <1>     mov r11w, ax                ; R11W = Source Port
   270                              <1> 
   271                              <1>     ; Extract Destination Port (Big Endian -> Host Order)
   272 00007880 0FB64602            <1>     movzx eax, byte [rsi + 2]
   273 00007884 C1E008              <1>     shl eax, 8
   274 00007887 8A4603              <1>     mov al, [rsi + 3]
   275 0000788A 664189C4            <1>     mov r12w, ax                ; R12W = Dest Port
   276                              <1> 
   277                              <1>     ; Extract Sequence Number (Big Endian -> Host Order)
   278 0000788E 8B4604              <1>     mov eax, [rsi + 4]
   279 00007891 0FC8                <1>     bswap eax
   280 00007893 4189C1              <1>     mov r9d, eax                ; R9D = Remote Seq
   281                              <1> 
   282                              <1>     ; Extract Acknowledgment Number (Big Endian -> Host Order)
   283 00007896 8B4608              <1>     mov eax, [rsi + 8]
   284 00007899 0FC8                <1>     bswap eax
   285 0000789B 4189C2              <1>     mov r10d, eax               ; R10D = Remote Ack
   286                              <1> 
   287                              <1>     ; Extract Data Offset (Header size)
   288 0000789E 0FB65E0C            <1>     movzx ebx, byte [rsi + 12]
   289 000078A2 C1EB04              <1>     shr ebx, 4
   290 000078A5 C1E302              <1>     shl ebx, 2                  ; EBX = TCP Header length in bytes
   291 000078A8 83FB14              <1>     cmp ebx, 20
   292 000078AB 0F82DE010000        <1>     jb .drop
   293                              <1> 
   294                              <1>     ; Extract TCP Flags
   295 000078B1 440FB6460D          <1>     movzx r8d, byte [rsi + 13]  ; R8D = Flags
   296                              <1> 
   297                              <1>     ; Calculate Payload Length: Total length (RCX) - Header length (EBX)
   298 000078B6 89C8                <1>     mov eax, ecx
   299 000078B8 29D8                <1>     sub eax, ebx
   300 000078BA 89C2                <1>     mov edx, eax                ; EDX = Payload length
   301                              <1> 
   302                              <1>     ; Check RST Flag
   303 000078BC 41F6C004            <1>     test r8b, TCP_FLAG_RST
   304 000078C0 7413                <1>     jz .check_state
   305 000078C2 C60575DEFFFF01      <1>     mov byte [tcp_reset_received], 1
   306 000078C9 C60558DEFFFF00      <1>     mov byte [tcp_active_state], TCP_STATE_CLOSED
   307 000078D0 E9BA010000          <1>     jmp .drop
   308                              <1> 
   309                              <1> .check_state:
   310                              <1>     ; --------------------------------------------------------------------------
   311                              <1>     ; State 1: TCP_STATE_LISTEN (Server Mode)
   312                              <1>     ; --------------------------------------------------------------------------
   313 000078D5 803D4CDEFFFF01      <1>     cmp byte [tcp_active_state], TCP_STATE_LISTEN
   314 000078DC 7560                <1>     jne .state_syn_rcvd
   315                              <1> 
   316                              <1>     ; Must be destined for our listening port
   317 000078DE 66443B2544DEFFFF    <1>     cmp r12w, [tcp_local_port]
   318 000078E6 0F85A3010000        <1>     jne .drop
   319                              <1> 
   320                              <1>     ; Must be a SYN packet
   321 000078EC 41F6C002            <1>     test r8b, TCP_FLAG_SYN
   322 000078F0 0F8499010000        <1>     jz .drop
