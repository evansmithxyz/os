   154 00003326 488D35C3FEFFFF      <1>     lea rsi, [MSG_NET_FOUND]
   155 0000332D E88BCFFFFF          <1>     call vga_print_string_color
   156                              <1> 
   157 00003332 0FB7050AF2FFFF      <1>     movzx eax, word [net_io_base]
