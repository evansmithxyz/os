  1811 0000C55C E9CA010000          <1>     jmp .tab_done
  1812                              <1> 
  1813                              <1> .tab_valid_file_arg:
  1814                              <1>     ; RDI points to filename prefix to match in fs_inode_table
  1815 0000C561 4889FE              <1>     mov rsi, rdi
