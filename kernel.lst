    89 0000165F B020                <1>     mov al, 0x20
    90 00001661 E620                <1>     out 0x20, al
    91                              <1> 
    92 00001663 415F                <1>     pop r15
    93 00001665 415E                <1>     pop r14
    94 00001667 415D                <1>     pop r13
    95 00001669 415C                <1>     pop r12
    96 0000166B 415B                <1>     pop r11
    97 0000166D 415A                <1>     pop r10
    98 0000166F 4159                <1>     pop r9
    99 00001671 4158                <1>     pop r8
   100 00001673 5D                  <1>     pop rbp
   101 00001674 5F                  <1>     pop rdi
   102 00001675 5E                  <1>     pop rsi
   103 00001676 5A                  <1>     pop rdx
   104 00001677 59                  <1>     pop rcx
   105 00001678 5B                  <1>     pop rbx
   106 00001679 58                  <1>     pop rax
   107 0000167A 48CF                <1>     iretq
   108                              <1> 
   109                              <1> ; ------------------------------------------------------------------------------
   110                              <1> ; IRQ 12 - PS/2 Mouse Controller (Vector 0x2C)
   111                              <1> ; ------------------------------------------------------------------------------
   112                              <1> isr_mouse:
   113 0000167C 50                  <1>     push rax
   114                              <1>     ; In case an interrupt fires, read port 0x60 if output full, then EOI
   115 0000167D E464                <1>     in al, 0x64
   116 0000167F A801                <1>     test al, 0x01
   117 00001681 7402                <1>     jz .eoi
   118 00001683 E460                <1>     in al, 0x60
   119                              <1> .eoi:
   120 00001685 B020                <1>     mov al, 0x20
   121 00001687 E6A0                <1>     out 0xA0, al                ; EOI to Slave PIC
   122 00001689 E620                <1>     out 0x20, al                ; EOI to Master PIC
   123 0000168B 58                  <1>     pop rax
   124 0000168C 48CF                <1>     iretq
