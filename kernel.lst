   183                              <1> 
   184                              <1>     ; Set bit 0 (I/O Space), bit 1 (Memory Space), bit 2 (Bus Master Enable) = 0x0007
   185 00002508 83C807              <1>     or eax, 0x0007
   186 0000250B 4189C0              <1>     mov r8d, eax                ; R8D = value to write
   187                              <1> 
   188                              <1>     ; Write back to Command register (offset 0x04)
   189 0000250E 4489C8              <1>     mov eax, r9d                ; EAX = bus
   190 00002511 4489D3              <1>     mov ebx, r10d               ; EBX = slot
   191 00002514 4489D9              <1>     mov ecx, r11d               ; ECX = func
   192 00002517 BA04000000          <1>     mov edx, 0x04               ; EDX = offset
