   323                              <1> 
   324 00003E6A 5F                  <1>     pop rdi
   325 00003E6B 5E                  <1>     pop rsi
   326 00003E6C 5A                  <1>     pop rdx
   327 00003E6D 59                  <1>     pop rcx
   328 00003E6E 5B                  <1>     pop rbx
   329 00003E6F 58                  <1>     pop rax
