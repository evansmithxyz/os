   390 000003E8 88F8                <1>     mov al, bh
   391 000003EA E8C6FFFFFF          <1>     call vga_print_hex8
   392 000003EF 88D8                <1>     mov al, bl
   393 000003F1 E8BFFFFFFF          <1>     call vga_print_hex8
   394 000003F6 5B                  <1>     pop rbx
   395 000003F7 58                  <1>     pop rax
   396 000003F8 C3                  <1>     ret
