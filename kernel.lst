   739                              <1> ; ------------------------------------------------------------------------------
   740                              <1> ; tcp_server_start: Runs interactive bare-metal HTTP web server on port 80
   741                              <1> ; Input:
   742                              <1> ;   DX = Listening port (e.g. 80)
   743                              <1> ; ------------------------------------------------------------------------------
   744                              <1> tcp_server_start:
   745 00007D40 50                  <1>     push rax
   746 00007D41 53                  <1>     push rbx
   747 00007D42 51                  <1>     push rcx
   748 00007D43 52                  <1>     push rdx
   749 00007D44 56                  <1>     push rsi
   750 00007D45 57                  <1>     push rdi
   751                              <1> 
   752 00007D46 668915DDD9FFFF      <1>     mov [tcp_local_port], dx
   753 00007D4D C605D5D9FFFF01      <1>     mov byte [tcp_is_server], 1
   754 00007D54 C605CDD9FFFF01      <1>     mov byte [tcp_active_state], TCP_STATE_LISTEN
   755                              <1> 
   756                              <1>     ; Print Server Welcome Banner
   757 00007D5B B30B                <1>     mov bl, COLOR_LIGHT_CYAN
   758 00007D5D 488D35C4F8FFFF      <1>     lea rsi, [MSG_TCP_SERVER_ON]
   759 00007D64 E85485FFFF          <1>     call vga_print_string_color
   760                              <1> 
   761                              <1> .server_loop:
   762                              <1>     ; Non-blocking check for keyboard input ('q' or Esc to stop)
   763 00007D69 48833D2299FFFF00    <1>     cmp qword [input_len], 0
   764 00007D71 7423                <1>     jz .service_net
   765                              <1> 
   766 00007D73 8A052299FFFF        <1>     mov al, [input_buffer]
   767 00007D79 3C71                <1>     cmp al, 'q'
   768 00007D7B 0F84D7000000        <1>     je .stop_server
   769 00007D81 3C51                <1>     cmp al, 'Q'
   770 00007D83 0F84CF000000        <1>     je .stop_server
   771 00007D89 3C1B                <1>     cmp al, 27                  ; Esc
   772 00007D8B 0F84C7000000        <1>     je .stop_server
   773                              <1> 
   774                              <1>     ; Clear input buffer for other keystrokes
   775 00007D91 E81D9BFFFF          <1>     call keyboard_clear_buffer
   776                              <1> 
   777                              <1> .service_net:
   778                              <1>     ; Service Network Packets
   779 00007D96 E8A7B6FFFF          <1>     call net_poll
   780                              <1> 
   781                              <1>     ; If connection is ESTABLISHED and incoming request arrived:
   782 00007D9B 803D86D9FFFF04      <1>     cmp byte [tcp_active_state], TCP_STATE_ESTABLISHED
   783 00007DA2 0F8582000000        <1>     jne .check_closed
   784                              <1> 
   785 00007DA8 803D8BD9FFFF01      <1>     cmp byte [tcp_data_rx_flag], 1
   786 00007DAF 7579                <1>     jne .check_closed
   787                              <1> 
   788                              <1>     ; Request received!
   789 00007DB1 C60582D9FFFF00      <1>     mov byte [tcp_data_rx_flag], 0
   790                              <1> 
   791                              <1>     ; Print incoming request info
   792 00007DB8 B30E                <1>     mov bl, COLOR_YELLOW
   793 00007DBA 488D350DF9FFFF      <1>     lea rsi, [MSG_TCP_INCOMING]
   794 00007DC1 E8F784FFFF          <1>     call vga_print_string_color
   795 00007DC6 488D3561D9FFFF      <1>     lea rsi, [tcp_remote_ip]
   796 00007DCD E886CBFFFF          <1>     call vga_print_ip
   797 00007DD2 B03A                <1>     mov al, ':'
   798 00007DD4 E89A83FFFF          <1>     call vga_print_char
   799 00007DD9 0FB7054CD9FFFF      <1>     movzx eax, word [tcp_remote_port]
   800 00007DE0 E88B85FFFF          <1>     call vga_print_dec
   801 00007DE5 B00A                <1>     mov al, 0x0A
   802 00007DE7 E88783FFFF          <1>     call vga_print_char
   803                              <1> 
   804                              <1>     ; Send HTTP HTML Response
   805 00007DEC 488D354DF3FFFF      <1>     lea rsi, [HTTP_SERVER_RESP]
   806 00007DF3 B95A040000          <1>     mov rcx, HTTP_SERVER_RESP_LEN
   807 00007DF8 B018                <1>     mov al, TCP_FLAG_PSH | TCP_FLAG_ACK
   808 00007DFA E848F9FFFF          <1>     call tcp_send_segment
   809 00007DFF 010D2DD9FFFF        <1>     add [tcp_my_seq], ecx
   810                              <1> 
   811                              <1>     ; Send FIN | ACK to close connection cleanly
   812 00007E05 B011                <1>     mov al, TCP_FLAG_FIN | TCP_FLAG_ACK
   813 00007E07 4831C9              <1>     xor rcx, rcx
   814 00007E0A E838F9FFFF          <1>     call tcp_send_segment
   815 00007E0F FF051DD9FFFF        <1>     inc dword [tcp_my_seq]
   816                              <1> 
   817 00007E15 B30A                <1>     mov bl, COLOR_LIGHT_GREEN
   818 00007E17 488D35D0F8FFFF      <1>     lea rsi, [MSG_TCP_SERVED]
   819 00007E1E E89A84FFFF          <1>     call vga_print_string_color
   820                              <1> 
   821                              <1>     ; Transition to FIN_WAIT_1
   822 00007E23 C605FED8FFFF05      <1>     mov byte [tcp_active_state], TCP_STATE_FIN_WAIT_1
   823                              <1> 
   824                              <1> .check_closed:
   825                              <1>     ; Once connection is closed, reset back to LISTEN for next client!
   826 00007E2A 803DF7D8FFFF00      <1>     cmp byte [tcp_active_state], TCP_STATE_CLOSED
   827 00007E31 7515                <1>     jne .idle_pause
   828                              <1> 
   829 00007E33 C605EED8FFFF01      <1>     mov byte [tcp_active_state], TCP_STATE_LISTEN
   830 00007E3A C605FCD8FFFF00      <1>     mov byte [tcp_fin_received], 0
   831 00007E41 C605F2D8FFFF00      <1>     mov byte [tcp_data_rx_flag], 0
   832                              <1> 
   833                              <1> .idle_pause:
   834 00007E48 B9D0070000          <1>     mov ecx, 2000
   835                              <1> .spin:
   836 00007E4D F390                <1>     pause
   837 00007E4F FFC9                <1>     dec ecx
   838 00007E51 75FA                <1>     jnz .spin
   839 00007E53 E911FFFFFF          <1>     jmp .server_loop
   840                              <1> 
   841                              <1> .stop_server:
   842 00007E58 C605C9D8FFFF00      <1>     mov byte [tcp_active_state], TCP_STATE_CLOSED
   843 00007E5F B30E                <1>     mov bl, COLOR_YELLOW
   844 00007E61 488D35C3F8FFFF      <1>     lea rsi, [MSG_TCP_STOPPED]
   845 00007E68 E85084FFFF          <1>     call vga_print_string_color
   846                              <1> 
   847 00007E6D 5F                  <1>     pop rdi
   848 00007E6E 5E                  <1>     pop rsi
   849 00007E6F 5A                  <1>     pop rdx
   850 00007E70 59                  <1>     pop rcx
   851 00007E71 5B                  <1>     pop rbx
   852 00007E72 58                  <1>     pop rax
   853 00007E73 C3                  <1>     ret
