   194                              <1> 
   195 00002521 415B                <1>     pop r11
   196 00002523 415A                <1>     pop r10
   197 00002525 4159                <1>     pop r9
   198 00002527 4158                <1>     pop r8
   199 00002529 5A                  <1>     pop rdx
   200 0000252A 59                  <1>     pop rcx
   201 0000252B 5B                  <1>     pop rbx
   202 0000252C 58                  <1>     pop rax
   203 0000252D C3                  <1>     ret
   204                              <1> 
   205                              <1> ; ------------------------------------------------------------------------------
   206                              <1> ; pci_get_bar0_io: Reads BAR0 and returns base I/O port address
   207                              <1> ; Input:  EAX = bus, EBX = slot, ECX = func
   208                              <1> ; Output: RAX = Base I/O port (16-bit port number, e.g. 0xC000)
   209                              <1> ; ------------------------------------------------------------------------------
   210                              <1> pci_get_bar0_io:
