     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit PCI Bus Scanner & Configuration Manager
     3                              <1> ; Reads and writes PCI Configuration Space via I/O Ports 0xCF8 / 0xCFC
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> PCI_CONFIG_ADDR equ 0x0CF8
     9                              <1> PCI_CONFIG_DATA equ 0x0CFC
    10                              <1> 
    11                              <1> ; ------------------------------------------------------------------------------
    12                              <1> ; pci_read_dword: Reads a 32-bit dword from PCI configuration space
    13                              <1> ; Input:  EAX = bus (0-255), EBX = slot/device (0-31), ECX = func (0-7), EDX = offset (0-255)
    14                              <1> ; Output: EAX = 32-bit register value
    15                              <1> ; ------------------------------------------------------------------------------
    16                              <1> pci_read_dword:
    17 00002400 52                  <1>     push rdx
    18 00002401 53                  <1>     push rbx
    19 00002402 51                  <1>     push rcx
    20                              <1> 
    21                              <1>     ; Format: bit 31=1, bits 23-16=bus, bits 15-11=device, bits 10-8=func, bits 7-2=offset
    22 00002403 25FF000000          <1>     and eax, 0xFF
    23 00002408 C1E010              <1>     shl eax, 16
    24                              <1> 
    25 0000240B 83E31F              <1>     and ebx, 0x1F
    26 0000240E C1E30B              <1>     shl ebx, 11
    27 00002411 09D8                <1>     or eax, ebx
    28                              <1> 
    29 00002413 83E107              <1>     and ecx, 0x07
    30 00002416 C1E108              <1>     shl ecx, 8
    31 00002419 09C8                <1>     or eax, ecx
    32                              <1> 
    33 0000241B 81E2FC000000        <1>     and edx, 0xFC
    34 00002421 09D0                <1>     or eax, edx
    35                              <1> 
    36 00002423 0D00000080          <1>     or eax, 0x80000000          ; Enable configuration bit
    37                              <1> 
    38                              <1>     ; Write address to 0xCF8
    39 00002428 66BAF80C            <1>     mov dx, PCI_CONFIG_ADDR
    40 0000242C EF                  <1>     out dx, eax
    41                              <1> 
    42                              <1>     ; Read dword from 0xCFC
    43 0000242D 66BAFC0C            <1>     mov dx, PCI_CONFIG_DATA
    44 00002431 ED                  <1>     in eax, dx
    45                              <1> 
    46 00002432 59                  <1>     pop rcx
    47 00002433 5B                  <1>     pop rbx
    48 00002434 5A                  <1>     pop rdx
    49 00002435 C3                  <1>     ret
    50                              <1> 
    51                              <1> ; ------------------------------------------------------------------------------
    52                              <1> ; pci_write_dword: Writes a 32-bit dword to PCI configuration space
    53                              <1> ; Input:  EAX = bus, EBX = slot, ECX = func, EDX = offset, R8D = value to write
