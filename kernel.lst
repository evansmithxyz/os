    85 00008EBF 8B0D69FFFFFF        <1>     mov ecx, [gui_cur_x]
    86 00008EC5 8B1567FFFFFF        <1>     mov edx, [gui_cur_y]
    87 00008ECB E819FEFFFF          <1>     call gfx_draw_cursor
