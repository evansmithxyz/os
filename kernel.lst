   133                              <1>     ; Enable Receiver and Transmitter in CR (RE | TE = 0x0C)
   134 000032F5 668B1547F2FFFF      <1>     mov dx, [net_io_base]
   135 000032FC 6683C237            <1>     add dx, RTL_REG_CR
   136 00003300 B00C                <1>     mov al, RTL_CR_RE | RTL_CR_TE
