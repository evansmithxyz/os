   290 0000033B C1C004              <1>     rol eax, 4
   291 0000033E 89C2                <1>     mov edx, eax
   292 00000340 83E20F              <1>     and edx, 0x0F
   293 00000343 80FA09              <1>     cmp dl, 9
   294 00000346 7E05                <1>     jle .digit
   295 00000348 80C237              <1>     add dl, 'A' - 10
   296 0000034B EB03                <1>     jmp .store
   297                              <1> .digit:
   298 0000034D 80C230              <1>     add dl, '0'
   299                              <1> .store:
   300 00000350 8817                <1>     mov [rdi], dl
   301 00000352 48FFC7              <1>     inc rdi
   302 00000355 E2E4                <1>     loop .hex_loop
   303                              <1> 
   304 00000357 C60700              <1>     mov byte [rdi], 0
   305 0000035A 48BE-               <1>     mov rsi, hex32_buffer
   305 0000035C [2101000000000000]  <1>
   306 00000364 E843FFFFFF          <1>     call vga_print_string
   307                              <1> 
   308 00000369 5E                  <1>     pop rsi
   309 0000036A 5F                  <1>     pop rdi
   310 0000036B 5A                  <1>     pop rdx
