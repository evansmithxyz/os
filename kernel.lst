   184 000077DC 4D85DB              <1>     test r11, r11
   185 000077DF 740F                <1>     jz .no_payload
   186                              <1> 
   187 000077E1 488D3D78DFFFFF      <1>     lea rdi, [tcp_tx_packet + 32]
   188 000077E8 4C89DE              <1>     mov rsi, r11
   189 000077EB 4C89D1              <1>     mov rcx, r10
   190 000077EE F3A4                <1>     rep movsb
