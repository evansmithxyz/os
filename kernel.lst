   197                              <1> ; ------------------------------------------------------------------------------
   198                              <1> ; net_send_packet: Transmits an Ethernet packet frame via RTL8139 DMA
   199                              <1> ; Input:  RSI = Pointer to packet data (Ethernet frame)
   200                              <1> ;         RCX = Packet length in bytes
   201                              <1> ; Output: RAX = 0 on success, 1 on failure
   202                              <1> ; ------------------------------------------------------------------------------
   203                              <1> net_send_packet:
   204 00003394 53                  <1>     push rbx
   205 00003395 51                  <1>     push rcx
   206 00003396 52                  <1>     push rdx
   207 00003397 56                  <1>     push rsi
   208 00003398 57                  <1>     push rdi
   209                              <1> 
   210 00003399 803DA2F1FFFF01      <1>     cmp byte [net_present], 1
   211 000033A0 0F8591000000        <1>     jne .error
   212                              <1> 
   213 000033A6 4881F9EA050000      <1>     cmp rcx, 1514
   214 000033AD 7605                <1>     jbe .len_ok
   215 000033AF B9EA050000          <1>     mov rcx, 1514               ; Clamp to standard Ethernet MTU
   216                              <1> .len_ok:
   217 000033B4 4883F93C            <1>     cmp rcx, 60
   218 000033B8 7300                <1>     jae .no_pad
   219                              <1>     ; Ethernet minimum frame length is 60 bytes (excluding FCS)
   220                              <1> .no_pad:
   221 000033BA 4989C8              <1>     mov r8, rcx                 ; R8 = length
   222                              <1> 
   223                              <1>     ; Copy frame into physical TX DMA buffer (0x00034000)
   224 000033BD BF00400300          <1>     mov rdi, RTL_TX_BUFFER_PHYS
   225 000033C2 51                  <1>     push rcx
   226 000033C3 F3A4                <1>     rep movsb
   227 000033C5 59                  <1>     pop rcx
   228                              <1> 
   229                              <1>     ; Get current TX descriptor (0 .. 3)
   230 000033C6 0FB61D7AF1FFFF      <1>     movzx ebx, byte [net_tx_cur]
   231                              <1> 
   232                              <1>     ; Write physical TX buffer address to TSAD[ebx]
   233 000033CD 668B156FF1FFFF      <1>     mov dx, [net_io_base]
   234 000033D4 6683C220            <1>     add dx, RTL_REG_TSAD0
   235 000033D8 C1E302              <1>     shl ebx, 2                  ; ebx * 4
   236 000033DB 6601DA              <1>     add dx, bx
   237 000033DE B800400300          <1>     mov eax, RTL_TX_BUFFER_PHYS
   238 000033E3 EF                  <1>     out dx, eax
   239                              <1> 
   240                              <1>     ; Write packet length to TSD[ebx] (Bits 12-0 = size, Bit 13 = 0, Bit 16 = 0)
   241 000033E4 668B1558F1FFFF      <1>     mov dx, [net_io_base]
   242 000033EB 6683C210            <1>     add dx, RTL_REG_TSD0
   243 000033EF 6601DA              <1>     add dx, bx
   244 000033F2 4489C0              <1>     mov eax, r8d
   245 000033F5 25FF1F0000          <1>     and eax, 0x1FFF             ; Clamp to 8191
   246 000033FA EF                  <1>     out dx, eax
   247                              <1> 
   248                              <1>     ; Advance TX descriptor ring: (cur + 1) & 3
   249 000033FB 0FB60545F1FFFF      <1>     movzx eax, byte [net_tx_cur]
   250 00003402 FEC0                <1>     inc al
   251 00003404 2403                <1>     and al, 3
   252 00003406 88053BF1FFFF        <1>     mov [net_tx_cur], al
   253                              <1> 
   254                              <1>     ; Update statistics
   255 0000340C 48FF0543F1FFFF      <1>     inc qword [net_packets_tx]
   256 00003413 4C01054CF1FFFF      <1>     add [net_bytes_tx], r8
   257                              <1> 
   258                              <1>     ; Poll for transmit completion (TOK bit 15 in TSD) with timeout
   259 0000341A B9A0860100          <1>     mov ecx, 100000
   260                              <1> .poll_tx:
   261 0000341F ED                  <1>     in eax, dx
   262 00003420 A900800000          <1>     test eax, 0x8000            ; TOK (Transmit OK)
   263 00003425 750B                <1>     jnz .tx_ok
   264 00003427 A900200000          <1>     test eax, 0x2000            ; TABT (Transmit Aborted)
   265 0000342C 7509                <1>     jnz .error
   266 0000342E FFC9                <1>     dec ecx
   267 00003430 75ED                <1>     jnz .poll_tx
   268                              <1> 
   269                              <1> .tx_ok:
   270 00003432 4831C0              <1>     xor rax, rax                ; Success
   271 00003435 EB05                <1>     jmp .done
   272                              <1> 
   273                              <1> .error:
   274 00003437 B801000000          <1>     mov rax, 1
   275                              <1> 
   276                              <1> .done:
   277 0000343C 5F                  <1>     pop rdi
   278 0000343D 5E                  <1>     pop rsi
   279 0000343E 5A                  <1>     pop rdx
   280 0000343F 59                  <1>     pop rcx
   281 00003440 5B                  <1>     pop rbx
   282 00003441 C3                  <1>     ret
   283                              <1> 
   284                              <1> ; ------------------------------------------------------------------------------
   285                              <1> ; net_poll: Polls the RTL8139 receiver ring buffer for arriving packets
   286                              <1> ; Called frequently in main kernel loop and network wait routines
   287                              <1> ; ------------------------------------------------------------------------------
   288                              <1> net_poll:
   289 00003442 50                  <1>     push rax
   290 00003443 53                  <1>     push rbx
   291 00003444 51                  <1>     push rcx
   292 00003445 52                  <1>     push rdx
   293 00003446 56                  <1>     push rsi
   294 00003447 57                  <1>     push rdi
   295                              <1> 
   296 00003448 803DF3F0FFFF01      <1>     cmp byte [net_present], 1
   297 0000344F 0F85CC000000        <1>     jne .poll_done
   298                              <1> 
   299                              <1> .poll_loop_packets:
   300                              <1>     ; Check Command Register bit 0 (BUFE: Buffer Empty)
   301 00003455 668B15E7F0FFFF      <1>     mov dx, [net_io_base]
   302 0000345C 6683C237            <1>     add dx, RTL_REG_CR
   303 00003460 EC                  <1>     in al, dx
   304 00003461 A801                <1>     test al, RTL_CR_BUFE
   305 00003463 0F85B8000000        <1>     jnz .poll_done              ; Buffer is empty, no packet waiting
   306                              <1> 
   307                              <1>     ; Read packet from RX ring buffer at RTL_RX_BUFFER_PHYS + net_rx_offset
   308 00003469 480FB735D4F0FFFF    <1>     movzx rsi, word [net_rx_offset]
   309 00003471 4881C600000300      <1>     add rsi, RTL_RX_BUFFER_PHYS
   310                              <1> 
   311                              <1>     ; Format of RTL8139 packet header:
   312                              <1>     ; Offset 0 (2 bytes): Status flags (bit 0 = ROK)
   313                              <1>     ; Offset 2 (2 bytes): Packet length (including 4-byte CRC)
   314 00003478 0FB706              <1>     movzx eax, word [rsi]       ; Status
   315 0000347B A801                <1>     test al, 0x01               ; ROK
   316 0000347D 0F8484000000        <1>     jz .reset_rx                ; If not OK, reset buffer
   317                              <1> 
   318 00003483 0FB74E02            <1>     movzx ecx, word [rsi + 2]   ; Length with CRC
   319 00003487 83F90E              <1>     cmp ecx, 14
   320 0000348A 727B                <1>     jb .reset_rx
   321 0000348C 81F940060000        <1>     cmp ecx, 1600
   322 00003492 7773                <1>     ja .reset_rx
   323                              <1> 
   324                              <1>     ; Copy Ethernet frame (length - 4 CRC bytes) to net_rx_buf
   325 00003494 83E904              <1>     sub ecx, 4                  ; Strip 4-byte CRC
   326 00003497 4989C8              <1>     mov r8, rcx                 ; R8 = Frame length
   327                              <1> 
   328 0000349A 4883C604            <1>     add rsi, 4                  ; Skip 4-byte packet header
   329 0000349E 488D3D0BF7FFFF      <1>     lea rdi, [net_rx_buf]
   330 000034A5 F3A4                <1>     rep movsb
   331                              <1> 
   332                              <1>     ; Update statistics
   333 000034A7 48FF05A0F0FFFF      <1>     inc qword [net_packets_rx]
   334 000034AE 4C0105A9F0FFFF      <1>     add [net_bytes_rx], r8
   335                              <1> 
   336                              <1>     ; Advance net_rx_offset: (offset + len + 4 + 3) & ~3
   337 000034B5 0FB70589F0FFFF      <1>     movzx eax, word [net_rx_offset]
   338 000034BC 4401C0              <1>     add eax, r8d
   339 000034BF 83C00B              <1>     add eax, 4 + 4 + 3          ; +4 header +4 CRC +3 for round up
   340 000034C2 83E0FC              <1>     and eax, ~3
   341 000034C5 25FF1F0000          <1>     and eax, 0x1FFF             ; Wrap around 8192 bytes (8KB ring)
   342 000034CA 66890574F0FFFF      <1>     mov [net_rx_offset], ax
   343                              <1> 
   344                              <1>     ; Update CAPR (Current Address of Packet Read) = (offset - 16) & 0xFFFF
   345 000034D1 6683E810            <1>     sub ax, 16
   346 000034D5 668B1567F0FFFF      <1>     mov dx, [net_io_base]
   347 000034DC 6683C238            <1>     add dx, RTL_REG_CAPR
   348 000034E0 66EF                <1>     out dx, ax
   349                              <1> 
   350                              <1>     ; Clear ROK in ISR (write 0x0001 to clear)
   351 000034E2 668B155AF0FFFF      <1>     mov dx, [net_io_base]
   352 000034E9 6683C23E            <1>     add dx, RTL_REG_ISR
   353 000034ED 66B80100            <1>     mov ax, 0x0001
   354 000034F1 66EF                <1>     out dx, ax
   355                              <1> 
   356                              <1>     ; Dispatch packet to Ethernet Protocol Layer
   357 000034F3 488D35B6F6FFFF      <1>     lea rsi, [net_rx_buf]
   358 000034FA 4C89C1              <1>     mov rcx, r8
   359 000034FD E8B6070000          <1>     call eth_handle_packet
   360                              <1> 
   361                              <1>     ; Loop to drain any other pending packets
   362 00003502 E94EFFFFFF          <1>     jmp .poll_loop_packets
   363                              <1> 
   364                              <1> .reset_rx:
   365                              <1>     ; Recovery from corrupted buffer state: reset CAPR to 0xFFF0 (-16)
   366 00003507 668B1535F0FFFF      <1>     mov dx, [net_io_base]
   367 0000350E 6683C238            <1>     add dx, RTL_REG_CAPR
   368 00003512 66B8F0FF            <1>     mov ax, 0xFFF0
   369 00003516 66EF                <1>     out dx, ax
   370 00003518 66C70524F0FFFF0000  <1>     mov word [net_rx_offset], 0
   371                              <1> 
   372                              <1> .poll_done:
   373 00003521 5F                  <1>     pop rdi
   374 00003522 5E                  <1>     pop rsi
   375 00003523 5A                  <1>     pop rdx
   376 00003524 59                  <1>     pop rcx
   377 00003525 5B                  <1>     pop rbx
   378 00003526 58                  <1>     pop rax
   379 00003527 C3                  <1>     ret
