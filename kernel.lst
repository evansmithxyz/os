    92                              <1> gui_main_loop:
    93                              <1>     ; 1. Poll RTL8139 Network Card for background packets (Pings, ARP, TCP)
    94 00008ED0 E86DA5FFFF          <1>     call net_poll
    95                              <1> 
    96                              <1>     ; 2. Poll PS/2 Mouse Controller
    97 00008ED5 E873F1FFFF          <1>     call mouse_poll
    98                              <1> 
    99                              <1>     ; Direct keyboard port poll for instantaneous key capture
   100 00008EDA E464                <1>     in al, 0x64
   101 00008EDC A801                <1>     test al, 0x01
   102 00008EDE 740B                <1>     jz .no_direct_key
   103 00008EE0 A820                <1>     test al, 0x20               ; Bit 5 set = mouse data
   104 00008EE2 7507                <1>     jnz .no_direct_key
   105 00008EE4 E460                <1>     in al, 0x60
   106 00008EE6 E8A488FFFF          <1>     call keyboard_process_scancode
   107                              <1> .no_direct_key:
   108                              <1> 
   109                              <1>     ; 3. Check for Keyboard Events
   110 00008EEB 8A05A187FFFF        <1>     mov al, [gui_last_key]
