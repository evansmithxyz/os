   335 00008AF5 448915AEFFFFFF      <1>     mov [grad_c2], r10d
   336                              <1> 
   337 00008AFC 4589C3              <1>     mov r11d, r8d               ; R11D = Height (total steps)
   338 00008AFF 4531E4              <1>     xor r12d, r12d              ; R12D = Step (0 .. Height - 1)
   339                              <1> 
   340                              <1> .grad_loop:
   341                              <1>     ; Top Color Components:
   342 00008B02 8B059EFFFFFF        <1>     mov eax, [grad_c1]
   343 00008B08 440FB6E8            <1>     movzx r13d, al              ; Top B
   344 00008B0C C1E808              <1>     shr eax, 8
   345 00008B0F 440FB6F0            <1>     movzx r14d, al              ; Top G
   346 00008B13 C1E808              <1>     shr eax, 8
   347 00008B16 440FB6F8            <1>     movzx r15d, al              ; Top R
   348                              <1> 
   349                              <1>     ; Bot Color Components:
   350 00008B1A 8B058AFFFFFF        <1>     mov eax, [grad_c2]
   351 00008B20 0FB6D0              <1>     movzx edx, al               ; Bot B
   352 00008B23 C1E808              <1>     shr eax, 8
   353 00008B26 0FB6D8              <1>     movzx ebx, al               ; Bot G
   354 00008B29 C1E808              <1>     shr eax, 8
   355 00008B2C 0FB6C8              <1>     movzx ecx, al               ; Bot R
   356                              <1> 
   357                              <1>     ; Interpolate Red: Top R + (Bot R - Top R) * step / height
   358 00008B2F 4429F9              <1>     sub ecx, r15d
   359 00008B32 410FAFCC            <1>     imul ecx, r12d
   360 00008B36 89C8                <1>     mov eax, ecx
   361 00008B38 99                  <1>     cdq
   362 00008B39 41F7FB              <1>     idiv r11d
   363 00008B3C 4401F8              <1>     add eax, r15d
   364 00008B3F 25FF000000          <1>     and eax, 0xFF
   365 00008B44 C1E010              <1>     shl eax, 16
   366 00008B47 50                  <1>     push rax                    ; Save Red on stack
   367                              <1> 
   368                              <1>     ; Interpolate Green: Top G + (Bot G - Top G) * step / height
   369 00008B48 4429F3              <1>     sub ebx, r14d
   370 00008B4B 410FAFDC            <1>     imul ebx, r12d
   371 00008B4F 89D8                <1>     mov eax, ebx
   372 00008B51 99                  <1>     cdq
   373 00008B52 41F7FB              <1>     idiv r11d
   374 00008B55 4401F0              <1>     add eax, r14d
   375 00008B58 25FF000000          <1>     and eax, 0xFF
   376 00008B5D C1E008              <1>     shl eax, 8
   377 00008B60 50                  <1>     push rax                    ; Save Green on stack
   378                              <1> 
   379                              <1>     ; Interpolate Blue: Top B + (Bot B - Top B) * step / height
   380                              <1>     ; Need Bot B:
   381 00008B61 8B0543FFFFFF        <1>     mov eax, [grad_c2]
   382 00008B67 25FF000000          <1>     and eax, 0xFF               ; Bot B
   383 00008B6C 4429E8              <1>     sub eax, r13d
   384 00008B6F 410FAFC4            <1>     imul eax, r12d
   385 00008B73 99                  <1>     cdq
   386 00008B74 41F7FB              <1>     idiv r11d
   387 00008B77 4401E8              <1>     add eax, r13d
   388 00008B7A 25FF000000          <1>     and eax, 0xFF               ; EAX = Blue
   389                              <1> 
   390                              <1>     ; Combine R, G, B
   391 00008B7F 5B                  <1>     pop rbx                     ; Green
   392 00008B80 09D8                <1>     or eax, ebx
   393 00008B82 5B                  <1>     pop rbx                     ; Red
   394 00008B83 09D8                <1>     or eax, ebx                 ; EAX = 0x00RRGGBB
   395                              <1> 
   396                              <1>     ; Write scanline to Framebuffer
   397 00008B85 488B3DEAF2FFFF      <1>     mov rdi, [bga_lfb_ptr]
   398 00008B8C 8B1508FFFFFF        <1>     mov edx, [grad_y]
   399 00008B92 4401E2              <1>     add edx, r12d               ; Y + step
   400 00008B95 69D200040000        <1>     imul edx, GUI_SCREEN_WIDTH
   401 00008B9B 0315F5FEFFFF        <1>     add edx, [grad_x]
   402 00008BA1 48C1E202            <1>     shl rdx, 2
   403 00008BA5 4801D7              <1>     add rdi, rdx
   404                              <1> 
   405 00008BA8 8B0DF0FEFFFF        <1>     mov ecx, [grad_w]
   406 00008BAE F3AB                <1>     rep stosd
   407                              <1> 
   408 00008BB0 41FFC4              <1>     inc r12d
   409 00008BB3 4539DC              <1>     cmp r12d, r11d
   410 00008BB6 0F8C46FFFFFF        <1>     jl .grad_loop
   411                              <1> 
   412                              <1> .done:
   413 00008BBC 415F                <1>     pop r15
   414 00008BBE 415E                <1>     pop r14
   415 00008BC0 415D                <1>     pop r13
   416 00008BC2 415C                <1>     pop r12
   417 00008BC4 415B                <1>     pop r11
   418 00008BC6 415A                <1>     pop r10
   419 00008BC8 4159                <1>     pop r9
   420 00008BCA 4158                <1>     pop r8
   421 00008BCC 5F                  <1>     pop rdi
   422 00008BCD 5E                  <1>     pop rsi
   423 00008BCE 5A                  <1>     pop rdx
   424 00008BCF 59                  <1>     pop rcx
   425 00008BD0 5B                  <1>     pop rbx
   426 00008BD1 58                  <1>     pop rax
   427 00008BD2 C3                  <1>     ret
   428                              <1> 
   429                              <1> ; ------------------------------------------------------------------------------
   430                              <1> ; gfx_draw_char: Renders a single 8x8 bitmap character at (X, Y)
   431                              <1> ; Input:
   432                              <1> ;   ECX = X, EDX = Y, AL = ASCII Char, ESI = FG Color, R8D = BG Color (-1 = transp)
   433                              <1> ; ------------------------------------------------------------------------------
   434                              <1> gfx_draw_char:
   435 00008BD3 50                  <1>     push rax
   436 00008BD4 53                  <1>     push rbx
   437 00008BD5 51                  <1>     push rcx
   438 00008BD6 52                  <1>     push rdx
   439 00008BD7 56                  <1>     push rsi
   440 00008BD8 57                  <1>     push rdi
   441 00008BD9 4150                <1>     push r8
   442 00008BDB 4151                <1>     push r9
   443 00008BDD 4152                <1>     push r10
   444 00008BDF 4153                <1>     push r11
   445 00008BE1 4154                <1>     push r12
   446 00008BE3 4155                <1>     push r13
   447 00008BE5 4156                <1>     push r14
   448 00008BE7 4157                <1>     push r15
   449                              <1> 
   450                              <1>     ; Clamp character to printable range [32 .. 126]
   451 00008BE9 3C20                <1>     cmp al, 32
   452 00008BEB 7302                <1>     jae .chk_max
   453 00008BED B020                <1>     mov al, 32
   454                              <1> .chk_max:
   455 00008BEF 3C7E                <1>     cmp al, 126
   456 00008BF1 7602                <1>     jbe .char_ok
   457 00008BF3 B03F                <1>     mov al, '?'
   458                              <1> .char_ok:
   459 00008BF5 2C20                <1>     sub al, 32                  ; 0-based glyph index
   460 00008BF7 0FB6C0              <1>     movzx eax, al
   461 00008BFA C1E003              <1>     shl eax, 3                  ; Index * 8 bytes per glyph
   462 00008BFD 488D1D54F5FFFF      <1>     lea rbx, [font_8x8_data]
   463 00008C04 4801C3              <1>     add rbx, rax                ; RBX = Pointer to 8 bytes of glyph data
   464                              <1> 
   465 00008C07 4189C9              <1>     mov r9d, ecx                ; R9D = Base X
   466 00008C0A 4189D2              <1>     mov r10d, edx               ; R10D = Base Y
   467 00008C0D 4189F3              <1>     mov r11d, esi               ; R11D = FG Color
   468 00008C10 4589C4              <1>     mov r12d, r8d               ; R12D = BG Color
   469                              <1> 
   470 00008C13 4531ED              <1>     xor r13d, r13d              ; R13D = row (0 .. 7)
   471                              <1> .row_loop:
   472 00008C16 460FB6342B          <1>     movzx r14d, byte [rbx + r13] ; R14D = 8-bit glyph row pattern
   473                              <1> 
   474 00008C1B 4531FF              <1>     xor r15d, r15d              ; R15D = col (0 .. 7)
   475                              <1> .col_loop:
   476                              <1>     ; Bit 7 is leftmost pixel (col 0), Bit 0 is rightmost pixel (col 7)
   477                              <1>     ; Test bit (7 - col)
   478 00008C1E B907000000          <1>     mov ecx, 7
   479 00008C23 4429F9              <1>     sub ecx, r15d
   480 00008C26 410FA3CE            <1>     bt r14d, ecx
   481 00008C2A 721C                <1>     jc .draw_fg
   482                              <1> 
   483                              <1>     ; Background pixel
   484 00008C2C 4183FCFF            <1>     cmp r12d, -1                ; Transparent?
   485 00008C30 742A                <1>     je .next_col
   486 00008C32 4489C9              <1>     mov ecx, r9d
   487 00008C35 4401F9              <1>     add ecx, r15d               ; X = Base X + col
   488 00008C38 4489D2              <1>     mov edx, r10d
   489 00008C3B 4401EA              <1>     add edx, r13d               ; Y = Base Y + row
   490 00008C3E 4489E0              <1>     mov eax, r12d               ; Color = BG Color
   491 00008C41 E8DAFCFFFF          <1>     call gfx_putpixel
   492 00008C46 EB14                <1>     jmp .next_col
   493                              <1> 
   494                              <1> .draw_fg:
   495 00008C48 4489C9              <1>     mov ecx, r9d
   496 00008C4B 4401F9              <1>     add ecx, r15d               ; X = Base X + col
   497 00008C4E 4489D2              <1>     mov edx, r10d
   498 00008C51 4401EA              <1>     add edx, r13d               ; Y = Base Y + row
   499 00008C54 4489D8              <1>     mov eax, r11d               ; Color = FG Color
   500 00008C57 E8C4FCFFFF          <1>     call gfx_putpixel
   501                              <1> 
   502                              <1> .next_col:
   503 00008C5C 41FFC7              <1>     inc r15d
   504 00008C5F 4183FF08            <1>     cmp r15d, 8
   505 00008C63 7CB9                <1>     jl .col_loop
   506                              <1> 
   507 00008C65 41FFC5              <1>     inc r13d
   508 00008C68 4183FD08            <1>     cmp r13d, 8
   509 00008C6C 7CA8                <1>     jl .row_loop
   510                              <1> 
   511 00008C6E 415F                <1>     pop r15
   512 00008C70 415E                <1>     pop r14
   513 00008C72 415D                <1>     pop r13
   514 00008C74 415C                <1>     pop r12
   515 00008C76 415B                <1>     pop r11
   516 00008C78 415A                <1>     pop r10
   517 00008C7A 4159                <1>     pop r9
   518 00008C7C 4158                <1>     pop r8
   519 00008C7E 5F                  <1>     pop rdi
   520 00008C7F 5E                  <1>     pop rsi
   521 00008C80 5A                  <1>     pop rdx
   522 00008C81 59                  <1>     pop rcx
   523 00008C82 5B                  <1>     pop rbx
   524 00008C83 58                  <1>     pop rax
   525 00008C84 C3                  <1>     ret
   526                              <1> 
   527                              <1> ; ------------------------------------------------------------------------------
   528                              <1> ; gfx_print_string: Draws null-terminated text string at (X, Y)
   529                              <1> ; Input:
   530                              <1> ;   ECX = X, EDX = Y, RSI = Pointer to string, EAX = FG Color, EBX = BG Color
   531                              <1> ; ------------------------------------------------------------------------------
   532                              <1> gfx_print_string:
   533 00008C85 50                  <1>     push rax
   534 00008C86 53                  <1>     push rbx
   535 00008C87 51                  <1>     push rcx
   536 00008C88 52                  <1>     push rdx
   537 00008C89 56                  <1>     push rsi
   538 00008C8A 57                  <1>     push rdi
   539 00008C8B 4153                <1>     push r11
   540 00008C8D 4154                <1>     push r12
   541 00008C8F 4155                <1>     push r13
   542 00008C91 4156                <1>     push r14
   543 00008C93 4157                <1>     push r15
   544                              <1> 
   545 00008C95 4989F3              <1>     mov r11, rsi                ; R11 = String Pointer
   546 00008C98 4189CC              <1>     mov r12d, ecx               ; Initial X
   547 00008C9B 4189CD              <1>     mov r13d, ecx               ; Margin X
   548 00008C9E 4189D6              <1>     mov r14d, edx               ; Y
   549 00008CA1 4189C7              <1>     mov r15d, eax               ; FG Color
   550 00008CA4 89DF                <1>     mov edi, ebx                ; BG Color
   551                              <1> 
   552                              <1> .loop:
   553 00008CA6 418A03              <1>     mov al, [r11]
   554 00008CA9 49FFC3              <1>     inc r11
   555 00008CAC 84C0                <1>     test al, al
   556 00008CAE 7428                <1>     jz .done
   557                              <1> 
   558 00008CB0 3C0A                <1>     cmp al, 0x0A                ; Line feed '\n'
   559 00008CB2 741B                <1>     je .newline
   560 00008CB4 3C0D                <1>     cmp al, 0x0D                ; Carriage return '\r'
   561 00008CB6 74EE                <1>     je .loop
   562                              <1> 
   563                              <1>     ; Draw character
   564 00008CB8 4489E1              <1>     mov ecx, r12d
   565 00008CBB 4489F2              <1>     mov edx, r14d
   566 00008CBE 4489FE              <1>     mov esi, r15d
   567 00008CC1 4189F8              <1>     mov r8d, edi
   568 00008CC4 E80AFFFFFF          <1>     call gfx_draw_char
   569                              <1> 
   570 00008CC9 4183C408            <1>     add r12d, 8                 ; Advance 8 pixels
   571 00008CCD EBD7                <1>     jmp .loop
   572                              <1> 
   573                              <1> .newline:
   574 00008CCF 4589EC              <1>     mov r12d, r13d              ; Reset to left margin
   575 00008CD2 4183C60A            <1>     add r14d, 10                ; Advance line (8 px font + 2 px padding)
   576 00008CD6 EBCE                <1>     jmp .loop
   577                              <1> 
   578                              <1> .done:
   579 00008CD8 415F                <1>     pop r15
   580 00008CDA 415E                <1>     pop r14
   581 00008CDC 415D                <1>     pop r13
   582 00008CDE 415C                <1>     pop r12
   583 00008CE0 415B                <1>     pop r11
   584 00008CE2 5F                  <1>     pop rdi
   585 00008CE3 5E                  <1>     pop rsi
   586 00008CE4 5A                  <1>     pop rdx
   587 00008CE5 59                  <1>     pop rcx
   588 00008CE6 5B                  <1>     pop rbx
   589 00008CE7 58                  <1>     pop rax
   590 00008CE8 C3                  <1>     ret
   591                              <1> 
   592                              <1> ; ------------------------------------------------------------------------------
   593                              <1> ; gfx_draw_cursor: Draws the 16x18 arrow pointer at (X, Y) with background save
   594                              <1> ; Input: ECX = X, EDX = Y
   595                              <1> ; ------------------------------------------------------------------------------
   596                              <1> gfx_draw_cursor:
   597 00008CE9 50                  <1>     push rax
   598 00008CEA 53                  <1>     push rbx
   599 00008CEB 51                  <1>     push rcx
   600 00008CEC 52                  <1>     push rdx
   601 00008CED 56                  <1>     push rsi
   602 00008CEE 57                  <1>     push rdi
   603 00008CEF 4150                <1>     push r8
   604 00008CF1 4151                <1>     push r9
   605 00008CF3 4152                <1>     push r10
   606                              <1> 
   607 00008CF5 890DD5FBFFFF        <1>     mov [cursor_saved_x], ecx
   608 00008CFB 8915D3FBFFFF        <1>     mov [cursor_saved_y], edx
   609                              <1> 
   610                              <1>     ; 1. Save background pixels into cursor_saved buffer
   611 00008D01 488D3548F7FFFF      <1>     lea rsi, [cursor_saved]
   612 00008D08 4531C0              <1>     xor r8d, r8d                ; Row 0 .. 17
   613                              <1> .save_row:
   614 00008D0B 4531C9              <1>     xor r9d, r9d                ; Col 0 .. 15
   615                              <1> .save_col:
   616 00008D0E 8B0DBCFBFFFF        <1>     mov ecx, [cursor_saved_x]
   617 00008D14 4401C9              <1>     add ecx, r9d
   618 00008D17 8B15B7FBFFFF        <1>     mov edx, [cursor_saved_y]
   619 00008D1D 4401C2              <1>     add edx, r8d
   620 00008D20 E823FCFFFF          <1>     call gfx_getpixel
   621 00008D25 8906                <1>     mov [rsi], eax
   622 00008D27 4883C604            <1>     add rsi, 4
   623                              <1> 
   624 00008D2B 41FFC1              <1>     inc r9d
   625 00008D2E 4183F910            <1>     cmp r9d, CURSOR_W
   626 00008D32 7CDA                <1>     jl .save_col
   627                              <1> 
   628 00008D34 41FFC0              <1>     inc r8d
   629 00008D37 4183F812            <1>     cmp r8d, CURSOR_H
   630 00008D3B 7CCE                <1>     jl .save_row
   631                              <1> 
   632                              <1>     ; 2. Render Cursor Pixels
   633 00008D3D 4531C0              <1>     xor r8d, r8d                ; Row 0 .. 17
   634                              <1> .draw_row:
   635 00008D40 430FB79C00-         <1>     movzx ebx, word [cursor_mask + r8 * 2]
   635 00008D45 [D8880000]          <1>
   636 00008D49 470FB79400-         <1>     movzx r10d, word [cursor_fill + r8 * 2]
   636 00008D4E [FC880000]          <1>
   637 00008D52 4531C9              <1>     xor r9d, r9d                ; Col 0 .. 15
   638                              <1> 
   639                              <1> .draw_col:
   640 00008D55 B10F                <1>     mov cl, 15
   641 00008D57 4428C9              <1>     sub cl, r9b                 ; Bit index (15 - col)
   642                              <1> 
   643                              <1>     ; Test mask bit (Black outline)
   644 00008D5A 0FA3CB              <1>     bt ebx, ecx
   645 00008D5D 7340                <1>     jnc .next_cursor_px
   646                              <1> 
   647                              <1>     ; Test fill bit (Electric Cyan / White core)
   648 00008D5F 410FA3CA            <1>     bt r10d, ecx
   649 00008D63 721E                <1>     jc .draw_fill
   650                              <1> 
   651                              <1>     ; Draw Black Outline
   652 00008D65 8B0D65FBFFFF        <1>     mov ecx, [cursor_saved_x]
   653 00008D6B 4401C9              <1>     add ecx, r9d
   654 00008D6E 8B1560FBFFFF        <1>     mov edx, [cursor_saved_y]
   655 00008D74 4401C2              <1>     add edx, r8d
   656 00008D77 B800000000          <1>     mov eax, 0x00000000         ; Black
   657 00008D7C E89FFBFFFF          <1>     call gfx_putpixel
   658 00008D81 EB1C                <1>     jmp .next_cursor_px
   659                              <1> 
   660                              <1> .draw_fill:
   661 00008D83 8B0D47FBFFFF        <1>     mov ecx, [cursor_saved_x]
   662 00008D89 4401C9              <1>     add ecx, r9d
   663 00008D8C 8B1542FBFFFF        <1>     mov edx, [cursor_saved_y]
   664 00008D92 4401C2              <1>     add edx, r8d
   665 00008D95 B8FFF00000          <1>     mov eax, 0x0000F0FF         ; Electric Cyan Core
   666 00008D9A E881FBFFFF          <1>     call gfx_putpixel
   667                              <1> 
   668                              <1> .next_cursor_px:
   669 00008D9F 41FFC1              <1>     inc r9d
   670 00008DA2 4183F910            <1>     cmp r9d, CURSOR_W
   671 00008DA6 7CAD                <1>     jl .draw_col
   672                              <1> 
   673 00008DA8 41FFC0              <1>     inc r8d
   674 00008DAB 4183F812            <1>     cmp r8d, CURSOR_H
   675 00008DAF 7C8F                <1>     jl .draw_row
   676                              <1> 
   677 00008DB1 415A                <1>     pop r10
   678 00008DB3 4159                <1>     pop r9
   679 00008DB5 4158                <1>     pop r8
   680 00008DB7 5F                  <1>     pop rdi
   681 00008DB8 5E                  <1>     pop rsi
   682 00008DB9 5A                  <1>     pop rdx
   683 00008DBA 59                  <1>     pop rcx
   684 00008DBB 5B                  <1>     pop rbx
   685 00008DBC 58                  <1>     pop rax
   686 00008DBD C3                  <1>     ret
   687                              <1> 
   688                              <1> ; ------------------------------------------------------------------------------
   689                              <1> ; gfx_restore_cursor: Restores saved pixels under cursor to prevent ghosting
   690                              <1> ; ------------------------------------------------------------------------------
   691                              <1> gfx_restore_cursor:
   692 00008DBE 50                  <1>     push rax
   693 00008DBF 53                  <1>     push rbx
   694 00008DC0 51                  <1>     push rcx
   695 00008DC1 52                  <1>     push rdx
   696 00008DC2 56                  <1>     push rsi
   697 00008DC3 57                  <1>     push rdi
   698 00008DC4 4150                <1>     push r8
   699 00008DC6 4151                <1>     push r9
   700                              <1> 
   701 00008DC8 8B0502FBFFFF        <1>     mov eax, [cursor_saved_x]
   702 00008DCE 83F8FF              <1>     cmp eax, -1
   703 00008DD1 7450                <1>     je .done                    ; Never drawn
   704                              <1> 
   705 00008DD3 488D3576F6FFFF      <1>     lea rsi, [cursor_saved]
   706 00008DDA 4531C0              <1>     xor r8d, r8d                ; Row 0 .. 17
   707                              <1> .rest_row:
   708 00008DDD 4531C9              <1>     xor r9d, r9d                ; Col 0 .. 15
   709                              <1> .rest_col:
   710 00008DE0 8B0DEAFAFFFF        <1>     mov ecx, [cursor_saved_x]
   711 00008DE6 4401C9              <1>     add ecx, r9d
   712 00008DE9 8B15E5FAFFFF        <1>     mov edx, [cursor_saved_y]
   713 00008DEF 4401C2              <1>     add edx, r8d
   714 00008DF2 8B06                <1>     mov eax, [rsi]
   715 00008DF4 E827FBFFFF          <1>     call gfx_putpixel
   716 00008DF9 4883C604            <1>     add rsi, 4
   717                              <1> 
   718 00008DFD 41FFC1              <1>     inc r9d
   719 00008E00 4183F910            <1>     cmp r9d, CURSOR_W
   720 00008E04 7CDA                <1>     jl .rest_col
   721                              <1> 
   722 00008E06 41FFC0              <1>     inc r8d
   723 00008E09 4183F812            <1>     cmp r8d, CURSOR_H
