    81                              <1> ; ------------------------------------------------------------------------------
    82                              <1> ; mouse_init: Configures 8042 controller for auxiliary PS/2 mouse
    83                              <1> ; ------------------------------------------------------------------------------
    84                              <1> mouse_init:
    85 00007FCC 50                  <1>     push rax
    86 00007FCD 53                  <1>     push rbx
    87 00007FCE 51                  <1>     push rcx
    88 00007FCF 52                  <1>     push rdx
    89                              <1> 
    90                              <1>     ; 1. Enable Auxiliary PS/2 Port (Command 0xA8)
    91 00007FD0 E8B0FFFFFF          <1>     call mouse_wait_write
    92 00007FD5 B0A8                <1>     mov al, 0xA8
    93 00007FD7 E664                <1>     out 0x64, al
    94                              <1> 
    95                              <1>     ; 2. Read Controller Command Byte (Command 0x20)
    96 00007FD9 E8A7FFFFFF          <1>     call mouse_wait_write
    97 00007FDE B020                <1>     mov al, 0x20
    98 00007FE0 E664                <1>     out 0x64, al
    99 00007FE2 E8B4FFFFFF          <1>     call mouse_wait_read
   100 00007FE7 E460                <1>     in al, 0x60
   101                              <1> 
   102                              <1>     ; Enable IRQ12 (Bit 1 = 1) and clear mouse clock disable (Bit 5 = 0)
   103 00007FE9 0C02                <1>     or al, 0x02                 ; Bit 1: Enable IRQ12 interrupt
   104 00007FEB 24DF                <1>     and al, ~0x20               ; Bit 5: Enable mouse clock
   105                              <1> 
   106                              <1>     ; Write modified Controller Command Byte back (Command 0x60)
   107 00007FED 88C3                <1>     mov bl, al
   108 00007FEF E891FFFFFF          <1>     call mouse_wait_write
   109 00007FF4 B060                <1>     mov al, 0x60
   110 00007FF6 E664                <1>     out 0x64, al
   111 00007FF8 E888FFFFFF          <1>     call mouse_wait_write
   112 00007FFD 88D8                <1>     mov al, bl
   113 00007FFF E660                <1>     out 0x60, al
   114                              <1> 
   115                              <1>     ; 3. Set Mouse Defaults (Command 0xF6)
   116 00008001 B0F6                <1>     mov al, 0xF6
   117 00008003 E8A9FFFFFF          <1>     call mouse_write_cmd
   118 00008008 E8B7FFFFFF          <1>     call mouse_read_data        ; Read 0xFA ACK
   119                              <1> 
   120                              <1>     ; 4. Enable Mouse Data Reporting (Command 0xF4)
   121 0000800D B0F4                <1>     mov al, 0xF4
   122 0000800F E89DFFFFFF          <1>     call mouse_write_cmd
   123 00008014 E8ABFFFFFF          <1>     call mouse_read_data        ; Read 0xFA ACK
   124                              <1> 
   125                              <1>     ; 5. Keep IRQ12 masked on Slave PIC so mouse_poll reads port 0x60 synchronously
   126 00008019 E4A1                <1>     in al, 0xA1
   127 0000801B 0C10                <1>     or al, 0x10                 ; Set IRQ12 mask (bit 4)
   128 0000801D E6A1                <1>     out 0xA1, al
   129                              <1> 
   130                              <1>     ; Reset mouse state
   131 0000801F C7054DFFFFFF000200- <1>     mov dword [mouse_x], 512
   131 00008028 00                  <1>
   132 00008029 C70547FFFFFF800100- <1>     mov dword [mouse_y], 384
   132 00008032 00                  <1>
   133 00008033 C60544FFFFFF00      <1>     mov byte [mouse_buttons], 0
   134 0000803A C6053FFFFFFF00      <1>     mov byte [mouse_cycle], 0
   135 00008041 C6053CFFFFFF01      <1>     mov byte [mouse_active], 1
   136                              <1> 
   137 00008048 5A                  <1>     pop rdx
   138 00008049 59                  <1>     pop rcx
   139 0000804A 5B                  <1>     pop rbx
   140 0000804B 58                  <1>     pop rax
   141 0000804C C3                  <1>     ret
   142                              <1> 
   143                              <1> ; ------------------------------------------------------------------------------
   144                              <1> ; mouse_poll: Checks 8042 buffer for mouse packets and updates cursor state
   145                              <1> ; Called continuously during GUI event loop
   146                              <1> ; ------------------------------------------------------------------------------
   147                              <1> mouse_poll:
   148 0000804D 50                  <1>     push rax
   149 0000804E 53                  <1>     push rbx
   150 0000804F 51                  <1>     push rcx
   151 00008050 52                  <1>     push rdx
   152                              <1> 
   153                              <1> .poll_again:
   154                              <1>     ; Read 8042 status register
   155 00008051 E464                <1>     in al, 0x64
   156 00008053 A801                <1>     test al, 0x01               ; Output buffer full?
   157 00008055 0F84F6000000        <1>     jz .done
   158                              <1> 
   159 0000805B A820                <1>     test al, 0x20               ; Is it mouse data (Bit 5 == 1)?
   160 0000805D 0F84EE000000        <1>     jz .done                    ; No, keyboard data -> leave for keyboard driver
   161                              <1> 
   162                              <1>     ; Read byte from mouse
   163 00008063 E460                <1>     in al, 0x60
   164 00008065 88C3                <1>     mov bl, al                  ; BL = raw byte
   165                              <1> 
   166                              <1>     ; State machine based on mouse_cycle
   167 00008067 0FB60D12FFFFFF      <1>     movzx ecx, byte [mouse_cycle]
   168 0000806E 83F900              <1>     cmp ecx, 0
   169 00008071 7416                <1>     je .handle_byte0
   170 00008073 83F901              <1>     cmp ecx, 1
   171 00008076 7429                <1>     je .handle_byte1
   172 00008078 83F902              <1>     cmp ecx, 2
   173 0000807B 7433                <1>     je .handle_byte2
   174 0000807D C605FCFEFFFF00      <1>     mov byte [mouse_cycle], 0
   175 00008084 E9C8000000          <1>     jmp .done
   176                              <1> 
   177                              <1> .handle_byte0:
   178                              <1>     ; Byte 0: Bit 3 must ALWAYS be 1 in standard PS/2 packet!
   179 00008089 F6C308              <1>     test bl, 0x08
   180 0000808C 0F84B6000000        <1>     jz .sync_error              ; If bit 3 == 0, packet is out of sync!
   181 00008092 881DE9FEFFFF        <1>     mov [mouse_byte0], bl
   182 00008098 C605E1FEFFFF01      <1>     mov byte [mouse_cycle], 1
   183 0000809F EBB0                <1>     jmp .poll_again
   184                              <1> 
   185                              <1> .handle_byte1:
   186 000080A1 881DDBFEFFFF        <1>     mov [mouse_byte1], bl
   187 000080A7 C605D2FEFFFF02      <1>     mov byte [mouse_cycle], 2
   188 000080AE EBA1                <1>     jmp .poll_again
   189                              <1> 
   190                              <1> .handle_byte2:
   191 000080B0 881DCDFEFFFF        <1>     mov [mouse_byte2], bl
   192 000080B6 C605C3FEFFFF00      <1>     mov byte [mouse_cycle], 0   ; Reset cycle for next packet
   193                              <1> 
   194                              <1>     ; --------------------------------------------------------------------------
   195                              <1>     ; Process Complete 3-Byte Packet
   196                              <1>     ; --------------------------------------------------------------------------
   197                              <1>     ; 1. Buttons
   198 000080BD 8A05BBFEFFFF        <1>     mov al, [mouse_buttons]
   199 000080C3 8805B6FEFFFF        <1>     mov [mouse_prev_buttons], al
   200 000080C9 8A05B2FEFFFF        <1>     mov al, [mouse_byte0]
   201 000080CF 2407                <1>     and al, 0x07                ; Bits 0=Left, 1=Right, 2=Middle
   202 000080D1 8805A7FEFFFF        <1>     mov [mouse_buttons], al
   203                              <1> 
   204                              <1>     ; 2. Delta X (signed 9-bit)
   205 000080D7 0FB605A4FEFFFF      <1>     movzx eax, byte [mouse_byte1]
   206 000080DE 8A0D9DFEFFFF        <1>     mov cl, [mouse_byte0]
   207 000080E4 F6C110              <1>     test cl, 0x10               ; X sign bit?
   208 000080E7 7405                <1>     jz .x_positive
   209 000080E9 0D00FFFFFF          <1>     or eax, 0xFFFFFF00          ; Sign extend negative
   210                              <1> .x_positive:
   211                              <1>     ; Add delta X to mouse_x
   212 000080EE 8B1D82FEFFFF        <1>     mov ebx, [mouse_x]
   213 000080F4 01C3                <1>     add ebx, eax
   214                              <1> 
   215                              <1>     ; Clamp X to [0 .. 1023]
   216 000080F6 83FB00              <1>     cmp ebx, 0
   217 000080F9 7D02                <1>     jge .x_not_min
   218 000080FB 31DB                <1>     xor ebx, ebx
   219                              <1> .x_not_min:
   220 000080FD 81FBFF030000        <1>     cmp ebx, 1023
   221 00008103 7E05                <1>     jle .x_not_max
   222 00008105 BBFF030000          <1>     mov ebx, 1023
   223                              <1> .x_not_max:
   224 0000810A 891D66FEFFFF        <1>     mov [mouse_x], ebx
   225                              <1> 
   226                              <1>     ; 3. Delta Y (signed 9-bit)
   227                              <1>     ; PS/2 mouse positive Y is UPwards, while screen Y is DOWNwards -> Subtract!
   228 00008110 0FB6056CFEFFFF      <1>     movzx eax, byte [mouse_byte2]
   229 00008117 F6C120              <1>     test cl, 0x20               ; Y sign bit?
   230 0000811A 7405                <1>     jz .y_positive
   231 0000811C 0D00FFFFFF          <1>     or eax, 0xFFFFFF00          ; Sign extend negative
   232                              <1> .y_positive:
   233                              <1>     ; Subtract delta Y from mouse_y
   234 00008121 8B1D53FEFFFF        <1>     mov ebx, [mouse_y]
   235 00008127 29C3                <1>     sub ebx, eax
   236                              <1> 
   237                              <1>     ; Clamp Y to [0 .. 767]
   238 00008129 83FB00              <1>     cmp ebx, 0
   239 0000812C 7D02                <1>     jge .y_not_min
   240 0000812E 31DB                <1>     xor ebx, ebx
   241                              <1> .y_not_min:
   242 00008130 81FBFF020000        <1>     cmp ebx, 767
   243 00008136 7E05                <1>     jle .y_not_max
   244 00008138 BBFF020000          <1>     mov ebx, 767
   245                              <1> .y_not_max:
   246 0000813D 891D37FEFFFF        <1>     mov [mouse_y], ebx
   247                              <1> 
   248 00008143 E909FFFFFF          <1>     jmp .poll_again
   249                              <1> 
   250                              <1> .sync_error:
   251                              <1>     ; Discard byte and reset cycle
   252 00008148 C60531FEFFFF00      <1>     mov byte [mouse_cycle], 0
   253 0000814F EB00                <1>     jmp .done
   254                              <1> 
   255                              <1> .done:
