   287                              <1> ; ------------------------------------------------------------------------------
   288                              <1> ; gui_handle_click: Dispatches click based on (mouse_x, mouse_y)
   289                              <1> ; Output: RAX = 1 if Exit GUI requested, 0 otherwise
   290                              <1> ; ------------------------------------------------------------------------------
   291                              <1> gui_handle_click:
   292 00009105 53                  <1>     push rbx
   293 00009106 51                  <1>     push rcx
   294 00009107 52                  <1>     push rdx
   295 00009108 56                  <1>     push rsi
   296 00009109 57                  <1>     push rdi
   297                              <1> 
   298 0000910A 8B0D66EEFFFF        <1>     mov ecx, [mouse_x]
   299 00009110 8B1564EEFFFF        <1>     mov edx, [mouse_y]
   300                              <1> 
   301                              <1>     ; 1. Check Exit Button on Taskbar (x: 915 .. 1015, y: 6 .. 30)
   302 00009116 83FA06              <1>     cmp edx, 6
   303 00009119 0F8209010000        <1>     jb .chk_canvas
   304 0000911F 83FA1E              <1>     cmp edx, 30
   305 00009122 7722                <1>     ja .chk_win_buttons
   306 00009124 81F993030000        <1>     cmp ecx, 915
   307 0000912A 0F82F8000000        <1>     jb .chk_canvas
   308 00009130 81F9F7030000        <1>     cmp ecx, 1015
   309 00009136 0F87EC000000        <1>     ja .chk_canvas
   310                              <1>     ; Exit clicked!
   311 0000913C B801000000          <1>     mov rax, 1
   312 00009141 E907010000          <1>     jmp .done
   313                              <1> 
   314                              <1> .chk_win_buttons:
   315                              <1>     ; Window 1 Close button (x: 50 .. 64, y: 63 .. 77)
   316 00009146 83FA3F              <1>     cmp edx, 63
   317 00009149 7219                <1>     jb .chk_toolbar
   318 0000914B 83FA4D              <1>     cmp edx, 77
   319 0000914E 7714                <1>     ja .chk_toolbar
   320 00009150 83F932              <1>     cmp ecx, 50
   321 00009153 720F                <1>     jb .chk_toolbar
   322 00009155 83F940              <1>     cmp ecx, 64
   323 00009158 770A                <1>     ja .chk_toolbar
   324                              <1>     ; Close button clicked -> exit GUI
   325 0000915A B801000000          <1>     mov rax, 1
   326 0000915F E9E9000000          <1>     jmp .done
   327                              <1> 
   328                              <1> .chk_toolbar:
   329                              <1>     ; 2. Palette Swatches (y: 426 .. 448)
   330 00009164 81FAAA010000        <1>     cmp edx, 426
   331 0000916A 0F82B8000000        <1>     jb .chk_canvas
   332 00009170 81FAC0010000        <1>     cmp edx, 448
   333 00009176 0F87AC000000        <1>     ja .chk_canvas
   334                              <1> 
   335                              <1>     ; Check Swatches 0 .. 7 (x: 55 + i*30 .. 55 + i*30 + 24)
   336 0000917C 31DB                <1>     xor ebx, ebx                ; i = 0 .. 7
   337                              <1> .swatch_loop:
   338 0000917E 89D8                <1>     mov eax, ebx
   339 00009180 6BC01E              <1>     imul eax, 30
   340 00009183 83C037              <1>     add eax, 55                 ; X start of swatch
   341 00009186 39C1                <1>     cmp ecx, eax
   342 00009188 7237                <1>     jb .next_swatch
   343 0000918A 83C018              <1>     add eax, 24                 ; X end of swatch
   344 0000918D 39C1                <1>     cmp ecx, eax
   345 0000918F 7730                <1>     ja .next_swatch
   346                              <1> 
   347                              <1>     ; Swatch matched!
   348 00009191 8B049D[3A8E0000]    <1>     mov eax, [gui_swatches + rbx * 4]
   349 00009198 890598FCFFFF        <1>     mov [gui_active_color], eax
   350 0000919E E81BFCFFFF          <1>     call gfx_restore_cursor
   351 000091A3 E8D4080000          <1>     call gui_draw_palette_indicators
   352 000091A8 8B0DC8EDFFFF        <1>     mov ecx, [mouse_x]
