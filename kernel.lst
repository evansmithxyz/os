   215 0000905A 8B0D16EFFFFF        <1>     mov ecx, [mouse_x]
   216 00009060 8B1514EFFFFF        <1>     mov edx, [mouse_y]
   217 00009066 E87EFCFFFF          <1>     call gfx_draw_cursor
   218 0000906B EB6C                <1>     jmp .loop_delay
   219                              <1> 
   220                              <1> .chk_mouse:
   221                              <1>     ; 4. Check if cursor position changed
   222 0000906D 8B0503EFFFFF        <1>     mov eax, [mouse_x]
   223 00009073 8B1501EFFFFF        <1>     mov edx, [mouse_y]
   224 00009079 3B05AFFDFFFF        <1>     cmp eax, [gui_cur_x]
   225 0000907F 750A                <1>     jne .move_cursor
   226 00009081 3B15ABFDFFFF        <1>     cmp edx, [gui_cur_y]
   227 00009087 7502                <1>     jne .move_cursor
   228 00009089 EB3C                <1>     jmp .check_clicks
   229                              <1> 
