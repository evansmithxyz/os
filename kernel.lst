   237                              <1> ; vga_print_hex64: Prints 64-bit value in RAX as 16-digit hexadecimal string
   238                              <1> ; ------------------------------------------------------------------------------
   239                              <1> vga_print_hex64:
   240 000002D9 50                  <1>     push rax
   241 000002DA 53                  <1>     push rbx
   242 000002DB 51                  <1>     push rcx
   243 000002DC 52                  <1>     push rdx
   244 000002DD 57                  <1>     push rdi
   245 000002DE 56                  <1>     push rsi
   246                              <1> 
   247 000002DF 48BF-               <1>     mov rdi, hex64_buffer + 2   ; Skip "0x"
   247 000002E1 [1001000000000000]  <1>
   248 000002E9 B910000000          <1>     mov rcx, 16                 ; 16 nibbles (64 bits)
   249                              <1> .hex_loop:
   250 000002EE 48C1C004            <1>     rol rax, 4
   251 000002F2 4889C2              <1>     mov rdx, rax
   252 000002F5 4883E20F            <1>     and rdx, 0x0F
   253 000002F9 80FA09              <1>     cmp dl, 9
   254 000002FC 7E05                <1>     jle .digit
   255 000002FE 80C237              <1>     add dl, 'A' - 10
   256 00000301 EB03                <1>     jmp .store
   257                              <1> .digit:
   258 00000303 80C230              <1>     add dl, '0'
   259                              <1> .store:
   260 00000306 8817                <1>     mov [rdi], dl
   261 00000308 48FFC7              <1>     inc rdi
   262 0000030B E2E1                <1>     loop .hex_loop
   263                              <1> 
   264 0000030D C60700              <1>     mov byte [rdi], 0
   265 00000310 48BE-               <1>     mov rsi, hex64_buffer
   265 00000312 [0E01000000000000]  <1>
   266 0000031A E88DFFFFFF          <1>     call vga_print_string
   267                              <1> 
   268 0000031F 5E                  <1>     pop rsi
   269 00000320 5F                  <1>     pop rdi
   270 00000321 5A                  <1>     pop rdx
   271 00000322 59                  <1>     pop rcx
   272 00000323 5B                  <1>     pop rbx
   273 00000324 58                  <1>     pop rax
   274 00000325 C3                  <1>     ret
   275                              <1> 
   276                              <1> ; ------------------------------------------------------------------------------
   277                              <1> ; vga_print_hex32: Prints 32-bit value in EAX as 8-digit hexadecimal string
   278                              <1> ; ------------------------------------------------------------------------------
   279                              <1> vga_print_hex32:
   280 00000326 50                  <1>     push rax
