    42                              <1> ; ------------------------------------------------------------------------------
    43                              <1> ; net_checksum: Computes standard 16-bit 1's complement Internet Checksum
    44                              <1> ; Input:  RSI = Pointer to buffer, RCX = Length in bytes
    45                              <1> ; Output: AX  = 16-bit checksum
    46                              <1> ; ------------------------------------------------------------------------------
    47                              <1> net_checksum:
    48 0000473A 53                  <1>     push rbx
    49 0000473B 51                  <1>     push rcx
    50 0000473C 56                  <1>     push rsi
    51                              <1> 
    52 0000473D 31C0                <1>     xor eax, eax                ; EAX = 32-bit accumulator
    53 0000473F 48D1E9              <1>     shr rcx, 1                  ; Convert bytes to 16-bit word count
    54 00004742 740E                <1>     jz .check_odd
    55                              <1> 
    56                              <1> .word_loop:
    57 00004744 0FB71E              <1>     movzx ebx, word [rsi]
    58 00004747 01D8                <1>     add eax, ebx
    59 00004749 4883C602            <1>     add rsi, 2
    60 0000474D 48FFC9              <1>     dec rcx
    61 00004750 75F2                <1>     jnz .word_loop
    62                              <1> 
    63                              <1> .check_odd:
    64 00004752 5E                  <1>     pop rsi
    65 00004753 56                  <1>     push rsi
    66 00004754 59                  <1>     pop rcx
    67 00004755 51                  <1>     push rcx
    68 00004756 F6C101              <1>     test cl, 1
    69 00004759 740E                <1>     jz .fold
    70                              <1> 
    71                              <1>     ; Add final odd byte (padded with zero in low or high byte)
    72 0000475B 4883EC08            <1>     sub rsp, 8
    73 0000475F 5E                  <1>     pop rsi
    74 00004760 56                  <1>     push rsi
    75 00004761 56                  <1>     push rsi
    76                              <1>     ; Odd byte at end
    77 00004762 0FB65C0EFF          <1>     movzx ebx, byte [rsi + rcx - 1]
    78 00004767 01D8                <1>     add eax, ebx
    79                              <1> 
    80                              <1> .fold:
    81                              <1>     ; Fold 32-bit sum into 16 bits
    82 00004769 89C2                <1>     mov edx, eax
    83 0000476B C1EA10              <1>     shr edx, 16
    84 0000476E 25FFFF0000          <1>     and eax, 0xFFFF
    85 00004773 01D0                <1>     add eax, edx
    86                              <1> 
    87 00004775 89C2                <1>     mov edx, eax
    88 00004777 C1EA10              <1>     shr edx, 16
    89 0000477A 01D0                <1>     add eax, edx
    90                              <1> 
    91 0000477C 66F7D0              <1>     not ax                      ; 1's complement
    92                              <1> 
    93 0000477F 5E                  <1>     pop rsi
    94 00004780 59                  <1>     pop rcx
    95 00004781 5B                  <1>     pop rbx
    96 00004782 C3                  <1>     ret
