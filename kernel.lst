     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit Ethernet II & Address Resolution Protocol (ARP) Engine
     3                              <1> ; Handles L2 Frame Encapsulation, Hardware Addressing, and Dynamic ARP Discovery
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ETHERTYPE_IPV4      equ 0x0800
     9                              <1> ETHERTYPE_ARP       equ 0x0806
    10                              <1> 
    11                              <1> ARP_OP_REQUEST      equ 1
    12                              <1> ARP_OP_REPLY        equ 2
    13                              <1> 
    14                              <1> ; Network Interface Configuration (QEMU SLIRP Defaults)
    15 00003528 0A00020F            <1> net_ip:             db 10, 0, 2, 15
    16 0000352C 0A000202            <1> net_gateway:        db 10, 0, 2, 2
    17 00003530 FFFFFF00            <1> net_netmask:        db 255, 255, 255, 0
    18 00003534 0A000203            <1> net_dns:            db 10, 0, 2, 3
    19                              <1> 
    20                              <1> ; Default Gateway MAC (Pre-seeded for QEMU SLIRP router: 52:54:00:12:34:02)
    21 00003538 525400123402        <1> gateway_mac:        db 0x52, 0x54, 0x00, 0x12, 0x34, 0x02
    22 0000353E FFFFFFFFFFFF        <1> broadcast_mac:      db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    23                              <1> 
    24                              <1> ; ARP Cache: 8 entries (4 bytes IP, 6 bytes MAC, 1 byte valid flag = 11 bytes each)
    25                              <1> ARP_CACHE_MAX       equ 8
    26 00003544 00<rep 20h>         <1> arp_cache_ip:       times (ARP_CACHE_MAX * 4) db 0
    27 00003564 00<rep 30h>         <1> arp_cache_mac:      times (ARP_CACHE_MAX * 6) db 0
    28 00003594 00<rep 8h>          <1> arp_cache_valid:    times ARP_CACHE_MAX db 0
    29                              <1> 
    30                              <1> ; Scratch Buffers
    31 0000359C 90<rep 4h>          <1> align 16
    32 000035A0 00<rep 640h>        <1> eth_tx_frame:       times 1600 db 0
    33                              <1> align 16
    34 00003BE0 00<rep 40h>         <1> arp_pkt_buf:        times 64 db 0
    35                              <1> 
    36                              <1> ; ------------------------------------------------------------------------------
    37                              <1> ; eth_send_frame: Encapsulates L3 payload into Ethernet II frame and transmits
    38                              <1> ; Input:
    39                              <1> ;   RSI = Pointer to payload data
    40                              <1> ;   RCX = Payload length in bytes
    41                              <1> ;   RDI = Pointer to 6-byte Destination MAC Address
    42                              <1> ;   DX  = 16-bit EtherType (e.g. 0x0800 or 0x0806)
    43                              <1> ; ------------------------------------------------------------------------------
    44                              <1> eth_send_frame:
    45 00003C20 50                  <1>     push rax
    46 00003C21 53                  <1>     push rbx
    47 00003C22 51                  <1>     push rcx
    48 00003C23 52                  <1>     push rdx
    49 00003C24 56                  <1>     push rsi
    50 00003C25 57                  <1>     push rdi
    51 00003C26 4150                <1>     push r8
    52 00003C28 4151                <1>     push r9
    53                              <1> 
    54 00003C2A 4989C8              <1>     mov r8, rcx                 ; R8 = payload length
    55 00003C2D 4989F1              <1>     mov r9, rsi                 ; R9 = payload source
    56                              <1> 
    57                              <1>     ; 1. Destination MAC (6 bytes)
    58 00003C30 488D0569F9FFFF      <1>     lea rax, [eth_tx_frame]
    59 00003C37 57                  <1>     push rdi
    60 00003C38 56                  <1>     push rsi
    61 00003C39 4889FE              <1>     mov rsi, rdi
    62 00003C3C 4889C7              <1>     mov rdi, rax
    63 00003C3F B906000000          <1>     mov rcx, 6
    64 00003C44 F3A4                <1>     rep movsb
    65 00003C46 5E                  <1>     pop rsi
    66 00003C47 5F                  <1>     pop rdi
    67                              <1> 
    68                              <1>     ; 2. Source MAC (6 bytes) from net_mac
    69 00003C48 488D3D57F9FFFF      <1>     lea rdi, [eth_tx_frame + 6]
    70 00003C4F 488D35F2E8FFFF      <1>     lea rsi, [net_mac]
    71 00003C56 B906000000          <1>     mov rcx, 6
    72 00003C5B F3A4                <1>     rep movsb
    73                              <1> 
    74                              <1>     ; 3. EtherType (2 bytes in big-endian network order)
    75 00003C5D 883549F9FFFF        <1>     mov byte [eth_tx_frame + 12], dh
    76 00003C63 881544F9FFFF        <1>     mov byte [eth_tx_frame + 13], dl
    77                              <1> 
    78                              <1>     ; 4. Copy payload data starting at eth_tx_frame + 14
    79 00003C69 488D3D3EF9FFFF      <1>     lea rdi, [eth_tx_frame + 14]
    80 00003C70 4C89CE              <1>     mov rsi, r9
    81 00003C73 4C89C1              <1>     mov rcx, r8
    82 00003C76 F3A4                <1>     rep movsb
    83                              <1> 
    84                              <1>     ; Total frame length = payload length + 14
    85 00003C78 4983C00E            <1>     add r8, 14
    86                              <1> 
    87                              <1>     ; Minimum Ethernet frame size is 60 bytes (pad with zeros if needed)
    88 00003C7C 4983F83C            <1>     cmp r8, 60
    89 00003C80 731C                <1>     jae .send_now
    90 00003C82 B93C000000          <1>     mov rcx, 60
    91 00003C87 4C29C1              <1>     sub rcx, r8
    92 00003C8A 488D3D0FF9FFFF      <1>     lea rdi, [eth_tx_frame]
    93 00003C91 4C01C7              <1>     add rdi, r8
    94 00003C94 31C0                <1>     xor eax, eax
    95 00003C96 F3AA                <1>     rep stosb
    96 00003C98 41B83C000000        <1>     mov r8, 60
    97                              <1> 
    98                              <1> .send_now:
    99 00003C9E 488D35FBF8FFFF      <1>     lea rsi, [eth_tx_frame]
   100 00003CA5 4C89C1              <1>     mov rcx, r8
   101 00003CA8 E8E7F6FFFF          <1>     call net_send_packet
   102                              <1> 
   103 00003CAD 4159                <1>     pop r9
   104 00003CAF 4158                <1>     pop r8
   105 00003CB1 5F                  <1>     pop rdi
   106 00003CB2 5E                  <1>     pop rsi
   107 00003CB3 5A                  <1>     pop rdx
   108 00003CB4 59                  <1>     pop rcx
   109 00003CB5 5B                  <1>     pop rbx
   110 00003CB6 58                  <1>     pop rax
   111 00003CB7 C3                  <1>     ret
   112                              <1> 
   113                              <1> ; ------------------------------------------------------------------------------
   114                              <1> ; eth_handle_packet: Decodes incoming Ethernet II frame from driver
   115                              <1> ; Input:
   116                              <1> ;   RSI = Pointer to received Ethernet frame
   117                              <1> ;   RCX = Total frame length in bytes
   118                              <1> ; ------------------------------------------------------------------------------
   119                              <1> eth_handle_packet:
   120 00003CB8 50                  <1>     push rax
   121 00003CB9 53                  <1>     push rbx
   122 00003CBA 51                  <1>     push rcx
   123 00003CBB 52                  <1>     push rdx
   124 00003CBC 56                  <1>     push rsi
   125 00003CBD 57                  <1>     push rdi
   126                              <1> 
   127 00003CBE 4883F90E            <1>     cmp rcx, 14
   128 00003CC2 7236                <1>     jb .drop                    ; Drop malformed/short frame
   129                              <1> 
   130                              <1>     ; Extract 16-bit EtherType from offset 12 (Big Endian)
   131 00003CC4 0FB6560C            <1>     movzx edx, byte [rsi + 12]
   132 00003CC8 C1E208              <1>     shl edx, 8
   133 00003CCB 8A560D              <1>     mov dl, [rsi + 13]
   134                              <1> 
   135                              <1>     ; Check EtherType
   136 00003CCE 6681FA0608          <1>     cmp dx, ETHERTYPE_ARP
   137 00003CD3 7409                <1>     je .handle_arp
   138                              <1> 
   139 00003CD5 6681FA0008          <1>     cmp dx, ETHERTYPE_IPV4
   140 00003CDA 7411                <1>     je .handle_ipv4
   141                              <1> 
   142 00003CDC EB1C                <1>     jmp .drop
   143                              <1> 
   144                              <1> .handle_arp:
   145 00003CDE 4883C60E            <1>     add rsi, 14                 ; Advance past Ethernet header
   146 00003CE2 4883E90E            <1>     sub rcx, 14
   147 00003CE6 E816000000          <1>     call arp_handle_packet
   148 00003CEB EB0D                <1>     jmp .drop
   149                              <1> 
