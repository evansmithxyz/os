    42                              <1> ; ------------------------------------------------------------------------------
    43                              <1> ; gui_run: Launches 1024x768x32bpp GUI Desktop Environment
    44                              <1> ; Returns when user presses Esc, 'q', or clicks [Exit]
    45                              <1> ; ------------------------------------------------------------------------------
    46                              <1> gui_run:
    47 00008E5A 50                  <1>     push rax
    48 00008E5B 53                  <1>     push rbx
    49 00008E5C 51                  <1>     push rcx
    50 00008E5D 52                  <1>     push rdx
    51 00008E5E 56                  <1>     push rsi
    52 00008E5F 57                  <1>     push rdi
    53 00008E60 4150                <1>     push r8
    54 00008E62 4151                <1>     push r9
    55 00008E64 4152                <1>     push r10
    56 00008E66 4153                <1>     push r11
    57 00008E68 4154                <1>     push r12
    58 00008E6A 4155                <1>     push r13
    59 00008E6C 4156                <1>     push r14
    60 00008E6E 4157                <1>     push r15
    61                              <1> 
    62                              <1>     ; 1. Ensure BGA hardware driver is initialized
