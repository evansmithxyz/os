   112 00008EF7 C6059487FFFF00      <1>     mov byte [gui_last_key], 0
   113 00008EFE C6058C87FFFF00      <1>     mov byte [gui_last_scancode], 0
   114                              <1> 
   115                              <1>     ; Check for Exit (Esc = ASCII 27 or scancode 0x01, or 'q' / 'Q')
   116 00008F05 3C1B                <1>     cmp al, 27
   117 00008F07 0F84DC010000        <1>     je .exit_gui
   118 00008F0D 80FB01              <1>     cmp bl, 0x01
   119 00008F10 0F84D3010000        <1>     je .exit_gui
   120 00008F16 3C71                <1>     cmp al, 'q'
   121 00008F18 0F84CB010000        <1>     je .exit_gui
   122 00008F1E 3C51                <1>     cmp al, 'Q'
   123 00008F20 0F84C3010000        <1>     je .exit_gui
   124                              <1> 
   125                              <1>     ; Check for Canvas actions
   126 00008F26 3C63                <1>     cmp al, 'c'
   127 00008F28 0F8402010000        <1>     je .do_clear_canvas
   128 00008F2E 3C43                <1>     cmp al, 'C'
   129 00008F30 0F84FA000000        <1>     je .do_clear_canvas
   130 00008F36 3C64                <1>     cmp al, 'd'
   131 00008F38 0F8412010000        <1>     je .do_demo_art
   132 00008F3E 3C44                <1>     cmp al, 'D'
   133 00008F40 0F840A010000        <1>     je .do_demo_art
   134                              <1> 
   135                              <1>     ; Check Palette number keys '1' .. '8'
   136 00008F46 3C31                <1>     cmp al, '1'
   137 00008F48 7220                <1>     jb .chk_arrows
   138 00008F4A 3C38                <1>     cmp al, '8'
   139 00008F4C 771C                <1>     ja .chk_arrows
   140 00008F4E 2C31                <1>     sub al, '1'
   141 00008F50 0FB6C0              <1>     movzx eax, al
   142 00008F53 8B1485[3A8E0000]    <1>     mov edx, [gui_swatches + rax * 4]
   143 00008F5A 8915D6FEFFFF        <1>     mov [gui_active_color], edx
   144 00008F60 E8170B0000          <1>     call gui_draw_palette_indicators
   145 00008F65 E903010000          <1>     jmp .chk_mouse
   146                              <1> 
   147                              <1> .chk_arrows:
   148                              <1>     ; Arrow Keys / WASD support for cursor movement
   149 00008F6A 80FB48              <1>     cmp bl, 0x48                ; Up Arrow
   150 00008F6D 7434                <1>     je .nudge_up
   151 00008F6F 3C77                <1>     cmp al, 'w'
   152 00008F71 7430                <1>     je .nudge_up
   153 00008F73 80FB50              <1>     cmp bl, 0x50                ; Down Arrow
   154 00008F76 744E                <1>     je .nudge_down
   155 00008F78 3C73                <1>     cmp al, 's'
   156 00008F7A 744A                <1>     je .nudge_down
   157 00008F7C 80FB4B              <1>     cmp bl, 0x4B                ; Left Arrow
   158 00008F7F 746B                <1>     je .nudge_left
   159 00008F81 3C61                <1>     cmp al, 'a'
   160 00008F83 7467                <1>     je .nudge_left
   161 00008F85 80FB4D              <1>     cmp bl, 0x4D                ; Right Arrow
   162 00008F88 747E                <1>     je .nudge_right
   163 00008F8A 3C65                <1>     cmp al, 'e'                 ; 'e' for nudge right
   164 00008F8C 747A                <1>     je .nudge_right
   165 00008F8E 3C20                <1>     cmp al, ' '                 ; Space = Click / Draw
   166 00008F90 0F8491000000        <1>     je .do_space_click
   167 00008F96 3C0D                <1>     cmp al, 0x0D                ; Enter = Click / Draw
   168 00008F98 0F8489000000        <1>     je .do_space_click
   169 00008F9E E9CA000000          <1>     jmp .chk_mouse
   170                              <1> 
   171                              <1> .nudge_up:
   172 00008FA3 832DD0EFFFFF0C      <1>     sub dword [mouse_y], 12
   173 00008FAA 833DC9EFFFFF00      <1>     cmp dword [mouse_y], 0
   174 00008FB1 0F8DB6000000        <1>     jge .chk_mouse
   175 00008FB7 C705B9EFFFFF000000- <1>     mov dword [mouse_y], 0
   175 00008FC0 00                  <1>
   176 00008FC1 E9A7000000          <1>     jmp .chk_mouse
   177                              <1> 
   178                              <1> .nudge_down:
   179 00008FC6 8305ADEFFFFF0C      <1>     add dword [mouse_y], 12
   180 00008FCD 813DA3EFFFFFFF0200- <1>     cmp dword [mouse_y], 767
   180 00008FD6 00                  <1>
   181 00008FD7 0F8E90000000        <1>     jle .chk_mouse
   182 00008FDD C70593EFFFFFFF0200- <1>     mov dword [mouse_y], 767
   182 00008FE6 00                  <1>
   183 00008FE7 E981000000          <1>     jmp .chk_mouse
   184                              <1> 
   185                              <1> .nudge_left:
   186 00008FEC 832D83EFFFFF0C      <1>     sub dword [mouse_x], 12
