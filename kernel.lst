  1778 0000C52D 750C                <1>     jne .tab_not_file_cmd
  1779 0000C52F 807E0169            <1>     cmp byte [rsi+1], 'i'
  1780 0000C533 7506                <1>     jne .tab_not_file_cmd
  1781 0000C535 807E0272            <1>     cmp byte [rsi+2], 'r'
  1782 0000C539 7405                <1>     je .tab_file_mode
  1783                              <1> 
