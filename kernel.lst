    73                              <1> 
    74                              <1>     ; 4. Center cursor
    75 00008E88 C705E4F0FFFF000200- <1>     mov dword [mouse_x], 512
    75 00008E91 00                  <1>
    76 00008E92 C705DEF0FFFF800100- <1>     mov dword [mouse_y], 384
    76 00008E9B 00                  <1>
    77 00008E9C C70588FFFFFF000200- <1>     mov dword [gui_cur_x], 512
    77 00008EA5 00                  <1>
    78 00008EA6 C70582FFFFFF800100- <1>     mov dword [gui_cur_y], 384
    78 00008EAF 00                  <1>
    79 00008EB0 C7057CFFFFFFFFF000- <1>     mov dword [gui_active_color], 0x0000F0FF
    79 00008EB9 00                  <1>
    80                              <1> 
    81                              <1>     ; 5. Render entire desktop UI layout
