   118                                  %include "idt.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit Interrupt Descriptor Table (IDT) & 8259 PIC Remap
     3                              <1> ; Configures 16-byte 64-bit interrupt gates and hardware IRQs
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ; PIC I/O Ports
     9                              <1> PIC1_COMMAND    equ 0x20
    10                              <1> PIC1_DATA       equ 0x21
    11                              <1> PIC2_COMMAND    equ 0xA0
    12                              <1> PIC2_DATA       equ 0xA1
    13                              <1> PIC_EOI         equ 0x20
    14                              <1> 
    15                              <1> ; 64-bit IDT Gate Type
    16                              <1> IDT_GATE_INTERRUPT  equ 0x8E    ; Present=1, DPL=00, GateType=1110 (64-bit Interrupt Gate)
    17                              <1> 
    18 000003F9 90<rep 7h>          <1> align 16
    19                              <1> idt64_start:
    20 00000400 00<rep 1000h>       <1>     times 256 * 16 db 0        ; 256 interrupt gates, 16 bytes each = 4096 bytes
    21                              <1> idt64_end:
    22                              <1> 
    23                              <1> idt64_descriptor:
    24 00001400 FF0F                <1>     dw idt64_end - idt64_start - 1  ; Limit (2 bytes)
    25 00001402 [0004000000000000]  <1>     dq idt64_start                  ; Base Address (8 bytes for 64-bit LIDT)
    26                              <1> 
    27                              <1> ; ------------------------------------------------------------------------------
    28                              <1> ; idt_set_gate: Installs a 64-bit interrupt handler into the IDT
    29                              <1> ; Input:
    30                              <1> ;   AL  = Interrupt vector (0 - 255)
    31                              <1> ;   RDX = 64-bit Handler address
    32                              <1> ;   CL  = Type / Attribute byte (0x8E)
    33                              <1> ; ------------------------------------------------------------------------------
    34                              <1> idt_set_gate:
    35 0000140A 50                  <1>     push rax
    36 0000140B 57                  <1>     push rdi
    37                              <1> 
    38 0000140C 480FB6C0            <1>     movzx rax, al
    39 00001410 48C1E004            <1>     shl rax, 4                  ; Multiply by 16 (16 bytes per gate)
    40 00001414 488DB8[00040000]    <1>     lea rdi, [idt64_start + rax]
    41                              <1> 
    42                              <1>     ; Bits 0..15 of handler offset
    43 0000141B 668917              <1>     mov [rdi], dx
    44                              <1> 
    45                              <1>     ; Code segment selector (0x18 = CODE_SEG64)
    46 0000141E 66C747021800        <1>     mov word [rdi + 2], 0x18
    47                              <1> 
    48                              <1>     ; IST = 0 (Interrupt Stack Table unused)
    49 00001424 C6470400            <1>     mov byte [rdi + 4], 0x00
    50                              <1> 
    51                              <1>     ; Type and attributes (0x8E)
    52 00001428 884F05              <1>     mov [rdi + 5], cl
    53                              <1> 
    54                              <1>     ; Bits 16..31 of handler offset
    55 0000142B 4889D0              <1>     mov rax, rdx
    56 0000142E 48C1E810            <1>     shr rax, 16
    57 00001432 66894706            <1>     mov [rdi + 6], ax
    58                              <1> 
    59                              <1>     ; Bits 32..63 of handler offset
    60 00001436 4889D0              <1>     mov rax, rdx
    61 00001439 48C1E820            <1>     shr rax, 32
    62 0000143D 894708              <1>     mov [rdi + 8], eax
    63                              <1> 
    64                              <1>     ; Reserved 32 bits (must be 0)
    65 00001440 C7470C00000000      <1>     mov dword [rdi + 12], 0x00000000
    66                              <1> 
    67 00001447 5F                  <1>     pop rdi
    68 00001448 58                  <1>     pop rax
    69 00001449 C3                  <1>     ret
    70                              <1> 
    71                              <1> ; ------------------------------------------------------------------------------
    72                              <1> ; pic_remap: Remaps 8259 PIC so IRQs do not collide with CPU exceptions
    73                              <1> ; Master IRQ 0-7  -> INT 0x20 - 0x27
    74                              <1> ; Slave  IRQ 8-15 -> INT 0x28 - 0x2F
    75                              <1> ; ------------------------------------------------------------------------------
    76                              <1> pic_remap:
    77 0000144A 50                  <1>     push rax
    78                              <1> 
    79                              <1>     ; ICW1: Start initialization sequence in cascade mode
    80 0000144B B011                <1>     mov al, 0x11
    81 0000144D E620                <1>     out PIC1_COMMAND, al
    82 0000144F E845000000          <1>     call io_wait
    83 00001454 E6A0                <1>     out PIC2_COMMAND, al
    84 00001456 E83E000000          <1>     call io_wait
    85                              <1> 
    86                              <1>     ; ICW2: Vector offsets
    87 0000145B B020                <1>     mov al, 0x20                ; Master PIC vector offset 0x20 (32)
    88 0000145D E621                <1>     out PIC1_DATA, al
    89 0000145F E835000000          <1>     call io_wait
    90 00001464 B028                <1>     mov al, 0x28                ; Slave PIC vector offset 0x28 (40)
    91 00001466 E6A1                <1>     out PIC2_DATA, al
    92 00001468 E82C000000          <1>     call io_wait
    93                              <1> 
    94                              <1>     ; ICW3: Cascading configuration
    95 0000146D B004                <1>     mov al, 0x04                ; Master PIC has slave at IRQ2
    96 0000146F E621                <1>     out PIC1_DATA, al
    97 00001471 E823000000          <1>     call io_wait
    98 00001476 B002                <1>     mov al, 0x02                ; Slave PIC cascade identity (2)
    99 00001478 E6A1                <1>     out PIC2_DATA, al
   100 0000147A E81A000000          <1>     call io_wait
   101                              <1> 
   102                              <1>     ; ICW4: Set 8086/88 mode
   103 0000147F B001                <1>     mov al, 0x01
   104 00001481 E621                <1>     out PIC1_DATA, al
   105 00001483 E811000000          <1>     call io_wait
   106 00001488 E6A1                <1>     out PIC2_DATA, al
   107 0000148A E80A000000          <1>     call io_wait
   108                              <1> 
   109                              <1>     ; Unmask IRQ 0 (Timer) and IRQ 1 (Keyboard): 11111100b = 0xFC
   110 0000148F B0FC                <1>     mov al, 0xFC
   111 00001491 E621                <1>     out PIC1_DATA, al
   112 00001493 B0FF                <1>     mov al, 0xFF                ; Mask slave IRQs for now
   113 00001495 E6A1                <1>     out PIC2_DATA, al
   114                              <1> 
   115 00001497 58                  <1>     pop rax
   116 00001498 C3                  <1>     ret
   117                              <1> 
   118                              <1> io_wait:
   119 00001499 E680                <1>     out 0x80, al
   120 0000149B C3                  <1>     ret
   121                              <1> 
   122                              <1> ; ------------------------------------------------------------------------------
   123                              <1> ; idt64_init: Initializes 64-bit IDT, remaps PIC, installs handlers, and loads IDTR
   124                              <1> ; ------------------------------------------------------------------------------
   125                              <1> idt64_init:
   126 0000149C 50                  <1>     push rax
   127 0000149D 53                  <1>     push rbx
   128 0000149E 51                  <1>     push rcx
   129 0000149F 52                  <1>     push rdx
   130                              <1> 
   131                              <1>     ; Remap the 8259 PIC
   132 000014A0 E8A5FFFFFF          <1>     call pic_remap
   133                              <1> 
   134                              <1>     ; Populate all 256 gates with default exception handler
   135 000014A5 4831DB              <1>     xor rbx, rbx
   136                              <1> .init_all_gates:
   137 000014A8 88D8                <1>     mov al, bl
   138 000014AA 48BA-               <1>     mov rdx, isr_default_exception
   138 000014AC [ED15000000000000]  <1>
   139 000014B4 B18E                <1>     mov cl, IDT_GATE_INTERRUPT
   140 000014B6 E84FFFFFFF          <1>     call idt_set_gate
   141 000014BB 48FFC3              <1>     inc rbx
   142 000014BE 4881FB00010000      <1>     cmp rbx, 256
   143 000014C5 7CE1                <1>     jl .init_all_gates
   144                              <1> 
   145                              <1>     ; Install specific CPU exception handlers
   146 000014C7 B000                <1>     mov al, 0                   ; Division by Zero (#0)
   147 000014C9 48BA-               <1>     mov rdx, isr_divide_by_zero
   147 000014CB [0216000000000000]  <1>
   148 000014D3 B18E                <1>     mov cl, IDT_GATE_INTERRUPT
   149 000014D5 E830FFFFFF          <1>     call idt_set_gate
   150                              <1> 
   151 000014DA B00D                <1>     mov al, 13                  ; General Protection Fault (#13)
   152 000014DC 48BA-               <1>     mov rdx, isr_general_protection
   152 000014DE [1716000000000000]  <1>
   153 000014E6 B18E                <1>     mov cl, IDT_GATE_INTERRUPT
   154 000014E8 E81DFFFFFF          <1>     call idt_set_gate
   155                              <1> 
   156                              <1>     ; Install IRQ 0 (Timer, vector 0x20)
   157 000014ED B020                <1>     mov al, 0x20
   158 000014EF 48BA-               <1>     mov rdx, isr_timer
   158 000014F1 [2C16000000000000]  <1>
   159 000014F9 B18E                <1>     mov cl, IDT_GATE_INTERRUPT
   160 000014FB E80AFFFFFF          <1>     call idt_set_gate
   161                              <1> 
   162                              <1>     ; Install IRQ 1 (Keyboard, vector 0x21)
   163 00001500 B021                <1>     mov al, 0x21
   164 00001502 48BA-               <1>     mov rdx, isr_keyboard
   164 00001504 [3B16000000000000]  <1>
   165 0000150C B18E                <1>     mov cl, IDT_GATE_INTERRUPT
   166 0000150E E8F7FEFFFF          <1>     call idt_set_gate
   167                              <1> 
   168                              <1>     ; Install IRQ 12 (Mouse, vector 0x2C)
   169 00001513 B02C                <1>     mov al, 0x2C
   170 00001515 48BA-               <1>     mov rdx, isr_mouse
   170 00001517 [7C16000000000000]  <1>
   171 0000151F B18E                <1>     mov cl, IDT_GATE_INTERRUPT
   172 00001521 E8E4FEFFFF          <1>     call idt_set_gate
   173                              <1> 
   174                              <1>     ; Load 64-bit IDT Pointer register
   175 00001526 0F011DD3FEFFFF      <1>     lidt [idt64_descriptor]
   176                              <1> 
   177 0000152D 5A                  <1>     pop rdx
   178 0000152E 59                  <1>     pop rcx
   179 0000152F 5B                  <1>     pop rbx
   180 00001530 58                  <1>     pop rax
   181 00001531 C3                  <1>     ret
   119                                  %include "isr.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit Interrupt Service Routines (ISRs)
     3                              <1> ; Handles 64-bit hardware IRQs and CPU exception vectors using iretq
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8 00001532 0000000000000000    <1> timer_ticks:        dq 0
     9 0000153A 0A5B43505520455843- <1> MSG_DEFAULT_EXC:    db 0x0A, "[CPU EXCEPTION] Unhandled exception occurred in 64-bit mode! System halted.", 0x0A, 0
     9 00001543 455054494F4E5D2055- <1>
     9 0000154C 6E68616E646C656420- <1>
     9 00001555 657863657074696F6E- <1>
     9 0000155E 206F63637572726564- <1>
     9 00001567 20696E2036342D6269- <1>
     9 00001570 74206D6F6465212053- <1>
     9 00001579 797374656D2068616C- <1>
     9 00001582 7465642E0A00        <1>
    10 00001588 0A5B43505520455843- <1> MSG_DIV_ZERO:       db 0x0A, "[CPU EXCEPTION #0] 64-bit Division By Zero!", 0x0A, 0
    10 00001591 455054494F4E202330- <1>
    10 0000159A 5D2036342D62697420- <1>
    10 000015A3 4469766973696F6E20- <1>
    10 000015AC 4279205A65726F210A- <1>
    10 000015B5 00                  <1>
    11 000015B6 0A5B43505520455843- <1> MSG_GPF:            db 0x0A, "[CPU EXCEPTION #13] 64-bit General Protection Fault!", 0x0A, 0
    11 000015BF 455054494F4E202331- <1>
    11 000015C8 335D2036342D626974- <1>
    11 000015D1 2047656E6572616C20- <1>
    11 000015DA 50726F74656374696F- <1>
    11 000015E3 6E204661756C74210A- <1>
    11 000015EC 00                  <1>
    12                              <1> 
    13                              <1> ; ------------------------------------------------------------------------------
    14                              <1> ; Default CPU Exception Handler
    15                              <1> ; ------------------------------------------------------------------------------
    16                              <1> isr_default_exception:
    17 000015ED B34F                <1>     mov bl, 0x4F                ; White on Red
    18 000015EF 48BE-               <1>     mov rsi, MSG_DEFAULT_EXC
    18 000015F1 [3A15000000000000]  <1>
    19 000015F9 E8BFECFFFF          <1>     call vga_print_string_color
    20 000015FE FA                  <1>     cli
    21 000015FF F4                  <1>     hlt
    22 00001600 EBFE                <1>     jmp $
    23                              <1> 
    24                              <1> ; ------------------------------------------------------------------------------
    25                              <1> ; Division by Zero (#0)
    26                              <1> ; ------------------------------------------------------------------------------
    27                              <1> isr_divide_by_zero:
    28 00001602 B34F                <1>     mov bl, 0x4F
    29 00001604 48BE-               <1>     mov rsi, MSG_DIV_ZERO
    29 00001606 [8815000000000000]  <1>
    30 0000160E E8AAECFFFF          <1>     call vga_print_string_color
    31 00001613 FA                  <1>     cli
    32 00001614 F4                  <1>     hlt
    33 00001615 EBFE                <1>     jmp $
    34                              <1> 
    35                              <1> ; ------------------------------------------------------------------------------
    36                              <1> ; General Protection Fault (#13)
    37                              <1> ; ------------------------------------------------------------------------------
    38                              <1> isr_general_protection:
    39 00001617 B34F                <1>     mov bl, 0x4F
    40 00001619 48BE-               <1>     mov rsi, MSG_GPF
    40 0000161B [B615000000000000]  <1>
    41 00001623 E895ECFFFF          <1>     call vga_print_string_color
    42 00001628 FA                  <1>     cli
    43 00001629 F4                  <1>     hlt
    44 0000162A EBFE                <1>     jmp $
    45                              <1> 
    46                              <1> ; ------------------------------------------------------------------------------
    47                              <1> ; IRQ 0 - System Timer (8253 PIT)
    48                              <1> ; ------------------------------------------------------------------------------
    49                              <1> isr_timer:
    50 0000162C 50                  <1>     push rax
    51 0000162D 48FF05FEFEFFFF      <1>     inc qword [timer_ticks]
    52                              <1> 
    53                              <1>     ; Send End Of Interrupt (EOI) to Master PIC
    54 00001634 B020                <1>     mov al, 0x20
    55 00001636 E620                <1>     out 0x20, al
    56                              <1> 
    57 00001638 58                  <1>     pop rax
    58 00001639 48CF                <1>     iretq
    59                              <1> 
    60                              <1> ; ------------------------------------------------------------------------------
    61                              <1> ; IRQ 1 - PS/2 Keyboard Controller
    62                              <1> ; ------------------------------------------------------------------------------
    63                              <1> isr_keyboard:
    64 0000163B 50                  <1>     push rax
    65 0000163C 53                  <1>     push rbx
    66 0000163D 51                  <1>     push rcx
    67 0000163E 52                  <1>     push rdx
    68 0000163F 56                  <1>     push rsi
    69 00001640 57                  <1>     push rdi
    70 00001641 55                  <1>     push rbp
    71 00001642 4150                <1>     push r8
    72 00001644 4151                <1>     push r9
    73 00001646 4152                <1>     push r10
    74 00001648 4153                <1>     push r11
    75 0000164A 4154                <1>     push r12
    76 0000164C 4155                <1>     push r13
    77 0000164E 4156                <1>     push r14
    78 00001650 4157                <1>     push r15
    79                              <1> 
    80                              <1>     ; Read raw scancode from port 0x60 if data is available
    81 00001652 E464                <1>     in al, 0x64
    82 00001654 A801                <1>     test al, 0x01
    83 00001656 7407                <1>     jz .eoi
    84 00001658 E460                <1>     in al, 0x60
    85 0000165A E830010000          <1>     call keyboard_process_scancode
    86                              <1> 
    87                              <1> .eoi:
