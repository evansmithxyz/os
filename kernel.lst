   226 00003D87 C6470504            <1>     mov byte [rdi + 5], 4
   227                              <1>     ; Opcode = 2 (Reply)
   228 00003D8B 66C747060002        <1>     mov word [rdi + 6], 0x0200  ; Big endian: 0x00, 0x02
   229                              <1> 
   230                              <1>     ; Sender MAC = our net_mac (6 bytes)
   231 00003D91 57                  <1>     push rdi
   232 00003D92 56                  <1>     push rsi
   233 00003D93 488D3D4EFEFFFF      <1>     lea rdi, [arp_pkt_buf + 8]
   234 00003D9A 488D35A7E7FFFF      <1>     lea rsi, [net_mac]
   235 00003DA1 B906000000          <1>     mov rcx, 6
