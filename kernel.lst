   194 00009018 00                  <1>
   195 00009019 7E52                <1>     jle .chk_mouse
   196 0000901B C70551EFFFFFFF0300- <1>     mov dword [mouse_x], 1023
   196 00009024 00                  <1>
   197 00009025 EB46                <1>     jmp .chk_mouse
   198                              <1> 
