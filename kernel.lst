   180                              <1> 
   181                              <1>     ; Validate HW type == 1 (Ethernet)
   182 00003D11 803E00              <1>     cmp byte [rsi + 0], 0
   183 00003D14 0F85D1000000        <1>     jne .arp_done
   184 00003D1A 807E0101            <1>     cmp byte [rsi + 1], 1
   185 00003D1E 0F85C7000000        <1>     jne .arp_done
   186                              <1> 
   187                              <1>     ; Validate Protocol == 0x0800 (IPv4)
   188 00003D24 807E0208            <1>     cmp byte [rsi + 2], 0x08
   189 00003D28 0F85BD000000        <1>     jne .arp_done
   190 00003D2E 807E0300            <1>     cmp byte [rsi + 3], 0x00
   191 00003D32 0F85B3000000        <1>     jne .arp_done
   192                              <1> 
   193                              <1>     ; Validate HW size == 6, Proto size == 4
   194 00003D38 807E0406            <1>     cmp byte [rsi + 4], 6
   195 00003D3C 0F85A9000000        <1>     jne .arp_done
   196 00003D42 807E0504            <1>     cmp byte [rsi + 5], 4
   197 00003D46 0F859F000000        <1>     jne .arp_done
