    71                              <1> 
    72                              <1> ; ------------------------------------------------------------------------------
    73                              <1> ; mouse_read_data: Reads response byte from mouse
    74                              <1> ; Output: AL = Data byte
    75                              <1> ; ------------------------------------------------------------------------------
    76                              <1> mouse_read_data:
    77 00007FC4 E8D2FFFFFF          <1>     call mouse_wait_read
    78 00007FC9 E460                <1>     in al, 0x60
