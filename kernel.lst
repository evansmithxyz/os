   437                              <1> ; arp_resolve: Resolves IPv4 address to Destination MAC address
   438                              <1> ; Input:  RSI = Pointer to 4-byte Target IPv4 address
   439                              <1> ;         RDI = Pointer to 6-byte buffer to store resolved MAC
   440                              <1> ; Output: RAX = 0 (Success), RAX = 1 (Failed/Timeout)
   441                              <1> ; ------------------------------------------------------------------------------
   442                              <1> arp_resolve:
   443 00003F47 53                  <1>     push rbx
   444 00003F48 51                  <1>     push rcx
