   269 000090E9 E868EEFFFF          <1>     call bga_set_text_mode
   270                              <1> 
   271 000090EE 415F                <1>     pop r15
   272 000090F0 415E                <1>     pop r14
   273 000090F2 415D                <1>     pop r13
