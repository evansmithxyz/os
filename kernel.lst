     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit PS/2 Mouse Controller Driver
     3                              <1> ; 8042 Auxiliary Device Communication, 3-Byte Packet Decoder & Position Clamping
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ; Mouse State Variables
     9 00007F76 00020000            <1> mouse_x:            dd 512              ; Current Screen X Coordinate (0 .. 1023)
    10 00007F7A 80010000            <1> mouse_y:            dd 384              ; Current Screen Y Coordinate (0 .. 767)
    11 00007F7E 00                  <1> mouse_buttons:      db 0                ; Bit 0: Left, Bit 1: Right, Bit 2: Middle
    12 00007F7F 00                  <1> mouse_prev_buttons: db 0
    13                              <1> 
    14 00007F80 00                  <1> mouse_cycle:        db 0                ; Packet Cycle (0 .. 2)
    15 00007F81 00                  <1> mouse_byte0:        db 0                ; Flags / Buttons
    16 00007F82 00                  <1> mouse_byte1:        db 0                ; Delta X
    17 00007F83 00                  <1> mouse_byte2:        db 0                ; Delta Y
    18 00007F84 00                  <1> mouse_active:       db 0
    19                              <1> 
    20                              <1> ; ------------------------------------------------------------------------------
    21                              <1> ; mouse_wait_write: Waits until 8042 controller input buffer is empty
    22                              <1> ; ------------------------------------------------------------------------------
    23                              <1> mouse_wait_write:
    24 00007F85 51                  <1>     push rcx
    25 00007F86 50                  <1>     push rax
    26 00007F87 B9A0860100          <1>     mov ecx, 100000
    27                              <1> .loop:
    28 00007F8C E464                <1>     in al, 0x64
    29 00007F8E A802                <1>     test al, 0x02               ; Bit 1: Input buffer status (1 = full)
    30 00007F90 7406                <1>     jz .ready
    31 00007F92 F390                <1>     pause
    32 00007F94 FFC9                <1>     dec ecx
    33 00007F96 75F4                <1>     jnz .loop
    34                              <1> .ready:
    35 00007F98 58                  <1>     pop rax
    36 00007F99 59                  <1>     pop rcx
    37 00007F9A C3                  <1>     ret
    38                              <1> 
    39                              <1> ; ------------------------------------------------------------------------------
    40                              <1> ; mouse_wait_read: Waits until 8042 controller output buffer has data
    41                              <1> ; ------------------------------------------------------------------------------
    42                              <1> mouse_wait_read:
    43 00007F9B 51                  <1>     push rcx
    44 00007F9C 50                  <1>     push rax
    45 00007F9D B9A0860100          <1>     mov ecx, 100000
    46                              <1> .loop:
    47 00007FA2 E464                <1>     in al, 0x64
    48 00007FA4 A801                <1>     test al, 0x01               ; Bit 0: Output buffer status (1 = data ready)
    49 00007FA6 7506                <1>     jnz .ready
    50 00007FA8 F390                <1>     pause
    51 00007FAA FFC9                <1>     dec ecx
    52 00007FAC 75F4                <1>     jnz .loop
    53                              <1> .ready:
    54 00007FAE 58                  <1>     pop rax
    55 00007FAF 59                  <1>     pop rcx
    56 00007FB0 C3                  <1>     ret
    57                              <1> 
    58                              <1> ; ------------------------------------------------------------------------------
    59                              <1> ; mouse_write_cmd: Sends a command byte directly to the mouse device
    60                              <1> ; Input: AL = Command byte
    61                              <1> ; ------------------------------------------------------------------------------
    62                              <1> mouse_write_cmd:
    63 00007FB1 50                  <1>     push rax
    64 00007FB2 E8CEFFFFFF          <1>     call mouse_wait_write
    65 00007FB7 B0D4                <1>     mov al, 0xD4                ; Tell 8042 next byte is for mouse
    66 00007FB9 E664                <1>     out 0x64, al
    67 00007FBB E8C5FFFFFF          <1>     call mouse_wait_write
