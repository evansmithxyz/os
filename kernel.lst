     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit Bochs Graphics Adaptor (BGA) & Framebuffer Driver
     3                              <1> ; High-Resolution 1024x768x32bpp TrueColor Linear Framebuffer (LFB)
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ; BGA I/O Ports
     9                              <1> BGA_INDEX_PORT          equ 0x01CE
    10                              <1> BGA_DATA_PORT           equ 0x01CF
    11                              <1> 
    12                              <1> ; BGA Register Indexes
    13                              <1> VBE_DISPI_INDEX_ID      equ 0x0
    14                              <1> VBE_DISPI_INDEX_XRES    equ 0x1
    15                              <1> VBE_DISPI_INDEX_YRES    equ 0x2
    16                              <1> VBE_DISPI_INDEX_BPP     equ 0x3
    17                              <1> VBE_DISPI_INDEX_ENABLE  equ 0x4
    18                              <1> VBE_DISPI_INDEX_BANK    equ 0x5
    19                              <1> VBE_DISPI_INDEX_VIRT_W  equ 0x6
    20                              <1> VBE_DISPI_INDEX_VIRT_H  equ 0x7
    21                              <1> VBE_DISPI_INDEX_X_OFF   equ 0x8
    22                              <1> VBE_DISPI_INDEX_Y_OFF   equ 0x9
    23                              <1> 
    24                              <1> ; BGA Enable Flags
    25                              <1> VBE_DISPI_DISABLED      equ 0x00
    26                              <1> VBE_DISPI_ENABLED       equ 0x01
    27                              <1> VBE_DISPI_LFB_ENABLED   equ 0x40
    28                              <1> VBE_DISPI_NOCLEARMEM    equ 0x80
    29                              <1> 
    30                              <1> ; Default Resolution: 1024 x 768 x 32bpp
    31                              <1> GUI_SCREEN_WIDTH        equ 1024
    32                              <1> GUI_SCREEN_HEIGHT       equ 768
    33                              <1> GUI_SCREEN_BPP          equ 32
    34                              <1> GUI_SCREEN_PITCH        equ (GUI_SCREEN_WIDTH * 4)
    35                              <1> 
    36                              <1> ; Driver State Variables
    37 00007E74 00                  <1> bga_available:          db 0
    38 00007E75 00                  <1> bga_active:             db 0
    39 00007E76 000000FD00000000    <1> bga_lfb_ptr:            dq 0x00000000FD000000   ; 64-bit Linear Framebuffer pointer (BAR0)
    40 00007E7E 00040000            <1> bga_width:              dd GUI_SCREEN_WIDTH
    41 00007E82 00030000            <1> bga_height:             dd GUI_SCREEN_HEIGHT
    42 00007E86 00100000            <1> bga_pitch:              dd GUI_SCREEN_PITCH
    43                              <1> 
    44                              <1> ; ------------------------------------------------------------------------------
    45                              <1> ; bga_write_register: Writes a 16-bit value to a BGA register index
    46                              <1> ; Input: CX = Register Index, AX = Data Value
    47                              <1> ; ------------------------------------------------------------------------------
    48                              <1> bga_write_register:
    49 00007E8A 52                  <1>     push rdx
    50 00007E8B 66BACE01            <1>     mov dx, BGA_INDEX_PORT
    51 00007E8F 6691                <1>     xchg ax, cx
    52 00007E91 66EF                <1>     out dx, ax                  ; Write Index
    53 00007E93 66BACF01            <1>     mov dx, BGA_DATA_PORT
    54 00007E97 6689C8              <1>     mov ax, cx
    55 00007E9A 66EF                <1>     out dx, ax                  ; Write Data
    56 00007E9C 5A                  <1>     pop rdx
    57 00007E9D C3                  <1>     ret
    58                              <1> 
    59                              <1> ; ------------------------------------------------------------------------------
    60                              <1> ; bga_read_register: Reads a 16-bit value from a BGA register index
    61                              <1> ; Input: CX = Register Index
    62                              <1> ; Output: AX = Data Value
    63                              <1> ; ------------------------------------------------------------------------------
    64                              <1> bga_read_register:
    65 00007E9E 52                  <1>     push rdx
    66 00007E9F 66BACE01            <1>     mov dx, BGA_INDEX_PORT
    67 00007EA3 6689C8              <1>     mov ax, cx
    68 00007EA6 66EF                <1>     out dx, ax                  ; Write Index
    69 00007EA8 66BACF01            <1>     mov dx, BGA_DATA_PORT
    70 00007EAC 66ED                <1>     in ax, dx                   ; Read Data
    71 00007EAE 5A                  <1>     pop rdx
    72 00007EAF C3                  <1>     ret
    73                              <1> 
    74                              <1> ; ------------------------------------------------------------------------------
    75                              <1> ; bga_init: Probes PCI bus for Bochs/QEMU VGA card (1234:1111) and initializes BGA
    76                              <1> ; Output: RAX = 0 on Success, 1 on Error
    77                              <1> ; ------------------------------------------------------------------------------
    78                              <1> bga_init:
    79 00007EB0 53                  <1>     push rbx
    80 00007EB1 51                  <1>     push rcx
    81 00007EB2 52                  <1>     push rdx
    82 00007EB3 56                  <1>     push rsi
    83 00007EB4 57                  <1>     push rdi
    84                              <1> 
    85                              <1>     ; 1. Query BGA Version via Port I/O (Index 0)
    86 00007EB5 66B90000            <1>     mov cx, VBE_DISPI_INDEX_ID
    87 00007EB9 E8E0FFFFFF          <1>     call bga_read_register
    88 00007EBE 663DC0B0            <1>     cmp ax, 0xB0C0
    89 00007EC2 7206                <1>     jb .probe_pci               ; If version < 0xB0C0, still check PCI
    90 00007EC4 663DC6B0            <1>     cmp ax, 0xB0C6
    91 00007EC8 7700                <1>     ja .probe_pci
    92                              <1> 
    93                              <1> .probe_pci:
    94                              <1>     ; 2. Probe PCI Bus for QEMU Standard VGA (Vendor 0x1234, Device 0x1111)
    95 00007ECA 66BE3412            <1>     mov si, 0x1234
    96 00007ECE 66BF1111            <1>     mov di, 0x1111
    97 00007ED2 E89AA5FFFF          <1>     call pci_find_device
    98 00007ED7 751D                <1>     jnz .pci_fallback           ; If not found, use default 0xFD000000
    99                              <1> 
   100                              <1>     ; EAX = bus, EBX = slot, ECX = func
   101                              <1>     ; Also enable memory space decoding in command register
   102 00007ED9 E802A6FFFF          <1>     call pci_enable_bus_master
   103                              <1> 
   104                              <1>     ; Read BAR0 (offset 0x10) to obtain physical framebuffer address
   105 00007EDE BA10000000          <1>     mov edx, 0x10
   106 00007EE3 E818A5FFFF          <1>     call pci_read_dword
   107 00007EE8 83E0F0              <1>     and eax, 0xFFFFFFF0         ; Mask memory space indicator bits
   108 00007EEB 85C0                <1>     test eax, eax
   109 00007EED 7407                <1>     jz .pci_fallback
   110 00007EEF 48890580FFFFFF      <1>     mov [bga_lfb_ptr], rax      ; Store 64-bit LFB base address
   111                              <1> 
   112                              <1> .pci_fallback:
   113 00007EF6 C60577FFFFFF01      <1>     mov byte [bga_available], 1
   114 00007EFD 4831C0              <1>     xor rax, rax                ; Success
   115 00007F00 5F                  <1>     pop rdi
   116 00007F01 5E                  <1>     pop rsi
   117 00007F02 5A                  <1>     pop rdx
   118 00007F03 59                  <1>     pop rcx
   119 00007F04 5B                  <1>     pop rbx
   120 00007F05 C3                  <1>     ret
   121                              <1> 
   122                              <1> ; ------------------------------------------------------------------------------
   123                              <1> ; bga_set_graphics_mode: Switches BGA to 1024x768x32bpp TrueColor Mode
   124                              <1> ; Output: RAX = 0 on Success
   125                              <1> ; ------------------------------------------------------------------------------
   126                              <1> bga_set_graphics_mode:
   127 00007F06 51                  <1>     push rcx
   128 00007F07 52                  <1>     push rdx
   129                              <1> 
   130                              <1>     ; 1. Disable BGA extensions during mode switch
   131 00007F08 66B90400            <1>     mov cx, VBE_DISPI_INDEX_ENABLE
   132 00007F0C 66B80000            <1>     mov ax, VBE_DISPI_DISABLED
   133 00007F10 E875FFFFFF          <1>     call bga_write_register
   134                              <1> 
   135                              <1>     ; 2. Set X Resolution (1024)
   136 00007F15 66B90100            <1>     mov cx, VBE_DISPI_INDEX_XRES
   137 00007F19 66B80004            <1>     mov ax, GUI_SCREEN_WIDTH
   138 00007F1D E868FFFFFF          <1>     call bga_write_register
   139                              <1> 
   140                              <1>     ; 3. Set Y Resolution (768)
   141 00007F22 66B90200            <1>     mov cx, VBE_DISPI_INDEX_YRES
   142 00007F26 66B80003            <1>     mov ax, GUI_SCREEN_HEIGHT
   143 00007F2A E85BFFFFFF          <1>     call bga_write_register
   144                              <1> 
   145                              <1>     ; 4. Set Bits Per Pixel (32bpp)
   146 00007F2F 66B90300            <1>     mov cx, VBE_DISPI_INDEX_BPP
   147 00007F33 66B82000            <1>     mov ax, GUI_SCREEN_BPP
   148 00007F37 E84EFFFFFF          <1>     call bga_write_register
   149                              <1> 
   150                              <1>     ; 5. Enable BGA with Linear Framebuffer (0x41 = ENABLED | LFB_ENABLED)
   151 00007F3C 66B90400            <1>     mov cx, VBE_DISPI_INDEX_ENABLE
   152 00007F40 66B84100            <1>     mov ax, VBE_DISPI_ENABLED | VBE_DISPI_LFB_ENABLED
   153 00007F44 E841FFFFFF          <1>     call bga_write_register
   154                              <1> 
   155 00007F49 C60525FFFFFF01      <1>     mov byte [bga_active], 1
   156 00007F50 4831C0              <1>     xor rax, rax
   157 00007F53 5A                  <1>     pop rdx
   158 00007F54 59                  <1>     pop rcx
   159 00007F55 C3                  <1>     ret
   160                              <1> 
