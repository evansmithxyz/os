   237 00003DA8 5E                  <1>     pop rsi
   238 00003DA9 5F                  <1>     pop rdi
   239                              <1> 
   240                              <1>     ; Sender IP = our net_ip (4 bytes)
   241 00003DAA 8B0578F7FFFF        <1>     mov eax, [net_ip]
   242 00003DB0 89470E              <1>     mov [rdi + 14], eax
   243                              <1> 
   244                              <1>     ; Target MAC = requester's MAC (6 bytes from RSI + 8)
   245 00003DB3 57                  <1>     push rdi
   246 00003DB4 56                  <1>     push rsi
   247 00003DB5 488D3D36FEFFFF      <1>     lea rdi, [arp_pkt_buf + 18]
   248 00003DBC 488D7608            <1>     lea rsi, [rsi + 8]
   249 00003DC0 B906000000          <1>     mov rcx, 6
   250 00003DC5 F3A4                <1>     rep movsb
   251 00003DC7 5E                  <1>     pop rsi
   252 00003DC8 5F                  <1>     pop rdi
   253                              <1> 
   254                              <1>     ; Target IP = requester's IP (4 bytes from RSI + 14)
   255 00003DC9 8B460E              <1>     mov eax, [rsi + 14]
