  1747 0000C4EE 7512                <1>     jne .chk_rm
  1748 0000C4F0 807E0269            <1>     cmp byte [rsi+2], 'i'
  1749 0000C4F4 750C                <1>     jne .chk_rm
  1750 0000C4F6 807E0374            <1>     cmp byte [rsi+3], 't'
  1751 0000C4FA 7506                <1>     jne .chk_rm
  1752 0000C4FC 807E0465            <1>     cmp byte [rsi+4], 'e'
  1753 0000C500 743E                <1>     je .tab_file_mode
  1754                              <1> 
