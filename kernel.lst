   317                              <1> ; vga_print_dec: Prints 64-bit unsigned integer in RAX as decimal
   318                              <1> ; ------------------------------------------------------------------------------
   319                              <1> vga_print_dec:
   320 00000370 50                  <1>     push rax
   321 00000371 51                  <1>     push rcx
   322 00000372 52                  <1>     push rdx
   323 00000373 57                  <1>     push rdi
   324 00000374 56                  <1>     push rsi
   325                              <1> 
   326 00000375 48BF-               <1>     mov rdi, dec_buffer + 23
   326 00000377 [4301000000000000]  <1>
   327 0000037F C60700              <1>     mov byte [rdi], 0
   328 00000382 4885C0              <1>     test rax, rax
   329 00000385 7508                <1>     jnz .convert
   330 00000387 48FFCF              <1>     dec rdi
   331 0000038A C60730              <1>     mov byte [rdi], '0'
   332 0000038D EB18                <1>     jmp .print
   333                              <1> 
   334                              <1> .convert:
   335 0000038F B90A000000          <1>     mov rcx, 10
   336                              <1> .loop:
   337 00000394 4831D2              <1>     xor rdx, rdx
   338 00000397 48F7F1              <1>     div rcx                     ; RAX = quotient, RDX = remainder
   339 0000039A 80C230              <1>     add dl, '0'
   340 0000039D 48FFCF              <1>     dec rdi
   341 000003A0 8817                <1>     mov [rdi], dl
   342 000003A2 4885C0              <1>     test rax, rax
   343 000003A5 75ED                <1>     jnz .loop
   344                              <1> 
   345                              <1> .print:
   346 000003A7 4889FE              <1>     mov rsi, rdi
   347 000003AA E8FDFEFFFF          <1>     call vga_print_string
   348                              <1> 
   349 000003AF 5E                  <1>     pop rsi
   350 000003B0 5F                  <1>     pop rdi
   351 000003B1 5A                  <1>     pop rdx
   352 000003B2 59                  <1>     pop rcx
   353 000003B3 58                  <1>     pop rax
   354 000003B4 C3                  <1>     ret
   355                              <1> 
   356                              <1> ; ------------------------------------------------------------------------------
   357                              <1> ; vga_print_hex8: Prints 8-bit value in AL as 2 hexadecimal uppercase digits
   358                              <1> ; ------------------------------------------------------------------------------
   359                              <1> vga_print_hex8:
   360 000003B5 50                  <1>     push rax
   361 000003B6 53                  <1>     push rbx
   362 000003B7 88C3                <1>     mov bl, al
   363 000003B9 C0E804              <1>     shr al, 4
   364 000003BC 240F                <1>     and al, 0x0F
   365 000003BE E816000000          <1>     call .nibble
   366 000003C3 E8ABFDFFFF          <1>     call vga_print_char
   367 000003C8 88D8                <1>     mov al, bl
   368 000003CA 240F                <1>     and al, 0x0F
   369 000003CC E808000000          <1>     call .nibble
   370 000003D1 E89DFDFFFF          <1>     call vga_print_char
   371 000003D6 5B                  <1>     pop rbx
   372 000003D7 58                  <1>     pop rax
   373 000003D8 C3                  <1>     ret
   374                              <1> .nibble:
   375 000003D9 3C0A                <1>     cmp al, 10
   376 000003DB 7C03                <1>     jl .digit
   377 000003DD 0437                <1>     add al, 'A' - 10
   378 000003DF C3                  <1>     ret
   379                              <1> .digit:
   380 000003E0 0430                <1>     add al, '0'
   381 000003E2 C3                  <1>     ret
   382                              <1> 
