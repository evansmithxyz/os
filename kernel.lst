   257                              <1> 
   258                              <1>     ; Transmit ARP Reply frame
   259 00003DCF 488D350AFEFFFF      <1>     lea rsi, [arp_pkt_buf]
   260 00003DD6 B91C000000          <1>     mov rcx, 28
   261 00003DDB 488D3D10FEFFFF      <1>     lea rdi, [arp_pkt_buf + 18] ; Dst MAC = requester's MAC
   262 00003DE2 66BA0608            <1>     mov dx, ETHERTYPE_ARP
   263 00003DE6 E835FEFFFF          <1>     call eth_send_frame
   264                              <1> 
   265                              <1> .arp_done:
   266 00003DEB 5F                  <1>     pop rdi
   267 00003DEC 5E                  <1>     pop rsi
   268 00003DED 5A                  <1>     pop rdx
