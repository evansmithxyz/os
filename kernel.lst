     1                                  ; ==============================================================================
     2                                  ; Antigravity OS - 64-Bit Long Mode Kernel Entry & Main Event Loop
     3                                  ; Loaded at physical address 0x0000000000008000 by the 64-bit Bootloader
     4                                  ; ==============================================================================
     5                                  
     6                                  [org 0x8000]
     7                                  [bits 64]
     8                                  default rel
     9                                  
    10                                  kernel_entry:
    11                                      ; Initialize screen display
    12 00000000 C605060100000F              mov byte [current_attr], 0x0F   ; White on black
    13 00000007 E838010000                  call vga_clear_screen
    14                                  
    15                                      ; Print OS Welcome Banner
    16 0000000C E886000000                  call kernel_print_banner
    17                                  
    18                                      ; Initialize 64-bit Interrupt Descriptor Table & Remap 8259 PIC
    19 00000011 B309                        mov bl, COLOR_LIGHT_BLUE
    20 00000013 48BE-                       mov rsi, MSG_INIT_IDT
    20 00000015 [4FC9000000000000] 
    21 0000001D E89B020000                  call vga_print_string_color
    22                                  
    23 00000022 E875140000                  call idt64_init
    24                                  
    25 00000027 B30A                        mov bl, COLOR_LIGHT_GREEN
    26 00000029 48BE-                       mov rsi, MSG_IDT_OK
    26 0000002B [8BC9000000000000] 
    27 00000033 E885020000                  call vga_print_string_color
    28                                  
    29                                      ; Enable Hardware Interrupts (IRQ 0 Timer and IRQ 1 Keyboard)
    30 00000038 FB                          sti
    31                                  
    32                                      ; Mount or format AntigravityFS (AFS) Storage Subsystem
    33 00000039 E86B200000                  call fs_init
    34                                  
    35                                      ; Initialize PCI Bus and Realtek RTL8139 Network Subsystem
    36 0000003E E80C320000                  call net_init
    37 00000043 E88C3E0000                  call arp_init
    38                                  
    39                                      ; Initialize Bochs Graphics Adaptor (BGA) Subsystem
    40 00000048 E8637E0000                  call bga_init
    41                                  
    42 0000004D B30B                        mov bl, COLOR_LIGHT_CYAN
    43 0000004F 488D357CC90000              lea rsi, [MSG_READY]
    44 00000056 E862020000                  call vga_print_string_color
    45                                  
    46                                      ; Display Initial 64-bit Shell Prompt
    47 0000005B E85AAF0000                  call shell_print_prompt
    48                                  
    49                                  ; ------------------------------------------------------------------------------
    50                                  ; Main Kernel Event Loop: Low-power park via 'hlt' until hardware interrupt
    51                                  ; ------------------------------------------------------------------------------
    52                                  kernel_loop:
    53                                      ; Poll network interface for background packets (ARP, ICMP ping replies, etc.)
    54 00000060 E8DD330000                  call net_poll
    55                                  
    56 00000065 F4                          hlt
    57                                  
    58                                      ; Check if Tab auto-completion was requested
    59 00000066 803D2316000001              cmp byte [tab_requested], 1
    60 0000006D 750E                        jne .check_enter
    61 0000006F C6051A16000000              mov byte [tab_requested], 0
    62 00000076 E8E3C30000                  call shell_tab_complete
    63 0000007B EBE3                        jmp kernel_loop
    64                                  
    65                                  .check_enter:
    66                                      ; Check if keyboard ISR reported a completed line (Enter was pressed)
    67 0000007D 803D0B16000001              cmp byte [line_ready], 1
    68 00000084 75DA                        jne kernel_loop
    69                                  
    70                                      ; Execute command in buffer
    71 00000086 E844AF0000                  call shell_execute_command
    72                                  
    73                                      ; Reset buffer state for next command
    74 0000008B E823180000                  call keyboard_clear_buffer
    75                                  
    76                                      ; Render prompt again
    77 00000090 E825AF0000                  call shell_print_prompt
    78                                  
    79 00000095 EBC9                        jmp kernel_loop
    80                                  
    81                                  ; ------------------------------------------------------------------------------
    82                                  ; kernel_print_banner: Renders stylized 64-bit OS startup logo
    83                                  ; ------------------------------------------------------------------------------
    84                                  kernel_print_banner:
    85 00000097 50                          push rax
    86 00000098 53                          push rbx
    87 00000099 56                          push rsi
    88                                  
    89                                      ; Print logo in Cyan
    90 0000009A B30B                        mov bl, COLOR_LIGHT_CYAN
    91 0000009C 48BE-                       mov rsi, BANNER_LINE1
    91 0000009E [42C7000000000000] 
    92 000000A6 E812020000                  call vga_print_string_color
    93 000000AB 48BE-                       mov rsi, BANNER_LINE2
    93 000000AD [8DC7000000000000] 
    94 000000B5 E803020000                  call vga_print_string_color
    95 000000BA 48BE-                       mov rsi, BANNER_LINE3
    95 000000BC [D8C7000000000000] 
    96 000000C4 E8F4010000                  call vga_print_string_color
    97 000000C9 48BE-                       mov rsi, BANNER_LINE4
    97 000000CB [23C8000000000000] 
    98 000000D3 E8E5010000                  call vga_print_string_color
    99 000000D8 48BE-                       mov rsi, BANNER_LINE5
    99 000000DA [6EC8000000000000] 
   100 000000E2 E8D6010000                  call vga_print_string_color
   101 000000E7 48BE-                       mov rsi, BANNER_LINE6
   101 000000E9 [B9C8000000000000] 
   102 000000F1 E8C7010000                  call vga_print_string_color
   103                                  
   104                                      ; Print subtitle in Yellow
   105 000000F6 B30E                        mov bl, COLOR_YELLOW
   106 000000F8 48BE-                       mov rsi, BANNER_SUBTITLE
   106 000000FA [04C9000000000000] 
   107 00000102 E8B6010000                  call vga_print_string_color
   108                                  
   109 00000107 5E                          pop rsi
   110 00000108 5B                          pop rbx
   111 00000109 58                          pop rax
   112 0000010A C3                          ret
