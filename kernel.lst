   100                              <1> ; tcp_send_segment: Builds TCP segment with pseudo-header checksum & transmits
   101                              <1> ; Input:
   102                              <1> ;   RSI = Pointer to payload data (or 0 if no payload)
   103                              <1> ;   RCX = Payload length in bytes
   104                              <1> ;   AL  = TCP Flags (e.g. TCP_FLAG_SYN, TCP_FLAG_ACK, TCP_FLAG_PSH, TCP_FLAG_FIN)
   105                              <1> ; ------------------------------------------------------------------------------
   106                              <1> tcp_send_segment:
   107 00007747 53                  <1>     push rbx
   108 00007748 51                  <1>     push rcx
   109 00007749 52                  <1>     push rdx
   110 0000774A 56                  <1>     push rsi
   111 0000774B 57                  <1>     push rdi
   112 0000774C 4150                <1>     push r8
   113 0000774E 4151                <1>     push r9
   114 00007750 4152                <1>     push r10
   115 00007752 4153                <1>     push r11
   116                              <1> 
   117 00007754 4989CA              <1>     mov r10, rcx                ; R10 = Payload length
   118 00007757 4989F3              <1>     mov r11, rsi                ; R11 = Payload pointer
   119 0000775A 4188C0              <1>     mov r8b, al                 ; R8B = Flags
   120                              <1> 
   121                              <1>     ; 1. Build 12-byte IPv4 Pseudo-Header at tcp_tx_packet + 0
   122 0000775D 488D05DCDFFFFF      <1>     lea rax, [tcp_tx_packet]
   123                              <1> 
   124                              <1>     ; Source IP (4 bytes from net_ip)
   125 00007764 8B1DBEBDFFFF        <1>     mov ebx, [net_ip]
   126 0000776A 8918                <1>     mov [rax + 0], ebx
   127                              <1> 
   128                              <1>     ; Destination IP (4 bytes from tcp_remote_ip)
   129 0000776C 8B1DBCDFFFFF        <1>     mov ebx, [tcp_remote_ip]
   130 00007772 895804              <1>     mov [rax + 4], ebx
   131                              <1> 
   132                              <1>     ; Reserved (0x00)
   133 00007775 C6400800            <1>     mov byte [rax + 8], 0
   134                              <1> 
   135                              <1>     ; Protocol (6 = TCP)
   136 00007779 C6400906            <1>     mov byte [rax + 9], IPV4_PROTO_TCP
   137                              <1> 
   138                              <1>     ; TCP Length = 20 + payload_length (Big Endian)
   139 0000777D 664489D3            <1>     mov bx, r10w
   140 00007781 6683C314            <1>     add bx, 20
   141 00007785 88780A              <1>     mov byte [rax + 10], bh
   142 00007788 88580B              <1>     mov byte [rax + 11], bl
   143                              <1> 
   144                              <1>     ; 2. Build 20-byte TCP Header at tcp_tx_packet + 12
   145                              <1>     ; Source Port (Big Endian)
   146 0000778B 668B1D98DFFFFF      <1>     mov bx, [tcp_local_port]
   147 00007792 88780C              <1>     mov byte [rax + 12], bh
   148 00007795 88580D              <1>     mov byte [rax + 13], bl
   149                              <1> 
   150                              <1>     ; Destination Port (Big Endian)
   151 00007798 668B1D8DDFFFFF      <1>     mov bx, [tcp_remote_port]
   152 0000779F 88780E              <1>     mov byte [rax + 14], bh
   153 000077A2 88580F              <1>     mov byte [rax + 15], bl
   154                              <1> 
   155                              <1>     ; Sequence Number (Host Order -> Big Endian)
   156 000077A5 8B1D87DFFFFF        <1>     mov ebx, [tcp_my_seq]
   157 000077AB 0FCB                <1>     bswap ebx
   158 000077AD 895810              <1>     mov [rax + 16], ebx
   159                              <1> 
   160                              <1>     ; Acknowledgment Number (Host Order -> Big Endian)
   161 000077B0 8B1D80DFFFFF        <1>     mov ebx, [tcp_my_ack]
   162 000077B6 0FCB                <1>     bswap ebx
   163 000077B8 895814              <1>     mov [rax + 20], ebx
   164                              <1> 
   165                              <1>     ; Data Offset (5 = 20 bytes -> 0x50) + Reserved (0)
   166 000077BB C6401850            <1>     mov byte [rax + 24], 0x50
   167                              <1> 
   168                              <1>     ; TCP Flags
   169 000077BF 44884019            <1>     mov byte [rax + 25], r8b
   170                              <1> 
   171                              <1>     ; Window Size = 16384 (0x4000 in Big Endian)
   172 000077C3 C6401A40            <1>     mov byte [rax + 26], 0x40
   173 000077C7 C6401B00            <1>     mov byte [rax + 27], 0x00
   174                              <1> 
   175                              <1>     ; Checksum = 0 initially
   176 000077CB 66C7401C0000        <1>     mov word [rax + 28], 0
   177                              <1> 
   178                              <1>     ; Urgent Pointer = 0
   179 000077D1 66C7401E0000        <1>     mov word [rax + 30], 0
   180                              <1> 
   181                              <1>     ; 3. Copy Payload to tcp_tx_packet + 32 (if length > 0)
