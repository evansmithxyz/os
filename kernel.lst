    98                              <1> ; ------------------------------------------------------------------------------
    99                              <1> ; ipv4_send_packet: Encapsulates transport payload into IPv4 packet & transmits
   100                              <1> ; Input:
   101                              <1> ;   RSI = Pointer to transport layer payload (ICMP, TCP, UDP)
   102                              <1> ;   RCX = Payload length in bytes
   103                              <1> ;   RDI = Pointer to 4-byte Destination IPv4 address
   104                              <1> ;   DL  = Protocol number (1=ICMP, 6=TCP, 17=UDP)
   105                              <1> ; ------------------------------------------------------------------------------
   106                              <1> ipv4_send_packet:
   107 00004783 50                  <1>     push rax
   108 00004784 53                  <1>     push rbx
   109 00004785 51                  <1>     push rcx
   110 00004786 52                  <1>     push rdx
   111 00004787 56                  <1>     push rsi
   112 00004788 57                  <1>     push rdi
   113 00004789 4150                <1>     push r8
   114 0000478B 4151                <1>     push r9
   115 0000478D 4152                <1>     push r10
   116 0000478F 4153                <1>     push r11
   117                              <1> 
   118 00004791 4989C8              <1>     mov r8, rcx                 ; R8 = Payload length
   119 00004794 4989F1              <1>     mov r9, rsi                 ; R9 = Payload pointer
   120 00004797 4188D2              <1>     mov r10b, dl                ; R10B = Protocol
   121 0000479A 4989FB              <1>     mov r11, rdi                ; R11 = Destination IP pointer
   122                              <1> 
   123                              <1>     ; 1. Build 20-byte IPv4 Header at ipv4_tx_buf
   124 0000479D 488D057CF8FFFF      <1>     lea rax, [ipv4_tx_buf]
   125                              <1> 
   126                              <1>     ; Version (4) + IHL (5) = 0x45
   127 000047A4 C60045              <1>     mov byte [rax + 0], 0x45
   128                              <1>     ; Type of Service = 0x00
   129 000047A7 C6400100            <1>     mov byte [rax + 1], 0x00
   130                              <1> 
   131                              <1>     ; Total Length (20 + payload_len) in Big Endian
   132 000047AB 4489C3              <1>     mov ebx, r8d
   133 000047AE 83C314              <1>     add ebx, 20
   134 000047B1 887802              <1>     mov byte [rax + 2], bh
   135 000047B4 885803              <1>     mov byte [rax + 3], bl
   136                              <1> 
   137                              <1>     ; Packet Identification
   138 000047B7 668B1D49F8FFFF      <1>     mov bx, [ipv4_packet_id]
   139 000047BE 66FF0542F8FFFF      <1>     inc word [ipv4_packet_id]
   140 000047C5 887804              <1>     mov byte [rax + 4], bh
   141 000047C8 885805              <1>     mov byte [rax + 5], bl
   142                              <1> 
   143                              <1>     ; Flags & Fragment Offset = 0x4000 (Don't Fragment)
   144 000047CB C6400640            <1>     mov byte [rax + 6], 0x40
   145 000047CF C6400700            <1>     mov byte [rax + 7], 0x00
   146                              <1> 
   147                              <1>     ; Time to Live (TTL) = 64
   148 000047D3 C6400840            <1>     mov byte [rax + 8], 64
   149                              <1> 
   150                              <1>     ; Protocol
   151 000047D7 44885009            <1>     mov byte [rax + 9], r10b
   152                              <1> 
   153                              <1>     ; Checksum = 0x0000 initially
   154 000047DB 66C7400A0000        <1>     mov word [rax + 10], 0
   155                              <1> 
   156                              <1>     ; Source IP (4 bytes from net_ip)
   157 000047E1 8B1D41EDFFFF        <1>     mov ebx, [net_ip]
   158 000047E7 89580C              <1>     mov [rax + 12], ebx
   159                              <1> 
   160                              <1>     ; Destination IP (4 bytes from [R11])
   161 000047EA 418B1B              <1>     mov ebx, [r11]
   162 000047ED 895810              <1>     mov [rax + 16], ebx
   163                              <1> 
   164                              <1>     ; Compute IPv4 Header Checksum
   165 000047F0 488D3529F8FFFF      <1>     lea rsi, [ipv4_tx_buf]
   166 000047F7 B914000000          <1>     mov rcx, 20
   167 000047FC E839FFFFFF          <1>     call net_checksum
   168 00004801 66890522F8FFFF      <1>     mov [ipv4_tx_buf + 10], ax  ; Write computed checksum into header
   169                              <1> 
   170                              <1>     ; 2. Copy payload to ipv4_tx_buf + 20
   171 00004808 488D3D25F8FFFF      <1>     lea rdi, [ipv4_tx_buf + 20]
   172 0000480F 4C89CE              <1>     mov rsi, r9
   173 00004812 4C89C1              <1>     mov rcx, r8
   174 00004815 F3A4                <1>     rep movsb
   175                              <1> 
   176                              <1>     ; 3. Resolve Destination MAC via ARP
   177 00004817 4C89DE              <1>     mov rsi, r11
   178 0000481A 488D3DE8F7FFFF      <1>     lea rdi, [resolved_dst_mac]
   179 00004821 E821F7FFFF          <1>     call arp_resolve
   180                              <1> 
   181                              <1>     ; 4. Send Ethernet Frame (Length = 20 + payload_len, EtherType = 0x0800)
   182 00004826 488D35F3F7FFFF      <1>     lea rsi, [ipv4_tx_buf]
   183 0000482D 4C89C1              <1>     mov rcx, r8
   184 00004830 4883C114            <1>     add rcx, 20
   185 00004834 488D3DCEF7FFFF      <1>     lea rdi, [resolved_dst_mac]
   186 0000483B 66BA0008            <1>     mov dx, ETHERTYPE_IPV4
   187 0000483F E8DCF3FFFF          <1>     call eth_send_frame
   188                              <1> 
   189 00004844 415B                <1>     pop r11
   190 00004846 415A                <1>     pop r10
   191 00004848 4159                <1>     pop r9
   192 0000484A 4158                <1>     pop r8
   193 0000484C 5F                  <1>     pop rdi
   194 0000484D 5E                  <1>     pop rsi
   195 0000484E 5A                  <1>     pop rdx
   196 0000484F 59                  <1>     pop rcx
   197 00004850 5B                  <1>     pop rbx
   198 00004851 58                  <1>     pop rax
   199 00004852 C3                  <1>     ret
   200                              <1> 
   201                              <1> ; ------------------------------------------------------------------------------
   202                              <1> ; ipv4_handle_packet: Decodes incoming IPv4 packet from Ethernet layer
   203                              <1> ; Input:
   204                              <1> ;   RSI = Pointer to IPv4 packet
   205                              <1> ;   RCX = Packet length
   206                              <1> ; ------------------------------------------------------------------------------
   207                              <1> ipv4_handle_packet:
   208 00004853 50                  <1>     push rax
   209 00004854 53                  <1>     push rbx
   210 00004855 51                  <1>     push rcx
   211 00004856 52                  <1>     push rdx
   212 00004857 56                  <1>     push rsi
   213 00004858 57                  <1>     push rdi
   214                              <1> 
   215 00004859 4883F914            <1>     cmp rcx, 20
   216 0000485D 726F                <1>     jb .drop
   217                              <1> 
   218                              <1>     ; Check Version == 4 (high nibble of byte 0)
   219 0000485F 8A06                <1>     mov al, [rsi]
   220 00004861 C0E804              <1>     shr al, 4
   221 00004864 3C04                <1>     cmp al, 4
   222 00004866 7566                <1>     jne .drop
   223                              <1> 
   224                              <1>     ; Calculate IHL (low nibble * 4)
   225 00004868 0FB61E              <1>     movzx ebx, byte [rsi]
   226 0000486B 83E30F              <1>     and ebx, 0x0F
   227 0000486E C1E302              <1>     shl ebx, 2                  ; EBX = header length in bytes
   228 00004871 83FB14              <1>     cmp ebx, 20
   229 00004874 7258                <1>     jb .drop
   230                              <1> 
   231                              <1>     ; Extract Total Length (Big Endian)
   232 00004876 0FB64602            <1>     movzx eax, byte [rsi + 2]
   233 0000487A C1E008              <1>     shl eax, 8
   234 0000487D 8A4603              <1>     mov al, [rsi + 3]
   235 00004880 4839C1              <1>     cmp rcx, rax
   236 00004883 7249                <1>     jb .drop                    ; Truncated packet
   237                              <1> 
   238                              <1>     ; Payload Length = Total Length - IHL
   239 00004885 29D8                <1>     sub eax, ebx
   240 00004887 4189C0              <1>     mov r8d, eax                ; R8D = Payload length
   241                              <1> 
   242                              <1>     ; Extract Protocol (byte 9)
   243 0000488A 0FB65609            <1>     movzx edx, byte [rsi + 9]
   244                              <1> 
   245                              <1>     ; Extract Source IP (RSI + 12) and Dest IP (RSI + 16)
   246 0000488E 488D7E0C            <1>     lea rdi, [rsi + 12]         ; RDI = Pointer to Source IP
   247                              <1> 
   248                              <1>     ; Save TTL (byte 8)
   249 00004892 8A4608              <1>     mov al, [rsi + 8]
   250 00004895 880577F7FFFF        <1>     mov [ping_reply_ttl], al
   251                              <1> 
   252                              <1>     ; Advance RSI to payload (RSI + IHL)
   253 0000489B 4801DE              <1>     add rsi, rbx
   254 0000489E 4C89C1              <1>     mov rcx, r8                 ; RCX = Payload length
   255                              <1> 
   256                              <1>     ; Dispatch based on Protocol
   257 000048A1 80FA01              <1>     cmp dl, IPV4_PROTO_ICMP
   258 000048A4 740C                <1>     je .handle_icmp
   259                              <1> 
   260 000048A6 80FA11              <1>     cmp dl, IPV4_PROTO_UDP
   261 000048A9 7411                <1>     je .handle_udp
   262                              <1> 
   263 000048AB 80FA06              <1>     cmp dl, IPV4_PROTO_TCP
   264 000048AE 7416                <1>     je .handle_tcp
   265                              <1> 
   266 000048B0 EB1C                <1>     jmp .drop
   267                              <1> 
   268                              <1> .handle_icmp:
   269 000048B2 4889FA              <1>     mov rdx, rdi                ; RDX = Source IP pointer
   270 000048B5 E81B000000          <1>     call icmp_handle_packet
   271 000048BA EB12                <1>     jmp .drop
   272                              <1> 
   273                              <1> .handle_udp:
   274 000048BC 4889FA              <1>     mov rdx, rdi                ; RDX = Source IP pointer
   275 000048BF E8920B0000          <1>     call udp_handle_packet
   276 000048C4 EB08                <1>     jmp .drop
   277                              <1> 
   278                              <1> .handle_tcp:
   279 000048C6 4889FA              <1>     mov rdx, rdi                ; RDX = Source IP pointer
   280 000048C9 E8862F0000          <1>     call tcp_handle_packet
   281                              <1> 
   282                              <1> .drop:
   283 000048CE 5F                  <1>     pop rdi
   284 000048CF 5E                  <1>     pop rsi
   285 000048D0 5A                  <1>     pop rdx
   286 000048D1 59                  <1>     pop rcx
   287 000048D2 5B                  <1>     pop rbx
   288 000048D3 58                  <1>     pop rax
   289 000048D4 C3                  <1>     ret
   290                              <1> 
   291                              <1> ; ------------------------------------------------------------------------------
   292                              <1> ; icmp_handle_packet: Processes incoming ICMP packets (Echo Request / Echo Reply)
   293                              <1> ; Input:
   294                              <1> ;   RSI = Pointer to ICMP header & payload
   295                              <1> ;   RCX = ICMP length
   296                              <1> ;   RDX = Pointer to 4-byte Source IPv4 address
   297                              <1> ; ------------------------------------------------------------------------------
   298                              <1> icmp_handle_packet:
   299 000048D5 50                  <1>     push rax
   300 000048D6 53                  <1>     push rbx
   301 000048D7 51                  <1>     push rcx
   302 000048D8 52                  <1>     push rdx
   303 000048D9 56                  <1>     push rsi
   304 000048DA 57                  <1>     push rdi
   305                              <1> 
   306 000048DB 4883F908            <1>     cmp rcx, 8
   307 000048DF 7270                <1>     jb .done
   308                              <1> 
   309 000048E1 8A06                <1>     mov al, [rsi + 0]           ; Type
   310 000048E3 8A5E01              <1>     mov bl, [rsi + 1]           ; Code
   311                              <1> 
   312                              <1>     ; Check for ICMP Echo Request (Type 8, Code 0)
   313 000048E6 3C08                <1>     cmp al, ICMP_ECHO_REQUEST
   314 000048E8 7406                <1>     je .reply_echo
   315                              <1> 
   316                              <1>     ; Check for ICMP Echo Reply (Type 0, Code 0)
   317 000048EA 3C00                <1>     cmp al, ICMP_ECHO_REPLY
   318 000048EC 744B                <1>     je .record_reply
   319                              <1> 
   320 000048EE EB61                <1>     jmp .done
   321                              <1> 
   322                              <1> .reply_echo:
   323                              <1>     ; Build Echo Reply: exactly copy packet, change Type to 0, recompute checksum
   324 000048F0 488D3D69FDFFFF      <1>     lea rdi, [icmp_tx_buf]
   325 000048F7 51                  <1>     push rcx
   326 000048F8 56                  <1>     push rsi
   327 000048F9 F3A4                <1>     rep movsb
   328 000048FB 5E                  <1>     pop rsi
   329 000048FC 59                  <1>     pop rcx
   330                              <1> 
   331                              <1>     ; Type = 0 (Echo Reply)
   332 000048FD C6055CFDFFFF00      <1>     mov byte [icmp_tx_buf + 0], ICMP_ECHO_REPLY
   333                              <1>     ; Zero out checksum before calculation
   334 00004904 66C70555FDFFFF0000  <1>     mov word [icmp_tx_buf + 2], 0
   335                              <1> 
   336                              <1>     ; Calculate new ICMP Checksum
   337 0000490D 56                  <1>     push rsi
   338 0000490E 51                  <1>     push rcx
   339 0000490F 52                  <1>     push rdx
   340 00004910 488D3549FDFFFF      <1>     lea rsi, [icmp_tx_buf]
   341 00004917 E81EFEFFFF          <1>     call net_checksum
   342 0000491C 6689053FFDFFFF      <1>     mov [icmp_tx_buf + 2], ax
   343 00004923 5A                  <1>     pop rdx
   344 00004924 59                  <1>     pop rcx
   345 00004925 5E                  <1>     pop rsi
   346                              <1> 
   347                              <1>     ; Send back via IPv4
   348 00004926 488D3533FDFFFF      <1>     lea rsi, [icmp_tx_buf]
   349 0000492D 4889D7              <1>     mov rdi, rdx                ; Dst IP = original Source IP
   350 00004930 B201                <1>     mov dl, IPV4_PROTO_ICMP
   351 00004932 E84CFEFFFF          <1>     call ipv4_send_packet
   352 00004937 EB18                <1>     jmp .done
   353                              <1> 
   354                              <1> .record_reply:
   355                              <1>     ; Extract sequence number (offset 6, Big Endian)
   356 00004939 0FB64606            <1>     movzx eax, byte [rsi + 6]
   357 0000493D C1E008              <1>     shl eax, 8
   358 00004940 8A4607              <1>     mov al, [rsi + 7]
   359 00004943 668905C6F6FFFF      <1>     mov [ping_reply_seq], ax
   360 0000494A C605BEF6FFFF01      <1>     mov byte [ping_reply_rx], 1
   361                              <1> 
   362                              <1> .done:
   363 00004951 5F                  <1>     pop rdi
   364 00004952 5E                  <1>     pop rsi
   365 00004953 5A                  <1>     pop rdx
   366 00004954 59                  <1>     pop rcx
   367 00004955 5B                  <1>     pop rbx
   368 00004956 58                  <1>     pop rax
   369 00004957 C3                  <1>     ret
   370                              <1> 
   371                              <1> ; ------------------------------------------------------------------------------
   372                              <1> ; vga_print_ip: Formats and prints a 4-byte IPv4 address (e.g. 10.0.2.15)
   373                              <1> ; Input: RSI = Pointer to 4-byte IP address
   374                              <1> ; ------------------------------------------------------------------------------
   375                              <1> vga_print_ip:
   376 00004958 50                  <1>     push rax
   377 00004959 51                  <1>     push rcx
   378 0000495A 56                  <1>     push rsi
   379                              <1> 
   380 0000495B 31C9                <1>     xor ecx, ecx
   381                              <1> .loop:
   382 0000495D 0FB6040E            <1>     movzx eax, byte [rsi + rcx]
   383 00004961 E80ABAFFFF          <1>     call vga_print_dec
   384 00004966 83F903              <1>     cmp ecx, 3
   385 00004969 740B                <1>     je .done
   386 0000496B B02E                <1>     mov al, '.'
   387 0000496D E801B8FFFF          <1>     call vga_print_char
   388 00004972 FFC1                <1>     inc ecx
   389 00004974 EBE7                <1>     jmp .loop
   390                              <1> 
   391                              <1> .done:
   392 00004976 5E                  <1>     pop rsi
   393 00004977 59                  <1>     pop rcx
   394 00004978 58                  <1>     pop rax
   395 00004979 C3                  <1>     ret
   396                              <1> 
   397                              <1> ; ------------------------------------------------------------------------------
   398                              <1> ; icmp_ping: Sends ICMP Echo Request to target IP and displays RTT response
   399                              <1> ; Input: RSI = Pointer to 4-byte Target IPv4 address
   400                              <1> ; ------------------------------------------------------------------------------
   401                              <1> icmp_ping:
   402 0000497A 50                  <1>     push rax
   403 0000497B 53                  <1>     push rbx
   404 0000497C 51                  <1>     push rcx
   405 0000497D 52                  <1>     push rdx
   406 0000497E 56                  <1>     push rsi
   407 0000497F 57                  <1>     push rdi
   408                              <1> 
   409 00004980 8B06                <1>     mov eax, [rsi]
   410 00004982 890593F6FFFF        <1>     mov [ping_target_ip], eax
   411                              <1> 
   412                              <1>     ; Print Header: "PING 10.0.2.2 (56 data bytes):"
   413 00004988 B30B                <1>     mov bl, COLOR_LIGHT_CYAN
   414 0000498A 488D354FFDFFFF      <1>     lea rsi, [MSG_PING_HEADER]
   415 00004991 E827B9FFFF          <1>     call vga_print_string_color
   416                              <1> 
   417 00004996 488D357EF6FFFF      <1>     lea rsi, [ping_target_ip]
   418 0000499D E8B6FFFFFF          <1>     call vga_print_ip
   419                              <1> 
   420 000049A2 488D353DFDFFFF      <1>     lea rsi, [MSG_PING_BYTES]
   421 000049A9 E80FB9FFFF          <1>     call vga_print_string_color
   422                              <1> 
   423                              <1>     ; Send 4 ping probes
   424 000049AE 41BC01000000        <1>     mov r12d, 1                 ; Sequence number (1 .. 4)
   425                              <1> 
   426                              <1> .ping_probe:
   427 000049B4 C60554F6FFFF00      <1>     mov byte [ping_reply_rx], 0
   428                              <1> 
   429                              <1>     ; Build ICMP Echo Request (Type 8, Code 0, ID 0x1234, Seq r12w, 32 bytes payload)
   430 000049BB 488D3D9EFCFFFF      <1>     lea rdi, [icmp_tx_buf]
   431 000049C2 C60708              <1>     mov byte [rdi + 0], ICMP_ECHO_REQUEST
   432 000049C5 C6470100            <1>     mov byte [rdi + 1], 0       ; Code 0
   433 000049C9 66C747020000        <1>     mov word [rdi + 2], 0       ; Checksum = 0
   434 000049CF 66C747041234        <1>     mov word [rdi + 4], 0x3412  ; Identifier
   435                              <1>     ; Sequence in Big Endian
   436 000049D5 C6470600            <1>     mov byte [rdi + 6], 0
   437 000049D9 44886707            <1>     mov byte [rdi + 7], r12b
   438                              <1> 
   439                              <1>     ; 32-byte test payload
   440 000049DD B844434241          <1>     mov eax, 0x41424344         ; "ABCD"
   441 000049E2 894708              <1>     mov [rdi + 8], eax
   442 000049E5 89470C              <1>     mov [rdi + 12], eax
   443 000049E8 894710              <1>     mov [rdi + 16], eax
   444 000049EB 894714              <1>     mov [rdi + 20], eax
   445 000049EE 894718              <1>     mov [rdi + 24], eax
   446 000049F1 89471C              <1>     mov [rdi + 28], eax
   447 000049F4 894720              <1>     mov [rdi + 32], eax
   448 000049F7 894724              <1>     mov [rdi + 36], eax
   449                              <1> 
   450                              <1>     ; Compute Checksum over 40 bytes (8 header + 32 payload)
   451 000049FA 488D355FFCFFFF      <1>     lea rsi, [icmp_tx_buf]
   452 00004A01 B928000000          <1>     mov rcx, 40
   453 00004A06 E82FFDFFFF          <1>     call net_checksum
   454 00004A0B 66890550FCFFFF      <1>     mov [icmp_tx_buf + 2], ax
   455                              <1> 
   456                              <1>     ; Record start ticks
   457 00004A12 488B0519CBFFFF      <1>     mov rax, [timer_ticks]
   458 00004A19 488905F3F5FFFF      <1>     mov [ping_start_tick], rax
   459                              <1> 
   460                              <1>     ; Send packet via IPv4
   461 00004A20 488D3539FCFFFF      <1>     lea rsi, [icmp_tx_buf]
   462 00004A27 B928000000          <1>     mov rcx, 40
   463 00004A2C 488D3DE8F5FFFF      <1>     lea rdi, [ping_target_ip]
   464 00004A33 B201                <1>     mov dl, IPV4_PROTO_ICMP
   465 00004A35 E849FDFFFF          <1>     call ipv4_send_packet
   466                              <1> 
   467                              <1>     ; Poll for reply (up to ~1000 ms timeout)
   468 00004A3A 488B05F1CAFFFF      <1>     mov rax, [timer_ticks]
   469 00004A41 4883C014            <1>     add rax, 20                 ; 20 ticks (~1 sec)
   470 00004A45 4989C5              <1>     mov r13, rax
   471                              <1> .wait_reply:
   472 00004A48 E8F5E9FFFF          <1>     call net_poll
   473 00004A4D 803DBBF5FFFF01      <1>     cmp byte [ping_reply_rx], 1
   474 00004A54 7424                <1>     je .got_reply
   475                              <1> 
   476                              <1>     ; Micro-delay
   477 00004A56 B9D0070000          <1>     mov ecx, 2000
   478                              <1> .spin:
   479 00004A5B F390                <1>     pause
   480 00004A5D FFC9                <1>     dec ecx
   481 00004A5F 75FA                <1>     jnz .spin
   482                              <1> 
   483 00004A61 4C392DCACAFFFF      <1>     cmp [timer_ticks], r13
   484 00004A68 72DE                <1>     jb .wait_reply
   485                              <1> 
   486                              <1>     ; Timeout!
   487 00004A6A B30C                <1>     mov bl, COLOR_LIGHT_RED
   488 00004A6C 488D35B3FCFFFF      <1>     lea rsi, [MSG_PING_TIMEOUT]
   489 00004A73 E845B8FFFF          <1>     call vga_print_string_color
   490 00004A78 EB7D                <1>     jmp .next_probe
   491                              <1> 
   492                              <1> .got_reply:
   493                              <1>     ; Print: "64 bytes from 10.0.2.2: icmp_seq=1 ttl=64 time=X ms"
   494 00004A7A 488D3578FCFFFF      <1>     lea rsi, [MSG_PING_REPLY]
   495 00004A81 E826B8FFFF          <1>     call vga_print_string
   496                              <1> 
   497 00004A86 488D358EF5FFFF      <1>     lea rsi, [ping_target_ip]
   498 00004A8D E8C6FEFFFF          <1>     call vga_print_ip
   499                              <1> 
   500 00004A92 488D356FFCFFFF      <1>     lea rsi, [MSG_PING_SEQ]
   501 00004A99 E80EB8FFFF          <1>     call vga_print_string
   502 00004A9E 0FB7056BF5FFFF      <1>     movzx eax, word [ping_reply_seq]
   503 00004AA5 E8C6B8FFFF          <1>     call vga_print_dec
   504                              <1> 
   505 00004AAA 488D3563FCFFFF      <1>     lea rsi, [MSG_PING_TTL]
   506 00004AB1 E8F6B7FFFF          <1>     call vga_print_string
   507 00004AB6 0FB60555F5FFFF      <1>     movzx eax, byte [ping_reply_ttl]
   508 00004ABD E8AEB8FFFF          <1>     call vga_print_dec
   509                              <1> 
   510 00004AC2 488D3551FCFFFF      <1>     lea rsi, [MSG_PING_TIME]
   511 00004AC9 E8DEB7FFFF          <1>     call vga_print_string
   512                              <1> 
   513                              <1>     ; Compute elapsed time (approx ms based on timer ticks)
   514 00004ACE 488B055DCAFFFF      <1>     mov rax, [timer_ticks]
   515 00004AD5 482B0537F5FFFF      <1>     sub rax, [ping_start_tick]
   516                              <1>     ; If < 1, display 1 ms
   517 00004ADC 83F801              <1>     cmp eax, 1
   518 00004ADF 7305                <1>     jae .show_ms
   519 00004AE1 B801000000          <1>     mov eax, 1
   520                              <1> .show_ms:
   521 00004AE6 E885B8FFFF          <1>     call vga_print_dec
   522                              <1> 
   523 00004AEB 488D352FFCFFFF      <1>     lea rsi, [MSG_PING_MS]
   524 00004AF2 E8B5B7FFFF          <1>     call vga_print_string
   525                              <1> 
   526                              <1> .next_probe:
   527 00004AF7 41FFC4              <1>     inc r12d
   528 00004AFA 4183FC04            <1>     cmp r12d, 4
   529 00004AFE 0F86B0FEFFFF        <1>     jbe .ping_probe
   530                              <1> 
   531 00004B04 5F                  <1>     pop rdi
   532 00004B05 5E                  <1>     pop rsi
   533 00004B06 5A                  <1>     pop rdx
   534 00004B07 59                  <1>     pop rcx
   535 00004B08 5B                  <1>     pop rbx
   536 00004B09 58                  <1>     pop rax
   537 00004B0A C3                  <1>     ret
   538                              <1> 
   539                              <1> ; ------------------------------------------------------------------------------
   540                              <1> ; net_parse_ip: Parses dotted-decimal IPv4 string (e.g. "10.0.2.15") into 4 bytes
   541                              <1> ; Input:
   542                              <1> ;   RSI = Pointer to null-terminated or space-terminated ASCII string
   543                              <1> ;   RDI = Pointer to 4-byte buffer to receive IP address
   544                              <1> ; Output:
   545                              <1> ;   RAX = 0 on Success, 1 on Error (invalid format or octet > 255)
   546                              <1> ;   RSI = Advanced past parsed IP string
   547                              <1> ; ------------------------------------------------------------------------------
   548                              <1> net_parse_ip:
   549 00004B0B 53                  <1>     push rbx
   550 00004B0C 51                  <1>     push rcx
   551 00004B0D 52                  <1>     push rdx
   552 00004B0E 4150                <1>     push r8
   553                              <1> 
   554 00004B10 4989F8              <1>     mov r8, rdi                 ; R8 = output destination
   555 00004B13 31C9                <1>     xor ecx, ecx                ; ECX = octet counter (0 .. 3)
   556                              <1> 
   557                              <1> .octet_loop:
   558 00004B15 31D2                <1>     xor edx, edx                ; EDX = octet accumulator
   559 00004B17 31DB                <1>     xor ebx, ebx                ; EBX = digit count for this octet
   560                              <1> 
   561                              <1> .digit_loop:
   562 00004B19 8A06                <1>     mov al, [rsi]
   563 00004B1B 3C30                <1>     cmp al, '0'
   564 00004B1D 721D                <1>     jb .digit_done
   565 00004B1F 3C39                <1>     cmp al, '9'
   566 00004B21 7719                <1>     ja .digit_done
   567                              <1> 
   568                              <1>     ; Digit found
   569 00004B23 2C30                <1>     sub al, '0'
   570 00004B25 0FB6C0              <1>     movzx eax, al
   571 00004B28 6BD20A              <1>     imul edx, 10
   572 00004B2B 01C2                <1>     add edx, eax
   573 00004B2D 81FAFF000000        <1>     cmp edx, 255
   574 00004B33 7725                <1>     ja .error                   ; Octet overflow (> 255)
   575                              <1> 
   576 00004B35 48FFC6              <1>     inc rsi
   577 00004B38 FFC3                <1>     inc ebx
   578 00004B3A EBDD                <1>     jmp .digit_loop
   579                              <1> 
   580                              <1> .digit_done:
   581                              <1>     ; Must have parsed at least 1 digit
   582 00004B3C 85DB                <1>     test ebx, ebx
   583 00004B3E 741A                <1>     jz .error
   584                              <1> 
   585                              <1>     ; Save octet byte
   586 00004B40 41881408            <1>     mov [r8 + rcx], dl
   587 00004B44 FFC1                <1>     inc ecx
   588 00004B46 83F904              <1>     cmp ecx, 4
   589 00004B49 740A                <1>     je .done_check
   590                              <1> 
   591                              <1>     ; Expect '.' delimiter
   592 00004B4B 803E2E              <1>     cmp byte [rsi], '.'
   593 00004B4E 750A                <1>     jne .error
   594 00004B50 48FFC6              <1>     inc rsi                     ; Skip '.'
   595 00004B53 EBC0                <1>     jmp .octet_loop
   596                              <1> 
   597                              <1> .done_check:
   598 00004B55 4831C0              <1>     xor rax, rax                ; Success
   599 00004B58 EB05                <1>     jmp .exit
   600                              <1> 
   601                              <1> .error:
   602 00004B5A B801000000          <1>     mov rax, 1
   603                              <1> 
   604                              <1> .exit:
   605 00004B5F 4158                <1>     pop r8
   606 00004B61 5A                  <1>     pop rdx
   607 00004B62 59                  <1>     pop rcx
   608 00004B63 5B                  <1>     pop rbx
   609 00004B64 C3                  <1>     ret
   610                              <1> 
   127                                  %include "udp.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit User Datagram Protocol (UDP) & DNS Resolver Engine
     3                              <1> ; RFC 768 UDP Transport & RFC 1035 Domain Name System (DNS) Client
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> UDP_PORT_DNS        equ 53
     9                              <1> UDP_SRC_PORT_DNS    equ 53530
    10                              <1> 
    11                              <1> ; State Variables
    12 00004B65 4242                <1> dns_query_id:       dw 0x4242
    13 00004B67 00                  <1> dns_resolved_flag:  db 0
    14 00004B68 00<rep 4h>          <1> dns_resolved_ip:    times 4 db 0
    15                              <1> 
    16                              <1> ; Buffers
    17 00004B6C 90<rep 4h>          <1> align 16
    18 00004B70 00<rep 5DCh>        <1> udp_tx_buf:         times 1500 db 0
    19 0000514C 90<rep 4h>          <1> align 16
    20 00005150 00<rep 200h>        <1> dns_query_buf:      times 512 db 0
    21                              <1> 
    22                              <1> ; Strings & Messages
    23 00005350 5265736F6C76696E67- <1> MSG_DNS_RESOLVING:  db "Resolving ", 0
    23 00005359 2000                <1>
    24 0000535B 2076696120444E5320- <1> MSG_DNS_VIA:        db " via DNS server ", 0
    24 00005364 7365727665722000    <1>
    25 0000536C 2E2E2E2000          <1> MSG_DNS_DOTS:       db "... ", 0
    26 00005371 4F4B0A202041646472- <1> MSG_DNS_SUCCESS:    db "OK", 0x0A, "  Address: ", 0
    26 0000537A 6573733A2000        <1>
    27 00005380 54494D454F55540A5B- <1> MSG_DNS_TIMEOUT:    db "TIMEOUT", 0x0A, "[DNS] Error: Name resolution timed out.", 0x0A, 0
    27 00005389 444E535D204572726F- <1>
    27 00005392 723A204E616D652072- <1>
    27 0000539B 65736F6C7574696F6E- <1>
    27 000053A4 2074696D6564206F75- <1>
    27 000053AD 742E0A00            <1>
    28 000053B1 4641494C45440A5B44- <1> MSG_DNS_NOT_FOUND:  db "FAILED", 0x0A, "[DNS] Error: Host not found (NXDOMAIN).", 0x0A, 0
    28 000053BA 4E535D204572726F72- <1>
    28 000053C3 3A20486F7374206E6F- <1>
    28 000053CC 7420666F756E642028- <1>
    28 000053D5 4E58444F4D41494E29- <1>
    28 000053DE 2E0A00              <1>
    29                              <1> 
    30                              <1> ; ------------------------------------------------------------------------------
    31                              <1> ; udp_send_packet: Encapsulates UDP payload and transmits via IPv4
    32                              <1> ; Input:
    33                              <1> ;   RSI = Pointer to UDP payload
    34                              <1> ;   RCX = Payload length in bytes
    35                              <1> ;   RDI = Pointer to 4-byte Destination IPv4 address
    36                              <1> ;   DX  = Source Port (Host Order, 16-bit)
    37                              <1> ;   R8W = Destination Port (Host Order, 16-bit)
    38                              <1> ; Output:
    39                              <1> ;   RAX = 0 on success, 1 on error
    40                              <1> ; ------------------------------------------------------------------------------
    41                              <1> udp_send_packet:
    42 000053E1 53                  <1>     push rbx
    43 000053E2 51                  <1>     push rcx
    44 000053E3 52                  <1>     push rdx
    45 000053E4 56                  <1>     push rsi
    46 000053E5 57                  <1>     push rdi
    47 000053E6 4150                <1>     push r8
    48 000053E8 4151                <1>     push r9
    49 000053EA 4152                <1>     push r10
    50 000053EC 4153                <1>     push r11
    51                              <1> 
    52 000053EE 4989F1              <1>     mov r9, rsi                 ; R9 = Payload pointer
    53 000053F1 4989CA              <1>     mov r10, rcx                ; R10 = Payload length
    54 000053F4 4989FB              <1>     mov r11, rdi                ; R11 = Destination IP pointer
    55                              <1> 
    56                              <1>     ; Build 8-byte UDP Header at udp_tx_buf
    57 000053F7 488D0572F7FFFF      <1>     lea rax, [udp_tx_buf]
    58                              <1> 
    59                              <1>     ; 1. Source Port (Big Endian)
    60 000053FE 8830                <1>     mov byte [rax + 0], dh
    61 00005400 885001              <1>     mov byte [rax + 1], dl
    62                              <1> 
    63                              <1>     ; 2. Destination Port (Big Endian)
    64 00005403 664489C3            <1>     mov bx, r8w
    65 00005407 887802              <1>     mov byte [rax + 2], bh
    66 0000540A 885803              <1>     mov byte [rax + 3], bl
    67                              <1> 
    68                              <1>     ; 3. Length = 8 + payload length (Big Endian)
    69 0000540D 664489D3            <1>     mov bx, r10w
    70 00005411 6683C308            <1>     add bx, 8
    71 00005415 887804              <1>     mov byte [rax + 4], bh
    72 00005418 885805              <1>     mov byte [rax + 5], bl
    73                              <1> 
    74                              <1>     ; 4. Checksum = 0x0000 (Optional in IPv4 UDP)
    75 0000541B 66C740060000        <1>     mov word [rax + 6], 0
    76                              <1> 
    77                              <1>     ; 5. Copy payload to udp_tx_buf + 8
    78 00005421 488D3D50F7FFFF      <1>     lea rdi, [udp_tx_buf + 8]
    79 00005428 4C89CE              <1>     mov rsi, r9
    80 0000542B 4C89D1              <1>     mov rcx, r10
    81 0000542E F3A4                <1>     rep movsb
    82                              <1> 
    83                              <1>     ; 6. Send via IPv4 Layer
    84                              <1>     ; Total UDP packet length = 8 + payload length
    85 00005430 4C89D1              <1>     mov rcx, r10
    86 00005433 4883C108            <1>     add rcx, 8
    87 00005437 488D3532F7FFFF      <1>     lea rsi, [udp_tx_buf]
    88 0000543E 4C89DF              <1>     mov rdi, r11                ; Destination IP
    89 00005441 B211                <1>     mov dl, IPV4_PROTO_UDP      ; Protocol 17
    90 00005443 E83BF3FFFF          <1>     call ipv4_send_packet
    91                              <1> 
    92 00005448 415B                <1>     pop r11
    93 0000544A 415A                <1>     pop r10
    94 0000544C 4159                <1>     pop r9
    95 0000544E 4158                <1>     pop r8
    96 00005450 5F                  <1>     pop rdi
    97 00005451 5E                  <1>     pop rsi
    98 00005452 5A                  <1>     pop rdx
    99 00005453 59                  <1>     pop rcx
   100 00005454 5B                  <1>     pop rbx
   101 00005455 C3                  <1>     ret
   102                              <1> 
   103                              <1> ; ------------------------------------------------------------------------------
   104                              <1> ; udp_handle_packet: Processes incoming UDP packet from IPv4 layer
   105                              <1> ; Input:
   106                              <1> ;   RSI = Pointer to UDP packet (header + payload)
   107                              <1> ;   RCX = Packet length
   108                              <1> ;   RDX = Pointer to 4-byte Source IPv4 address
   109                              <1> ; ------------------------------------------------------------------------------
   110                              <1> udp_handle_packet:
   111 00005456 50                  <1>     push rax
   112 00005457 53                  <1>     push rbx
   113 00005458 51                  <1>     push rcx
   114 00005459 52                  <1>     push rdx
   115 0000545A 56                  <1>     push rsi
   116 0000545B 57                  <1>     push rdi
   117                              <1> 
   118                              <1>     ; Minimum UDP header size is 8 bytes
   119 0000545C 4883F908            <1>     cmp rcx, 8
   120 00005460 722F                <1>     jb .done
   121                              <1> 
   122                              <1>     ; Extract Source Port (Big Endian -> Host Order)
   123 00005462 0FB606              <1>     movzx eax, byte [rsi + 0]
   124 00005465 C1E008              <1>     shl eax, 8
   125 00005468 8A4601              <1>     mov al, [rsi + 1]
   126                              <1> 
   127                              <1>     ; Extract Destination Port (Big Endian -> Host Order)
   128 0000546B 0FB65E02            <1>     movzx ebx, byte [rsi + 2]
   129 0000546F C1E308              <1>     shl ebx, 8
   130 00005472 8A5E03              <1>     mov bl, [rsi + 3]
   131                              <1> 
   132                              <1>     ; Check if this is a DNS response destined for our query port (53530)
   133                              <1>     ; or originating from DNS server port 53
   134 00005475 81FB1AD10000        <1>     cmp ebx, UDP_SRC_PORT_DNS
   135 0000547B 7407                <1>     je .handle_dns
   136 0000547D 83F835              <1>     cmp eax, UDP_PORT_DNS
   137 00005480 7402                <1>     je .handle_dns
   138                              <1> 
   139 00005482 EB0D                <1>     jmp .done
   140                              <1> 
   141                              <1> .handle_dns:
   142                              <1>     ; Advance RSI to DNS payload (skip 8-byte UDP header)
   143 00005484 4883C608            <1>     add rsi, 8
   144 00005488 4883E908            <1>     sub rcx, 8
   145 0000548C E840010000          <1>     call dns_handle_response
   146                              <1> 
   147                              <1> .done:
   148 00005491 5F                  <1>     pop rdi
   149 00005492 5E                  <1>     pop rsi
   150 00005493 5A                  <1>     pop rdx
   151 00005494 59                  <1>     pop rcx
   152 00005495 5B                  <1>     pop rbx
   153 00005496 58                  <1>     pop rax
   154 00005497 C3                  <1>     ret
   155                              <1> 
   156                              <1> ; ------------------------------------------------------------------------------
   157                              <1> ; dns_encode_qname: Encodes ASCII domain (e.g. "google.com") into DNS QNAME format
   158                              <1> ; Input:
   159                              <1> ;   RSI = Pointer to null-terminated domain string
   160                              <1> ;   RDI = Destination buffer
   161                              <1> ; Output:
   162                              <1> ;   RDI = Advanced past terminating zero byte
   163                              <1> ;   RAX = Number of bytes written
   164                              <1> ; ------------------------------------------------------------------------------
   165                              <1> dns_encode_qname:
   166 00005498 53                  <1>     push rbx
   167 00005499 51                  <1>     push rcx
   168 0000549A 52                  <1>     push rdx
   169 0000549B 56                  <1>     push rsi
   170                              <1> 
   171 0000549C 4989F8              <1>     mov r8, rdi                 ; R8 = Start of output
   172 0000549F 31D2                <1>     xor edx, edx                ; EDX = Bytes written
   173                              <1> 
   174                              <1> .new_label:
   175 000054A1 4989F9              <1>     mov r9, rdi                 ; R9 = Pointer to label length byte
   176 000054A4 48FFC7              <1>     inc rdi                     ; Reserve byte for length
   177 000054A7 FFC2                <1>     inc edx
   178 000054A9 31C9                <1>     xor ecx, ecx                ; ECX = Label character count
   179                              <1> 
   180                              <1> .char_loop:
   181 000054AB AC                  <1>     lodsb                       ; AL = [RSI++]
   182 000054AC 84C0                <1>     test al, al
   183 000054AE 7410                <1>     jz .end_of_domain
   184 000054B0 3C2E                <1>     cmp al, '.'
   185 000054B2 7407                <1>     je .end_of_label
   186                              <1> 
   187 000054B4 AA                  <1>     stosb                       ; Store char into [RDI++]
   188 000054B5 FFC2                <1>     inc edx
   189 000054B7 FFC1                <1>     inc ecx
   190 000054B9 EBF0                <1>     jmp .char_loop
   191                              <1> 
   192                              <1> .end_of_label:
   193                              <1>     ; Write label length into length slot
   194 000054BB 418809              <1>     mov [r9], cl
   195 000054BE EBE1                <1>     jmp .new_label
   196                              <1> 
   197                              <1> .end_of_domain:
   198                              <1>     ; Write last label length
   199 000054C0 418809              <1>     mov [r9], cl
   200                              <1>     ; Write terminating zero byte
   201 000054C3 30C0                <1>     xor al, al
   202 000054C5 AA                  <1>     stosb
   203 000054C6 FFC2                <1>     inc edx
   204                              <1> 
   205 000054C8 89D0                <1>     mov eax, edx                ; RAX = Total bytes written
   206 000054CA 5E                  <1>     pop rsi
   207 000054CB 5A                  <1>     pop rdx
   208 000054CC 59                  <1>     pop rcx
   209 000054CD 5B                  <1>     pop rbx
   210 000054CE C3                  <1>     ret
   211                              <1> 
   212                              <1> ; ------------------------------------------------------------------------------
   213                              <1> ; dns_resolve: Resolves a domain name to an IPv4 address via DNS over UDP
   214                              <1> ; Input:
   215                              <1> ;   RSI = Pointer to null-terminated domain name (e.g. "google.com")
   216                              <1> ;   RDI = Pointer to 4-byte buffer to store resolved IPv4 address
   217                              <1> ; Output:
   218                              <1> ;   RAX = 0 on Success, 1 on Timeout / Failure
   219                              <1> ;   [RDI] = 4-byte resolved IP address
   220                              <1> ; ------------------------------------------------------------------------------
   221                              <1> dns_resolve:
   222 000054CF 53                  <1>     push rbx
   223 000054D0 51                  <1>     push rcx
   224 000054D1 52                  <1>     push rdx
   225 000054D2 56                  <1>     push rsi
   226 000054D3 57                  <1>     push rdi
   227 000054D4 4154                <1>     push r12
   228 000054D6 4155                <1>     push r13
   229 000054D8 4156                <1>     push r14
   230                              <1> 
   231 000054DA 4989F4              <1>     mov r12, rsi                ; R12 = Domain string
   232 000054DD 4989FD              <1>     mov r13, rdi                ; R13 = Output IP buffer
   233                              <1> 
   234                              <1>     ; Reset resolved state
   235 000054E0 C60580F6FFFF00      <1>     mov byte [dns_resolved_flag], 0
   236 000054E7 C70577F6FFFF000000- <1>     mov dword [dns_resolved_ip], 0
   236 000054F0 00                  <1>
   237                              <1> 
   238                              <1>     ; Increment query ID
   239 000054F1 66FF056DF6FFFF      <1>     inc word [dns_query_id]
   240                              <1> 
   241                              <1>     ; 1. Build DNS Query Header in dns_query_buf (12 bytes)
   242 000054F8 488D0551FCFFFF      <1>     lea rax, [dns_query_buf]
   243                              <1> 
   244                              <1>     ; Transaction ID (Big Endian)
   245 000054FF 668B1D5FF6FFFF      <1>     mov bx, [dns_query_id]
   246 00005506 8838                <1>     mov byte [rax + 0], bh
   247 00005508 885801              <1>     mov byte [rax + 1], bl
   248                              <1> 
   249                              <1>     ; Flags = 0x0100 (Standard Query, Recursion Desired)
   250 0000550B C6400201            <1>     mov byte [rax + 2], 0x01
   251 0000550F C6400300            <1>     mov byte [rax + 3], 0x00
   252                              <1> 
   253                              <1>     ; QDCOUNT = 1 (1 Question)
   254 00005513 C6400400            <1>     mov byte [rax + 4], 0x00
   255 00005517 C6400501            <1>     mov byte [rax + 5], 0x01
   256                              <1> 
   257                              <1>     ; ANCOUNT = 0
   258 0000551B C6400600            <1>     mov byte [rax + 6], 0x00
   259 0000551F C6400700            <1>     mov byte [rax + 7], 0x00
   260                              <1> 
   261                              <1>     ; NSCOUNT = 0
   262 00005523 C6400800            <1>     mov byte [rax + 8], 0x00
   263 00005527 C6400900            <1>     mov byte [rax + 9], 0x00
   264                              <1> 
   265                              <1>     ; ARCOUNT = 0
   266 0000552B C6400A00            <1>     mov byte [rax + 10], 0x00
   267 0000552F C6400B00            <1>     mov byte [rax + 11], 0x00
   268                              <1> 
   269                              <1>     ; 2. Build Question Section: QNAME
   270 00005533 488D3D22FCFFFF      <1>     lea rdi, [dns_query_buf + 12]
   271 0000553A 4C89E6              <1>     mov rsi, r12
   272 0000553D E856FFFFFF          <1>     call dns_encode_qname       ; Encodes domain, returns RAX = length, RDI advanced
   273                              <1> 
   274                              <1>     ; Append QTYPE = 0x0001 (Type A: IPv4 Address)
   275 00005542 C60700              <1>     mov byte [rdi + 0], 0x00
   276 00005545 C6470101            <1>     mov byte [rdi + 1], 0x01
   277                              <1> 
   278                              <1>     ; Append QCLASS = 0x0001 (Class IN: Internet)
   279 00005549 C6470200            <1>     mov byte [rdi + 2], 0x00
   280 0000554D C6470301            <1>     mov byte [rdi + 3], 0x01
   281 00005551 4883C704            <1>     add rdi, 4
   282                              <1> 
   283                              <1>     ; Calculate total DNS query length: RDI - dns_query_buf
   284 00005555 488D1DF4FBFFFF      <1>     lea rbx, [dns_query_buf]
   285 0000555C 4829DF              <1>     sub rdi, rbx
   286 0000555F 4889F9              <1>     mov rcx, rdi                ; RCX = Query length
   287                              <1> 
   288                              <1>     ; 3. Send DNS Query via UDP to net_dns (10.0.2.3) on port 53
   289 00005562 488D35E7FBFFFF      <1>     lea rsi, [dns_query_buf]
   290 00005569 488D3DC4DFFFFF      <1>     lea rdi, [net_dns]
   291 00005570 66BA1AD1            <1>     mov dx, UDP_SRC_PORT_DNS    ; Source port 53530
   292 00005574 6641B83500          <1>     mov r8w, UDP_PORT_DNS       ; Destination port 53
   293 00005579 E863FEFFFF          <1>     call udp_send_packet
   294                              <1> 
   295                              <1>     ; 4. Poll for response with timeout (~2.5 sec = 45 ticks)
   296 0000557E 488B05ADBFFFFF      <1>     mov rax, [timer_ticks]
   297 00005585 4883C02D            <1>     add rax, 45
   298 00005589 4989C6              <1>     mov r14, rax
   299                              <1> .poll_loop:
   300 0000558C E8B1DEFFFF          <1>     call net_poll
   301                              <1> 
   302 00005591 803DCFF5FFFF01      <1>     cmp byte [dns_resolved_flag], 1
   303 00005598 741E                <1>     je .success
   304                              <1> 
   305                              <1>     ; Tiny spin delay
   306 0000559A B9D0070000          <1>     mov ecx, 2000
   307                              <1> .spin:
   308 0000559F F390                <1>     pause
   309 000055A1 FFC9                <1>     dec ecx
   310 000055A3 75FA                <1>     jnz .spin
   311                              <1> 
   312 000055A5 488B0586BFFFFF      <1>     mov rax, [timer_ticks]
   313 000055AC 4C39F0              <1>     cmp rax, r14
   314 000055AF 72DB                <1>     jb .poll_loop
   315                              <1> 
   316                              <1>     ; Timeout!
   317 000055B1 B801000000          <1>     mov rax, 1
   318 000055B6 EB0D                <1>     jmp .exit
   319                              <1> 
   320                              <1> .success:
   321                              <1>     ; Copy resolved IP (4 bytes) to user buffer at [R13]
   322 000055B8 8B05AAF5FFFF        <1>     mov eax, [dns_resolved_ip]
   323 000055BE 41894500            <1>     mov [r13], eax
   324 000055C2 4831C0              <1>     xor rax, rax                ; Success = 0
   325                              <1> 
   326                              <1> .exit:
   327 000055C5 415E                <1>     pop r14
   328 000055C7 415D                <1>     pop r13
   329 000055C9 415C                <1>     pop r12
   330 000055CB 5F                  <1>     pop rdi
   331 000055CC 5E                  <1>     pop rsi
   332 000055CD 5A                  <1>     pop rdx
   333 000055CE 59                  <1>     pop rcx
   334 000055CF 5B                  <1>     pop rbx
   335 000055D0 C3                  <1>     ret
   336                              <1> 
   337                              <1> ; ------------------------------------------------------------------------------
   338                              <1> ; dns_handle_response: Decodes incoming DNS response packet
   339                              <1> ; Input:
   340                              <1> ;   RSI = Pointer to DNS response payload
   341                              <1> ;   RCX = Length of DNS response
   342                              <1> ; ------------------------------------------------------------------------------
   343                              <1> dns_handle_response:
   344 000055D1 50                  <1>     push rax
   345 000055D2 53                  <1>     push rbx
   346 000055D3 51                  <1>     push rcx
   347 000055D4 52                  <1>     push rdx
   348 000055D5 56                  <1>     push rsi
   349 000055D6 57                  <1>     push rdi
   350 000055D7 4150                <1>     push r8
   351 000055D9 4151                <1>     push r9
   352 000055DB 4152                <1>     push r10
   353                              <1> 
   354                              <1>     ; DNS header is at least 12 bytes
   355 000055DD 4883F90C            <1>     cmp rcx, 12
   356 000055E1 0F8234010000        <1>     jb .drop
   357                              <1> 
   358                              <1>     ; Check Transaction ID
   359 000055E7 8A06                <1>     mov al, [rsi + 0]
   360 000055E9 8A6601              <1>     mov ah, [rsi + 1]
   361 000055EC 86C4                <1>     xchg al, ah
   362 000055EE 663B0570F5FFFF      <1>     cmp ax, [dns_query_id]
   363 000055F5 0F8520010000        <1>     jne .drop
   364                              <1> 
   365                              <1>     ; Check QR bit (Bit 15 must be 1 = Response)
   366 000055FB F6460280            <1>     test byte [rsi + 2], 0x80
   367 000055FF 0F8416010000        <1>     jz .drop
   368                              <1> 
   369                              <1>     ; Check RCODE (Bits 3-0 of byte 3 must be 0 = No Error)
   370 00005605 8A4603              <1>     mov al, [rsi + 3]
   371 00005608 240F                <1>     and al, 0x0F
   372 0000560A 0F850B010000        <1>     jnz .drop                   ; Error (NXDOMAIN, ServFail, etc.)
   373                              <1> 
   374                              <1>     ; Extract Answer Count ANCOUNT (bytes 6-7, Big Endian)
   375 00005610 440FB65606          <1>     movzx r10d, byte [rsi + 6]
   376 00005615 41C1E208            <1>     shl r10d, 8
   377 00005619 448A5607            <1>     mov r10b, [rsi + 7]
   378 0000561D 4585D2              <1>     test r10d, r10d
   379 00005620 0F84F5000000        <1>     jz .drop                    ; 0 answers
   380                              <1> 
   381                              <1>     ; Advance past 12-byte header
   382 00005626 4883C60C            <1>     add rsi, 12
   383 0000562A 4883E90C            <1>     sub rcx, 12
   384                              <1> 
   385                              <1>     ; Skip Question Section: QNAME
   386                              <1> .skip_qname:
   387 0000562E 4883F901            <1>     cmp rcx, 1
   388 00005632 0F82E3000000        <1>     jb .drop
   389 00005638 0FB606              <1>     movzx eax, byte [rsi]
   390 0000563B 84C0                <1>     test al, al
   391 0000563D 742B                <1>     jz .end_qname
   392                              <1>     ; Check if compressed pointer (high 2 bits = 11)
   393 0000563F 3CC0                <1>     cmp al, 0xC0
   394 00005641 7313                <1>     jae .skip_ptr
   395                              <1> 
   396                              <1>     ; Normal label: advance by (len + 1)
   397 00005643 FFC0                <1>     inc eax
   398 00005645 4839C1              <1>     cmp rcx, rax
   399 00005648 0F82CD000000        <1>     jb .drop
   400 0000564E 4801C6              <1>     add rsi, rax
   401 00005651 4829C1              <1>     sub rcx, rax
   402 00005654 EBD8                <1>     jmp .skip_qname
   403                              <1> 
   404                              <1> .skip_ptr:
   405 00005656 4883F902            <1>     cmp rcx, 2
   406 0000565A 0F82BB000000        <1>     jb .drop
   407 00005660 4883C602            <1>     add rsi, 2
   408 00005664 4883E902            <1>     sub rcx, 2
   409 00005668 EB06                <1>     jmp .skip_qtype
   410                              <1> 
   411                              <1> .end_qname:
   412 0000566A 48FFC6              <1>     inc rsi
   413 0000566D 48FFC9              <1>     dec rcx
   414                              <1> 
   415                              <1> .skip_qtype:
   416                              <1>     ; Skip QTYPE (2 bytes) + QCLASS (2 bytes) = 4 bytes
   417 00005670 4883F904            <1>     cmp rcx, 4
   418 00005674 0F82A1000000        <1>     jb .drop
   419 0000567A 4883C604            <1>     add rsi, 4
   420 0000567E 4883E904            <1>     sub rcx, 4
   421                              <1> 
   422                              <1>     ; Parse Answer Section (up to R10 answers)
   423                              <1> .parse_answers:
   424 00005682 4585D2              <1>     test r10d, r10d
   425 00005685 0F8490000000        <1>     jz .drop
   426                              <1> 
   427                              <1>     ; Parse Name (compressed pointer or label sequence)
   428 0000568B 4883F902            <1>     cmp rcx, 2
   429 0000568F 0F8286000000        <1>     jb .drop
   430 00005695 8A06                <1>     mov al, [rsi]
   431 00005697 3CC0                <1>     cmp al, 0xC0
   432 00005699 731E                <1>     jae .ans_ptr
   433                              <1> 
   434                              <1>     ; Label sequence
   435                              <1> .ans_label:
   436 0000569B 0FB606              <1>     movzx eax, byte [rsi]
   437 0000569E 84C0                <1>     test al, al
   438 000056A0 740F                <1>     jz .ans_label_end
   439 000056A2 FFC0                <1>     inc eax
   440 000056A4 4839C1              <1>     cmp rcx, rax
   441 000056A7 7272                <1>     jb .drop
   442 000056A9 4801C6              <1>     add rsi, rax
   443 000056AC 4829C1              <1>     sub rcx, rax
   444 000056AF EBEA                <1>     jmp .ans_label
   445                              <1> 
   446                              <1> .ans_label_end:
   447 000056B1 48FFC6              <1>     inc rsi
   448 000056B4 48FFC9              <1>     dec rcx
   449 000056B7 EB08                <1>     jmp .check_rr
   450                              <1> 
   451                              <1> .ans_ptr:
   452 000056B9 4883C602            <1>     add rsi, 2
   453 000056BD 4883E902            <1>     sub rcx, 2
   454                              <1> 
   455                              <1> .check_rr:
   456                              <1>     ; Standard Resource Record Header:
   457                              <1>     ; TYPE (2 bytes) + CLASS (2 bytes) + TTL (4 bytes) + RDLENGTH (2 bytes) = 10 bytes
   458 000056C1 4883F90A            <1>     cmp rcx, 10
   459 000056C5 7254                <1>     jb .drop
   460                              <1> 
   461                              <1>     ; Read TYPE (Big Endian)
   462 000056C7 0FB606              <1>     movzx eax, byte [rsi + 0]
   463 000056CA C1E008              <1>     shl eax, 8
   464 000056CD 8A4601              <1>     mov al, [rsi + 1]
   465                              <1> 
   466                              <1>     ; Read RDLENGTH (Big Endian)
   467 000056D0 440FB64E08          <1>     movzx r9d, byte [rsi + 8]
   468 000056D5 41C1E108            <1>     shl r9d, 8
   469 000056D9 448A4E09            <1>     mov r9b, [rsi + 9]
   470                              <1> 
   471                              <1>     ; Advance past RR header (10 bytes)
   472 000056DD 4883C60A            <1>     add rsi, 10
   473 000056E1 4883E90A            <1>     sub rcx, 10
   474                              <1> 
   475                              <1>     ; Check if TYPE == 1 (Type A: IPv4) and RDLENGTH == 4
   476 000056E5 6683F801            <1>     cmp ax, 1
   477 000056E9 751D                <1>     jne .skip_rdata
   478                              <1> 
   479 000056EB 4183F904            <1>     cmp r9d, 4
   480 000056EF 7517                <1>     jne .skip_rdata
   481                              <1> 
   482                              <1>     ; Found IPv4 Address! Copy 4 bytes into dns_resolved_ip
   483 000056F1 4883F904            <1>     cmp rcx, 4
   484 000056F5 7224                <1>     jb .drop
   485 000056F7 8B06                <1>     mov eax, [rsi]
   486 000056F9 890569F4FFFF        <1>     mov [dns_resolved_ip], eax
   487 000056FF C60561F4FFFF01      <1>     mov byte [dns_resolved_flag], 1
   488 00005706 EB13                <1>     jmp .drop                   ; Successfully captured!
   489                              <1> 
   490                              <1> .skip_rdata:
   491                              <1>     ; Skip RDATA of length R9D
   492 00005708 4C39C9              <1>     cmp rcx, r9
   493 0000570B 720E                <1>     jb .drop
   494 0000570D 4C01CE              <1>     add rsi, r9
   495 00005710 4C29C9              <1>     sub rcx, r9
   496 00005713 41FFCA              <1>     dec r10d
   497 00005716 E967FFFFFF          <1>     jmp .parse_answers
   498                              <1> 
   499                              <1> .drop:
   500 0000571B 415A                <1>     pop r10
   501 0000571D 4159                <1>     pop r9
   502 0000571F 4158                <1>     pop r8
   503 00005721 5F                  <1>     pop rdi
   504 00005722 5E                  <1>     pop rsi
   505 00005723 5A                  <1>     pop rdx
   506 00005724 59                  <1>     pop rcx
   507 00005725 5B                  <1>     pop rbx
   508 00005726 58                  <1>     pop rax
   509 00005727 C3                  <1>     ret
