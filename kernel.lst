   232 0000908B E82EFDFFFF          <1>     call gfx_restore_cursor
   233 00009090 8B05E0EEFFFF        <1>     mov eax, [mouse_x]
   234 00009096 8B15DEEEFFFF        <1>     mov edx, [mouse_y]
