   414 00002398 7605                <1>     jbe .do_copy
   415 0000239A B900020000          <1>     mov rcx, 512                ; Clamp to 512 bytes
   416                              <1> .do_copy:
   417 0000239F F3A4                <1>     rep movsb
   418                              <1> 
   419                              <1>     ; Write sector to disk
