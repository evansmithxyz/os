   527 00004001 5F                  <1>     pop rdi
   528 00004002 5E                  <1>     pop rsi
   529 00004003 5A                  <1>     pop rdx
   530 00004004 59                  <1>     pop rcx
   531 00004005 5B                  <1>     pop rbx
