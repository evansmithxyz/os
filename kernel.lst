   219 0000253E 5A                  <1>     pop rdx
   220 0000253F 59                  <1>     pop rcx
   221 00002540 5B                  <1>     pop rbx
   222 00002541 C3                  <1>     ret
   124                                  %include "net.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit Realtek RTL8139 Fast Ethernet Controller Driver
     3                              <1> ; Hardware Packet Transmission and Reception via I/O Port Ring Buffers
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ; Physical Memory Buffers for RTL8139 DMA (within identity-mapped 0-8 MB)
     9                              <1> RTL_RX_BUFFER_PHYS  equ 0x00030000      ; 8KB + 16 bytes RX Ring Buffer
    10                              <1> RTL_TX_BUFFER_PHYS  equ 0x00034000      ; 1.5 KB TX Buffer
    11                              <1> 
    12                              <1> ; RTL8139 Register Offsets (relative to net_io_base)
    13                              <1> RTL_REG_MAC0        equ 0x00            ; IDR0-5 (MAC Address 6 bytes)
    14                              <1> RTL_REG_TSD0        equ 0x10            ; Transmit Status of Descriptor 0
    15                              <1> RTL_REG_TSAD0       equ 0x20            ; Transmit Start Address of Descriptor 0
    16                              <1> RTL_REG_RBSTART     equ 0x30            ; Receive Buffer Start Address
    17                              <1> RTL_REG_CR          equ 0x37            ; Command Register
    18                              <1> RTL_REG_CAPR        equ 0x38            ; Current Address of Packet Read
    19                              <1> RTL_REG_CBR         equ 0x3A            ; Current Buffer Address
    20                              <1> RTL_REG_IMR         equ 0x3C            ; Interrupt Mask Register
    21                              <1> RTL_REG_ISR         equ 0x3E            ; Interrupt Status Register
    22                              <1> RTL_REG_RCR         equ 0x44            ; Receive Configuration Register
    23                              <1> RTL_REG_CONFIG1     equ 0x52            ; Configuration Register 1
    24                              <1> 
    25                              <1> ; Command Register Bits
    26                              <1> RTL_CR_BUFE         equ 0x01            ; Buffer Empty
    27                              <1> RTL_CR_TE           equ 0x04            ; Transmitter Enable
    28                              <1> RTL_CR_RE           equ 0x08            ; Receiver Enable
    29                              <1> RTL_CR_RST          equ 0x10            ; Software Reset
    30                              <1> 
    31                              <1> ; Driver State Variables
    32 00002542 00                  <1> net_present:        db 0
    33 00002543 0000                <1> net_io_base:        dw 0
    34 00002545 0000                <1> net_rx_offset:      dw 0
    35 00002547 00                  <1> net_tx_cur:         db 0
    36                              <1> 
    37                              <1> ; Hardware MAC Address
    38 00002548 525400123456        <1> net_mac:            db 0x52, 0x54, 0x00, 0x12, 0x34, 0x56
    39                              <1> 
    40                              <1> ; Statistics
    41 0000254E 0000000000000000    <1> net_packets_rx:     dq 0
    42 00002556 0000000000000000    <1> net_packets_tx:     dq 0
    43 0000255E 0000000000000000    <1> net_bytes_rx:       dq 0
    44 00002566 0000000000000000    <1> net_bytes_tx:       dq 0
    45                              <1> 
    46                              <1> ; Packet Scratch Buffers
    47 0000256E 90<rep 2h>          <1> align 16
    48 00002570 00<rep 640h>        <1> net_tx_buf:         times 1600 db 0
    49                              <1> align 16
    50 00002BB0 00<rep 640h>        <1> net_rx_buf:         times 1600 db 0
    51                              <1> 
    52                              <1> ; Messages
    53 000031F0 5B4E45545D2052544C- <1> MSG_NET_FOUND:      db "[NET] RTL8139 NIC detected at I/O port 0x", 0
    53 000031F9 38313339204E494320- <1>
    53 00003202 646574656374656420- <1>
    53 0000320B 617420492F4F20706F- <1>
    53 00003214 727420307800        <1>
    54 0000321A 205B4D41433A2000    <1> MSG_NET_MAC:        db " [MAC: ", 0
    55 00003222 5B4E45545D204E6F74- <1> MSG_NET_NOT_FOUND:  db "[NET] Notice: RTL8139 PCI NIC not detected.", 0x0A, 0
    55 0000322B 6963653A2052544C38- <1>
    55 00003234 31333920504349204E- <1>
    55 0000323D 4943206E6F74206465- <1>
    55 00003246 7465637465642E0A00  <1>
    56                              <1> 
    57                              <1> ; ------------------------------------------------------------------------------
    58                              <1> ; net_init: Discovers, resets, and configures RTL8139 Network Card
    59                              <1> ; ------------------------------------------------------------------------------
    60                              <1> net_init:
    61 0000324F 50                  <1>     push rax
    62 00003250 53                  <1>     push rbx
    63 00003251 51                  <1>     push rcx
    64 00003252 52                  <1>     push rdx
    65 00003253 56                  <1>     push rsi
    66 00003254 57                  <1>     push rdi
    67                              <1> 
    68                              <1>     ; Find RTL8139 on PCI Bus: Vendor 0x10EC, Device 0x8139
    69 00003255 66BEEC10            <1>     mov si, 0x10EC
    70 00003259 66BF3981            <1>     mov di, 0x8139
    71 0000325D E80FF2FFFF          <1>     call pci_find_device
    72 00003262 0F8510010000        <1>     jnz .not_found
    73                              <1> 
    74                              <1>     ; EAX = bus, EBX = slot, ECX = func
    75                              <1>     ; Enable Bus Mastering & I/O Space in PCI Command Register
    76 00003268 E873F2FFFF          <1>     call pci_enable_bus_master
    77                              <1> 
    78                              <1>     ; Get Base I/O Port from BAR0
    79 0000326D E8BCF2FFFF          <1>     call pci_get_bar0_io
    80 00003272 668905CAF2FFFF      <1>     mov [net_io_base], ax
    81                              <1> 
    82                              <1>     ; Power on the NIC (Wakeup via CONFIG1 = 0x00)
    83 00003279 668B15C3F2FFFF      <1>     mov dx, [net_io_base]
    84 00003280 6683C252            <1>     add dx, RTL_REG_CONFIG1
    85 00003284 30C0                <1>     xor al, al
    86 00003286 EE                  <1>     out dx, al
    87                              <1> 
    88                              <1>     ; Software Reset: Set bit 4 (RST) in CR
    89 00003287 668B15B5F2FFFF      <1>     mov dx, [net_io_base]
    90 0000328E 6683C237            <1>     add dx, RTL_REG_CR
    91 00003292 B010                <1>     mov al, RTL_CR_RST
    92 00003294 EE                  <1>     out dx, al
    93                              <1> 
    94                              <1>     ; Poll until reset bit clears
    95                              <1> .wait_reset:
    96 00003295 EC                  <1>     in al, dx
    97 00003296 A810                <1>     test al, RTL_CR_RST
    98 00003298 75FB                <1>     jnz .wait_reset
    99                              <1> 
   100                              <1>     ; Clear Receive Buffer Memory (8KB + 16 bytes)
   101 0000329A BF00000300          <1>     mov rdi, RTL_RX_BUFFER_PHYS
   102 0000329F B910200000          <1>     mov ecx, 8192 + 16
   103 000032A4 31C0                <1>     xor eax, eax
   104 000032A6 F3AA                <1>     rep stosb
   105                              <1> 
   106                              <1>     ; Configure Receive Buffer Address (RBSTART = RTL_RX_BUFFER_PHYS)
   107 000032A8 668B1594F2FFFF      <1>     mov dx, [net_io_base]
   108 000032AF 6683C230            <1>     add dx, RTL_REG_RBSTART
   109 000032B3 B800000300          <1>     mov eax, RTL_RX_BUFFER_PHYS
   110 000032B8 EF                  <1>     out dx, eax
   111                              <1> 
   112                              <1>     ; Set CAPR to 0xFFF0 (-16 bytes read pointer offset)
   113 000032B9 668B1583F2FFFF      <1>     mov dx, [net_io_base]
   114 000032C0 6683C238            <1>     add dx, RTL_REG_CAPR
   115 000032C4 66B8F0FF            <1>     mov ax, 0xFFF0
   116 000032C8 66EF                <1>     out dx, ax
   117 000032CA 66C70572F2FFFF0000  <1>     mov word [net_rx_offset], 0
   118                              <1> 
   119                              <1>     ; Configure Interrupt Mask Register (IMR = 0x0005: ROK | TOK)
   120 000032D3 668B1569F2FFFF      <1>     mov dx, [net_io_base]
   121 000032DA 6683C23C            <1>     add dx, RTL_REG_IMR
   122 000032DE 66B80500            <1>     mov ax, 0x0005
   123 000032E2 66EF                <1>     out dx, ax
   124                              <1> 
   125                              <1>     ; Configure Receive Configuration Register (RCR):
   126                              <1>     ; Accept: Broadcast (bit 3) + Multicast (bit 2) + Physical match (bit 1) + All physical (bit 0) = 0x0F
   127                              <1>     ; Wrap bit 7 = 1 (wrap buffer at 8KB) -> 0x8F
   128 000032E4 668B1558F2FFFF      <1>     mov dx, [net_io_base]
   129 000032EB 6683C244            <1>     add dx, RTL_REG_RCR
   130 000032EF B88F000000          <1>     mov eax, 0x0000008F
