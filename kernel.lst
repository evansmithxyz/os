   463                              <1> 
   464                              <1>     ; Search local ARP cache
   465 00003F70 31C9                <1>     xor ecx, ecx
   466                              <1> .cache_search:
   467 00003F72 80B9[94350000]01    <1>     cmp byte [arp_cache_valid + rcx], 1
   468 00003F79 7509                <1>     jne .cache_next
   469 00003F7B 39048D[44350000]    <1>     cmp [arp_cache_ip + rcx * 4], eax
   470 00003F82 7464                <1>     je .cache_hit
   471                              <1> .cache_next:
   472 00003F84 FFC1                <1>     inc ecx
