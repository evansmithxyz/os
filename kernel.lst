  1675 0000C45E 50                  <1>     push rax
  1676 0000C45F 53                  <1>     push rbx
  1677 0000C460 51                  <1>     push rcx
  1678 0000C461 52                  <1>     push rdx
  1679 0000C462 56                  <1>     push rsi
  1680 0000C463 57                  <1>     push rdi
  1681 0000C464 4150                <1>     push r8
  1682 0000C466 4151                <1>     push r9
  1683 0000C468 4152                <1>     push r10
  1684 0000C46A 4153                <1>     push r11
  1685 0000C46C 4154                <1>     push r12
