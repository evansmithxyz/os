   117                                  %include "vga.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit VGA 80x25 Color Text Mode Driver
     3                              <1> ; Manages Video RAM at 0x000B8000, hardware cursor, 64-bit hex/dec formatting
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> VGA_BUFFER      equ 0x000B8000
     9                              <1> VGA_COLS        equ 80
    10                              <1> VGA_ROWS        equ 25
    11                              <1> VGA_CELLS       equ VGA_COLS * VGA_ROWS
    12                              <1> 
    13                              <1> ; Color Codes
    14                              <1> COLOR_BLACK         equ 0x00
    15                              <1> COLOR_BLUE          equ 0x01
    16                              <1> COLOR_GREEN         equ 0x02
    17                              <1> COLOR_CYAN          equ 0x03
    18                              <1> COLOR_RED           equ 0x04
    19                              <1> COLOR_MAGENTA       equ 0x05
    20                              <1> COLOR_BROWN         equ 0x06
    21                              <1> COLOR_LIGHT_GRAY    equ 0x07
    22                              <1> COLOR_DARK_GRAY     equ 0x08
    23                              <1> COLOR_LIGHT_BLUE    equ 0x09
    24                              <1> COLOR_LIGHT_GREEN   equ 0x0A
    25                              <1> COLOR_LIGHT_CYAN    equ 0x0B
    26                              <1> COLOR_LIGHT_RED     equ 0x0C
    27                              <1> COLOR_LIGHT_MAGENTA equ 0x0D
    28                              <1> COLOR_YELLOW        equ 0x0E
    29                              <1> COLOR_WHITE         equ 0x0F
    30                              <1> 
    31                              <1> ; VGA I/O Ports
    32                              <1> VGA_PORT_INDEX      equ 0x3D4
    33                              <1> VGA_PORT_DATA       equ 0x3D5
    34                              <1> 
    35 0000010B 00                  <1> cursor_row:         db 0
    36 0000010C 00                  <1> cursor_col:         db 0
    37 0000010D 0F                  <1> current_attr:       db 0x0F     ; Default: White on Black
    38 0000010E 307830303030303030- <1> hex64_buffer:       db "0x0000000000000000", 0
    38 00000117 303030303030303030- <1>
    38 00000120 00                  <1>
    39 00000121 307830303030303030- <1> hex32_buffer:       db "0x00000000", 0
    39 0000012A 3000                <1>
    40 0000012C 00<rep 18h>         <1> dec_buffer:         times 24 db 0
    41                              <1> 
    42                              <1> ; ------------------------------------------------------------------------------
    43                              <1> ; vga_clear_screen: Clears the entire text display with the current attribute
    44                              <1> ; ------------------------------------------------------------------------------
    45                              <1> vga_clear_screen:
    46 00000144 50                  <1>     push rax
    47 00000145 51                  <1>     push rcx
    48 00000146 57                  <1>     push rdi
    49                              <1> 
    50 00000147 BF00800B00          <1>     mov rdi, VGA_BUFFER
    51 0000014C B9D0070000          <1>     mov rcx, VGA_CELLS
    52 00000151 8A25B6FFFFFF        <1>     mov ah, [current_attr]
    53 00000157 B020                <1>     mov al, ' '
    54 00000159 66F3AB              <1>     rep stosw
    55                              <1> 
    56 0000015C C605A8FFFFFF00      <1>     mov byte [cursor_row], 0
    57 00000163 C605A2FFFFFF00      <1>     mov byte [cursor_col], 0
    58 0000016A E806010000          <1>     call vga_update_cursor
    59                              <1> 
    60 0000016F 5F                  <1>     pop rdi
    61 00000170 59                  <1>     pop rcx
    62 00000171 58                  <1>     pop rax
    63 00000172 C3                  <1>     ret
    64                              <1> 
    65                              <1> ; ------------------------------------------------------------------------------
    66                              <1> ; vga_print_char: Prints character in AL to screen at current cursor position
    67                              <1> ; Handles: '\n' (0x0A), '\r' (0x0D), '\b' (0x08)
    68                              <1> ; ------------------------------------------------------------------------------
    69                              <1> vga_print_char:
    70 00000173 50                  <1>     push rax
    71 00000174 53                  <1>     push rbx
    72 00000175 51                  <1>     push rcx
    73 00000176 52                  <1>     push rdx
    74 00000177 57                  <1>     push rdi
    75                              <1> 
    76 00000178 3C0A                <1>     cmp al, 0x0A                ; Line Feed
    77 0000017A 7451                <1>     je .newline
    78 0000017C 3C0D                <1>     cmp al, 0x0D                ; Carriage Return
    79 0000017E 745C                <1>     je .carriagereturn
    80 00000180 3C08                <1>     cmp al, 0x08                ; Backspace
    81 00000182 7461                <1>     je .backspace
    82                              <1> 
    83                              <1>     ; Normal printable character
    84 00000184 480FB60D7FFFFFFF    <1>     movzx rcx, byte [cursor_row]
    85 0000018C 486BC950            <1>     imul rcx, VGA_COLS
    86 00000190 480FB61574FFFFFF    <1>     movzx rdx, byte [cursor_col]
    87 00000198 4801D1              <1>     add rcx, rdx
    88 0000019B 48D1E1              <1>     shl rcx, 1                  ; 2 bytes per cell
    89                              <1> 
    90 0000019E BF00800B00          <1>     mov rdi, VGA_BUFFER
    91 000001A3 4801CF              <1>     add rdi, rcx
    92 000001A6 8A2561FFFFFF        <1>     mov ah, [current_attr]
    93 000001AC 668907              <1>     mov [rdi], ax
    94                              <1> 
    95                              <1>     ; Advance cursor
    96 000001AF FE0557FFFFFF        <1>     inc byte [cursor_col]
    97 000001B5 803D50FFFFFF50      <1>     cmp byte [cursor_col], VGA_COLS
    98 000001BC 7C74                <1>     jl .done
    99 000001BE C60547FFFFFF00      <1>     mov byte [cursor_col], 0
   100 000001C5 FE0540FFFFFF        <1>     inc byte [cursor_row]
   101 000001CB EB57                <1>     jmp .check_scroll
   102                              <1> 
   103                              <1> .newline:
   104 000001CD C60538FFFFFF00      <1>     mov byte [cursor_col], 0
   105 000001D4 FE0531FFFFFF        <1>     inc byte [cursor_row]
   106 000001DA EB48                <1>     jmp .check_scroll
   107                              <1> 
   108                              <1> .carriagereturn:
   109 000001DC C60529FFFFFF00      <1>     mov byte [cursor_col], 0
   110 000001E3 EB4D                <1>     jmp .done
   111                              <1> 
   112                              <1> .backspace:
   113 000001E5 803D20FFFFFF00      <1>     cmp byte [cursor_col], 0
   114 000001EC 7444                <1>     je .done                    ; Cannot backspace past left edge
   115 000001EE FE0D18FFFFFF        <1>     dec byte [cursor_col]
   116                              <1> 
   117 000001F4 480FB60D0FFFFFFF    <1>     movzx rcx, byte [cursor_row]
   118 000001FC 486BC950            <1>     imul rcx, VGA_COLS
   119 00000200 480FB61504FFFFFF    <1>     movzx rdx, byte [cursor_col]
   120 00000208 4801D1              <1>     add rcx, rdx
   121 0000020B 48D1E1              <1>     shl rcx, 1
   122 0000020E BF00800B00          <1>     mov rdi, VGA_BUFFER
   123 00000213 4801CF              <1>     add rdi, rcx
   124 00000216 C60720              <1>     mov byte [rdi], ' '
   125 00000219 8A05EEFEFFFF        <1>     mov al, [current_attr]
   126 0000021F 884701              <1>     mov byte [rdi+1], al
   127 00000222 EB0E                <1>     jmp .done
   128                              <1> 
   129                              <1> .check_scroll:
   130 00000224 803DE0FEFFFF19      <1>     cmp byte [cursor_row], VGA_ROWS
   131 0000022B 7C05                <1>     jl .done
   132 0000022D E80B000000          <1>     call vga_scroll
   133                              <1> 
   134                              <1> .done:
   135 00000232 E83E000000          <1>     call vga_update_cursor
   136 00000237 5F                  <1>     pop rdi
   137 00000238 5A                  <1>     pop rdx
   138 00000239 59                  <1>     pop rcx
   139 0000023A 5B                  <1>     pop rbx
   140 0000023B 58                  <1>     pop rax
   141 0000023C C3                  <1>     ret
   142                              <1> 
   143                              <1> ; ------------------------------------------------------------------------------
   144                              <1> ; vga_scroll: Scrolls screen content up by 1 row when bottom is reached
   145                              <1> ; ------------------------------------------------------------------------------
   146                              <1> vga_scroll:
   147 0000023D 50                  <1>     push rax
   148 0000023E 51                  <1>     push rcx
   149 0000023F 57                  <1>     push rdi
   150 00000240 56                  <1>     push rsi
   151 00000241 FC                  <1>     cld
   152                              <1> 
   153 00000242 BF00800B00          <1>     mov rdi, VGA_BUFFER
   154 00000247 BEA0800B00          <1>     mov rsi, VGA_BUFFER + (VGA_COLS * 2)
   155 0000024C B980070000          <1>     mov rcx, (VGA_ROWS - 1) * VGA_COLS
   156 00000251 66F3A5              <1>     rep movsw
   157                              <1> 
   158 00000254 BF008F0B00          <1>     mov rdi, VGA_BUFFER + ((VGA_ROWS - 1) * VGA_COLS * 2)
   159 00000259 B950000000          <1>     mov rcx, VGA_COLS
   160 0000025E 8A25A9FEFFFF        <1>     mov ah, [current_attr]
   161 00000264 B020                <1>     mov al, ' '
   162 00000266 66F3AB              <1>     rep stosw
   163                              <1> 
   164 00000269 C6059BFEFFFF18      <1>     mov byte [cursor_row], VGA_ROWS - 1
   165 00000270 5E                  <1>     pop rsi
   166 00000271 5F                  <1>     pop rdi
   167 00000272 59                  <1>     pop rcx
   168 00000273 58                  <1>     pop rax
   169 00000274 C3                  <1>     ret
   170                              <1> 
   171                              <1> ; ------------------------------------------------------------------------------
   172                              <1> ; vga_update_cursor: Updates hardware text cursor position via CRT controller
   173                              <1> ; ------------------------------------------------------------------------------
   174                              <1> vga_update_cursor:
   175 00000275 50                  <1>     push rax
   176 00000276 51                  <1>     push rcx
   177 00000277 52                  <1>     push rdx
   178                              <1> 
   179 00000278 480FB60D8BFEFFFF    <1>     movzx rcx, byte [cursor_row]
   180 00000280 486BC950            <1>     imul rcx, VGA_COLS
   181 00000284 480FB61580FEFFFF    <1>     movzx rdx, byte [cursor_col]
   182 0000028C 4801D1              <1>     add rcx, rdx                ; RCX = position (0 .. 1999)
   183                              <1> 
   184                              <1>     ; Low byte to port 0x3D4/0x3D5
   185 0000028F 66BAD403            <1>     mov dx, VGA_PORT_INDEX
   186 00000293 B00F                <1>     mov al, 0x0F
   187 00000295 EE                  <1>     out dx, al
   188 00000296 66FFC2              <1>     inc dx
   189 00000299 88C8                <1>     mov al, cl
   190 0000029B EE                  <1>     out dx, al
   191                              <1> 
   192                              <1>     ; High byte to port 0x3D4/0x3D5
   193 0000029C 66FFCA              <1>     dec dx
   194 0000029F B00E                <1>     mov al, 0x0E
   195 000002A1 EE                  <1>     out dx, al
   196 000002A2 66FFC2              <1>     inc dx
   197 000002A5 88E8                <1>     mov al, ch
   198 000002A7 EE                  <1>     out dx, al
   199                              <1> 
   200 000002A8 5A                  <1>     pop rdx
   201 000002A9 59                  <1>     pop rcx
   202 000002AA 58                  <1>     pop rax
   203 000002AB C3                  <1>     ret
   204                              <1> 
   205                              <1> ; ------------------------------------------------------------------------------
   206                              <1> ; vga_print_string: Prints null-terminated string at RSI with current attribute
   207                              <1> ; ------------------------------------------------------------------------------
   208                              <1> vga_print_string:
   209 000002AC 50                  <1>     push rax
   210 000002AD 56                  <1>     push rsi
   211                              <1> .loop:
   212 000002AE AC                  <1>     lodsb
   213 000002AF 84C0                <1>     test al, al
   214 000002B1 7407                <1>     jz .done
   215 000002B3 E8BBFEFFFF          <1>     call vga_print_char
   216 000002B8 EBF4                <1>     jmp .loop
   217                              <1> .done:
   218 000002BA 5E                  <1>     pop rsi
   219 000002BB 58                  <1>     pop rax
   220 000002BC C3                  <1>     ret
   221                              <1> 
   222                              <1> ; ------------------------------------------------------------------------------
   223                              <1> ; vga_print_string_color: Prints string at RSI with color specified in BL
   224                              <1> ; ------------------------------------------------------------------------------
   225                              <1> vga_print_string_color:
   226 000002BD 50                  <1>     push rax
   227 000002BE 8A0549FEFFFF        <1>     mov al, [current_attr]
