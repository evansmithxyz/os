    57 00002437 53                  <1>     push rbx
    58 00002438 51                  <1>     push rcx
    59 00002439 52                  <1>     push rdx
    60                              <1> 
    61 0000243A 25FF000000          <1>     and eax, 0xFF
    62 0000243F C1E010              <1>     shl eax, 16
    63                              <1> 
    64 00002442 83E31F              <1>     and ebx, 0x1F
    65 00002445 C1E30B              <1>     shl ebx, 11
    66 00002448 09D8                <1>     or eax, ebx
    67                              <1> 
    68 0000244A 83E107              <1>     and ecx, 0x07
    69 0000244D C1E108              <1>     shl ecx, 8
    70 00002450 09C8                <1>     or eax, ecx
    71                              <1> 
    72 00002452 81E2FC000000        <1>     and edx, 0xFC
    73 00002458 09D0                <1>     or eax, edx
    74 0000245A 0D00000080          <1>     or eax, 0x80000000
    75                              <1> 
    76 0000245F 66BAF80C            <1>     mov dx, PCI_CONFIG_ADDR
    77 00002463 EF                  <1>     out dx, eax
    78                              <1> 
    79 00002464 4489C0              <1>     mov eax, r8d
    80 00002467 66BAFC0C            <1>     mov dx, PCI_CONFIG_DATA
    81 0000246B EF                  <1>     out dx, eax
    82                              <1> 
    83 0000246C 5A                  <1>     pop rdx
    84 0000246D 59                  <1>     pop rcx
    85 0000246E 5B                  <1>     pop rbx
    86 0000246F 58                  <1>     pop rax
    87 00002470 C3                  <1>     ret
    88                              <1> 
    89                              <1> ; ------------------------------------------------------------------------------
    90                              <1> ; pci_find_device: Scans PCI bus for matching VendorID and DeviceID
    91                              <1> ; Input:  SI = VendorID (16-bit), DI = DeviceID (16-bit)
    92                              <1> ; Output: ZF=1 if found, with:
    93                              <1> ;         EAX = bus, EBX = slot, ECX = func
    94                              <1> ;         ZF=0 if not found
    95                              <1> ; ------------------------------------------------------------------------------
    96                              <1> pci_find_device:
    97 00002471 4150                <1>     push r8
    98 00002473 4151                <1>     push r9
    99 00002475 4152                <1>     push r10
   100 00002477 4153                <1>     push r11
   101                              <1> 
   102 00002479 664189F0            <1>     mov r8w, si                 ; R8W = Target VendorID
   103 0000247D 664189F9            <1>     mov r9w, di                 ; R9W = Target DeviceID
   104                              <1> 
   105 00002481 4531D2              <1>     xor r10d, r10d              ; R10D = bus (0 .. 7)
   106                              <1> .bus_loop:
   107 00002484 4531DB              <1>     xor r11d, r11d              ; R11D = slot (0 .. 31)
   108                              <1> .slot_loop:
   109 00002487 31C9                <1>     xor ecx, ecx                ; ECX = func (0 .. 7)
   110                              <1> .func_loop:
   111 00002489 4489D0              <1>     mov eax, r10d               ; bus
   112 0000248C 4489DB              <1>     mov ebx, r11d               ; slot
   113 0000248F 31D2                <1>     xor edx, edx                ; offset 0x00 (Vendor & Device ID)
   114 00002491 E86AFFFFFF          <1>     call pci_read_dword
   115                              <1> 
   116 00002496 6683F8FF            <1>     cmp ax, 0xFFFF              ; Vendor 0xFFFF = No device present
   117 0000249A 7427                <1>     je .next_slot               ; If func 0 is missing, skip remaining funcs for this slot
   118                              <1> 
   119                              <1>     ; Check if VendorID and DeviceID match
   120 0000249C 664439C0            <1>     cmp ax, r8w
   121 000024A0 751A                <1>     jne .check_next_func
   122 000024A2 C1E810              <1>     shr eax, 16
   123 000024A5 664439C8            <1>     cmp ax, r9w
   124 000024A9 7511                <1>     jne .check_next_func
   125                              <1> 
   126                              <1>     ; MATCH FOUND!
   127 000024AB 4489D0              <1>     mov eax, r10d               ; Return bus
   128 000024AE 4489DB              <1>     mov ebx, r11d               ; Return slot
   129                              <1>     ; ECX already holds func
   130 000024B1 415B                <1>     pop r11
   131 000024B3 415A                <1>     pop r10
   132 000024B5 4159                <1>     pop r9
   133 000024B7 4158                <1>     pop r8
   134 000024B9 39C0                <1>     cmp eax, eax                ; Set ZF=1
   135 000024BB C3                  <1>     ret
   136                              <1> 
   137                              <1> .check_next_func:
   138 000024BC FFC1                <1>     inc ecx
   139 000024BE 83F908              <1>     cmp ecx, 8
   140 000024C1 7CC6                <1>     jl .func_loop
   141                              <1> 
   142                              <1> .next_slot:
   143 000024C3 41FFC3              <1>     inc r11d
   144 000024C6 4183FB20            <1>     cmp r11d, 32
   145 000024CA 7CBB                <1>     jl .slot_loop
   146                              <1> 
   147 000024CC 41FFC2              <1>     inc r10d
   148 000024CF 4183FA08            <1>     cmp r10d, 8
   149 000024D3 7CAF                <1>     jl .bus_loop
   150                              <1> 
   151                              <1>     ; Not found
   152 000024D5 415B                <1>     pop r11
   153 000024D7 415A                <1>     pop r10
   154 000024D9 4159                <1>     pop r9
   155 000024DB 4158                <1>     pop r8
   156 000024DD 85E4                <1>     test esp, esp               ; Set ZF=0
   157 000024DF C3                  <1>     ret
   158                              <1> 
   159                              <1> ; ------------------------------------------------------------------------------
   160                              <1> ; pci_enable_bus_master: Enables Bus Mastering and I/O Space on a PCI device
   161                              <1> ; Input:  EAX = bus, EBX = slot, ECX = func
   162                              <1> ; ------------------------------------------------------------------------------
   163                              <1> pci_enable_bus_master:
   164 000024E0 50                  <1>     push rax
   165 000024E1 53                  <1>     push rbx
   166 000024E2 51                  <1>     push rcx
   167 000024E3 52                  <1>     push rdx
   168 000024E4 4150                <1>     push r8
   169 000024E6 4151                <1>     push r9
   170 000024E8 4152                <1>     push r10
   171 000024EA 4153                <1>     push r11
   172                              <1> 
   173 000024EC 4189C1              <1>     mov r9d, eax                ; R9D = bus
   174 000024EF 4189DA              <1>     mov r10d, ebx               ; R10D = slot
   175 000024F2 4189CB              <1>     mov r11d, ecx               ; R11D = func
   176                              <1> 
   177                              <1>     ; Read current Command register (offset 0x04)
   178 000024F5 4489C8              <1>     mov eax, r9d
   179 000024F8 4489D3              <1>     mov ebx, r10d
   180 000024FB 4489D9              <1>     mov ecx, r11d
   181 000024FE BA04000000          <1>     mov edx, 0x04
