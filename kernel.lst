   519 00003FEF 6BC906              <1>     imul ecx, 6
   520 00003FF2 4801CE              <1>     add rsi, rcx
   521 00003FF5 B906000000          <1>     mov rcx, 6
   522 00003FFA F3A4                <1>     rep movsb
   523 00003FFC 4831C0              <1>     xor rax, rax
   524                              <1> 
