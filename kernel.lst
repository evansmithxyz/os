  1758 0000C506 750B                <1>     jne .chk_ls
  1759 0000C508 803E72              <1>     cmp byte [rsi], 'r'
  1760 0000C50B 7506                <1>     jne .chk_ls
  1761 0000C50D 807E016D            <1>     cmp byte [rsi+1], 'm'
  1762 0000C511 742D                <1>     je .tab_file_mode
  1763                              <1> 
