   229 000002C5 881D42FEFFFF        <1>     mov [current_attr], bl
   230 000002CB E8DCFFFFFF          <1>     call vga_print_string
   231 000002D0 58                  <1>     pop rax
   232 000002D1 880536FEFFFF        <1>     mov [current_attr], al
   233 000002D7 58                  <1>     pop rax
   234 000002D8 C3                  <1>     ret
   235                              <1> 
