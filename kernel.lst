   376                              <1> ; ------------------------------------------------------------------------------
   377                              <1> ; fs_write_content: Writes string content into a file
   378                              <1> ; Input:
   379                              <1> ;   RSI = Filename
   380                              <1> ;   RDX = Pointer to text data
