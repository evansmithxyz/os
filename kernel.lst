   481 00003F9B 4989C4              <1>     mov r12, rax
   482                              <1> .poll_loop:
   483 00003F9E E89FF4FFFF          <1>     call net_poll
   484                              <1> 
   485                              <1>     ; Re-check cache
   486 00003FA3 31C9                <1>     xor ecx, ecx
   487                              <1> .recheck:
   488 00003FA5 80B9[94350000]01    <1>     cmp byte [arp_cache_valid + rcx], 1
   489 00003FAC 7509                <1>     jne .recheck_next
   490 00003FAE 39048D[44350000]    <1>     cmp [arp_cache_ip + rcx * 4], eax
   491 00003FB5 7431                <1>     je .cache_hit
   492                              <1> .recheck_next:
   493 00003FB7 FFC1                <1>     inc ecx
   494 00003FB9 83F908              <1>     cmp ecx, ARP_CACHE_MAX
   495 00003FBC 7CE7                <1>     jl .recheck
   496                              <1> 
   497                              <1>     ; Micro pause
   498 00003FBE B9E8030000          <1>     mov ecx, 1000
   499                              <1> .spin:
   500 00003FC3 F390                <1>     pause
   501 00003FC5 FFC9                <1>     dec ecx
   502 00003FC7 75FA                <1>     jnz .spin
   503                              <1> 
   504 00003FC9 488B0562D5FFFF      <1>     mov rax, [timer_ticks]
