  1728 0000C4C0 751D                <1>     jne .chk_write
  1729 0000C4C2 803E74              <1>     cmp byte [rsi], 't'
  1730 0000C4C5 7518                <1>     jne .chk_write
  1731 0000C4C7 807E016F            <1>     cmp byte [rsi+1], 'o'
  1732 0000C4CB 7512                <1>     jne .chk_write
  1733 0000C4CD 807E0275            <1>     cmp byte [rsi+2], 'u'
  1734 0000C4D1 750C                <1>     jne .chk_write
  1735 0000C4D3 807E0363            <1>     cmp byte [rsi+3], 'c'
  1736 0000C4D7 7506                <1>     jne .chk_write
  1737 0000C4D9 807E0468            <1>     cmp byte [rsi+4], 'h'
  1738 0000C4DD 7461                <1>     je .tab_file_mode
