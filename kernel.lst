     8                              <1> ; GUI Palette & Theme Colors
     9                              <1> GUI_CLR_DESK_TOP        equ 0x000F172A   ; Deep Obsidian Slate
    10                              <1> GUI_CLR_DESK_BOT        equ 0x00020617   ; Midnight Abyss Black
