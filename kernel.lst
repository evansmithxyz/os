   120                                  %include "keyboard.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-bit PS/2 Keyboard Driver & Scancode Decoder
     3                              <1> ; Translates Set-1 scancodes into ASCII characters and manages input buffer
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> INPUT_BUFFER_MAX equ 128
     9                              <1> 
    10 0000168E 00                  <1> shift_state:        db 0
    11 0000168F 00                  <1> line_ready:         db 0
    12 00001690 00                  <1> tab_requested:      db 0
    13 00001691 00                  <1> gui_last_scancode:  db 0
    14 00001692 00                  <1> gui_last_key:       db 0
    15 00001693 0000000000000000    <1> input_len:          dq 0
    16 0000169B 00<rep 80h>         <1> input_buffer:       times INPUT_BUFFER_MAX db 0
    17                              <1> 
    18                              <1> ; Scancode Set 1 Lowercase Translation Table (Index = Scancode, 0x00 - 0x39)
    19                              <1> scancode_table:
    20 0000171B 001B31323334353637- <1>     db 0, 27, '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 0x08, 0x09
    20 00001724 3839302D3D0809      <1>
    21 0000172B 71776572747975696F- <1>     db 'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 0x0D, 0
    21 00001734 705B5D0D00          <1>
    22 00001739 6173646667686A6B6C- <1>     db 'a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', "'", '`', 0, '\'
    22 00001742 3B2760005C          <1>
    23 00001747 7A786376626E6D2C2E- <1>     db 'z', 'x', 'c', 'v', 'b', 'n', 'm', ',', '.', '/', 0, '*', 0, ' '
    23 00001750 2F002A0020          <1>
    24                              <1> 
    25                              <1> ; Scancode Set 1 Uppercase / Shift Translation Table
    26                              <1> scancode_table_shift:
    27 00001755 001B21402324255E26- <1>     db 0, 27, '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+', 0x08, 0x09
    27 0000175E 2A28295F2B0809      <1>
    28 00001765 51574552545955494F- <1>     db 'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '{', '}', 0x0D, 0
    28 0000176E 507B7D0D00          <1>
    29 00001773 4153444647484A4B4C- <1>     db 'A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', ':', '"', '~', 0, '|'
    29 0000177C 3A227E007C          <1>
    30 00001781 5A584356424E4D3C3E- <1>     db 'Z', 'X', 'C', 'V', 'B', 'N', 'M', '<', '>', '?', 0, '*', 0, ' '
    30 0000178A 3F002A0020          <1>
    31                              <1> 
    32                              <1> ; ------------------------------------------------------------------------------
    33                              <1> ; keyboard_process_scancode: Called by 64-bit ISR when a key is pressed/released
    34                              <1> ; Input: AL = raw scancode from port 0x60
    35                              <1> ; ------------------------------------------------------------------------------
    36                              <1> keyboard_process_scancode:
    37 0000178F 50                  <1>     push rax
    38 00001790 53                  <1>     push rbx
    39 00001791 51                  <1>     push rcx
    40 00001792 52                  <1>     push rdx
    41                              <1> 
    42                              <1>     ; If GUI / BGA is active, handle keyboard without echoing to text mode
    43 00001793 803DDB66000001      <1>     cmp byte [bga_active], 1
    44 0000179A 752B                <1>     jne .text_mode_keyboard
    45                              <1> 
    46                              <1>     ; GUI Mode Keyboard Input:
    47 0000179C A880                <1>     test al, 0x80               ; Ignore key release
    48 0000179E 0F850A010000        <1>     jnz .done
    49 000017A4 8805E7FEFFFF        <1>     mov [gui_last_scancode], al
    50 000017AA 3C39                <1>     cmp al, 0x39
    51 000017AC 0F87FC000000        <1>     ja .done
    52 000017B2 480FB6D8            <1>     movzx rbx, al
    53 000017B6 8A9B[1B170000]      <1>     mov bl, [scancode_table + rbx]
    54 000017BC 881DD0FEFFFF        <1>     mov [gui_last_key], bl
    55 000017C2 E9E7000000          <1>     jmp .done
    56                              <1> 
    57                              <1> .text_mode_keyboard:
    58                              <1> 
    59                              <1>     ; Handle Shift Key Press (Make code: 0x2A = LShift, 0x36 = RShift)
    60 000017C7 3C2A                <1>     cmp al, 0x2A
    61 000017C9 0F84CF000000        <1>     je .shift_down
    62 000017CF 3C36                <1>     cmp al, 0x36
    63 000017D1 0F84C7000000        <1>     je .shift_down
    64                              <1> 
    65                              <1>     ; Handle Shift Key Release (Break code: 0xAA = LShift, 0xB6 = RShift)
    66 000017D7 3CAA                <1>     cmp al, 0xAA
    67 000017D9 0F84C8000000        <1>     je .shift_up
    68 000017DF 3CB6                <1>     cmp al, 0xB6
    69 000017E1 0F84C0000000        <1>     je .shift_up
    70                              <1> 
    71                              <1>     ; Ignore other break codes (bit 7 set = key release)
    72 000017E7 A880                <1>     test al, 0x80
    73 000017E9 0F85BF000000        <1>     jnz .done
    74                              <1> 
    75                              <1>     ; Validate scancode within table range (< 0x3A)
    76 000017EF 3C39                <1>     cmp al, 0x39
    77 000017F1 0F87B7000000        <1>     ja .done
    78                              <1> 
    79                              <1>     ; Convert scancode to ASCII
    80 000017F7 480FB6D8            <1>     movzx rbx, al
    81 000017FB 803D8CFEFFFF01      <1>     cmp byte [shift_state], 1
    82 00001802 7408                <1>     je .use_shift_table
    83 00001804 8A83[1B170000]      <1>     mov al, [scancode_table + rbx]
    84 0000180A EB06                <1>     jmp .handle_ascii
    85                              <1> 
    86                              <1> .use_shift_table:
    87 0000180C 8A83[55170000]      <1>     mov al, [scancode_table_shift + rbx]
    88                              <1> 
    89                              <1> .handle_ascii:
    90 00001812 84C0                <1>     test al, al
    91 00001814 0F8494000000        <1>     jz .done
    92                              <1> 
    93                              <1>     ; Check for Enter (0x0D)
    94 0000181A 3C0D                <1>     cmp al, 0x0D
    95 0000181C 745D                <1>     je .handle_enter
    96                              <1> 
    97                              <1>     ; Check for Backspace (0x08)
    98 0000181E 3C08                <1>     cmp al, 0x08
    99 00001820 7435                <1>     je .handle_backspace
   100                              <1> 
   101                              <1>     ; Check for Tab (0x09)
   102 00001822 3C09                <1>     cmp al, 0x09
   103 00001824 7428                <1>     je .handle_tab
   104                              <1> 
   105                              <1>     ; Regular printable character
   106 00001826 488B0D66FEFFFF      <1>     mov rcx, [input_len]
   107 0000182D 4883F97E            <1>     cmp rcx, INPUT_BUFFER_MAX - 2
   108 00001831 737B                <1>     jae .done
   109                              <1> 
   110                              <1>     ; Append to buffer
   111 00001833 8881[9B160000]      <1>     mov [input_buffer + rcx], al
   112 00001839 48FF0553FEFFFF      <1>     inc qword [input_len]
   113 00001840 C681[9C160000]00    <1>     mov byte [input_buffer + rcx + 1], 0
   114                              <1> 
   115                              <1>     ; Echo character to screen
   116 00001847 E827E9FFFF          <1>     call vga_print_char
   117 0000184C EB60                <1>     jmp .done
   118                              <1> 
   119                              <1> .handle_tab:
   120 0000184E C6053BFEFFFF01      <1>     mov byte [tab_requested], 1
   121 00001855 EB57                <1>     jmp .done
   122                              <1> 
   123                              <1> .handle_backspace:
   124 00001857 488B0D35FEFFFF      <1>     mov rcx, [input_len]
   125 0000185E 4885C9              <1>     test rcx, rcx
   126 00001861 744B                <1>     jz .done
   127 00001863 48FF0D29FEFFFF      <1>     dec qword [input_len]
   128 0000186A 48FFC9              <1>     dec rcx
   129 0000186D C681[9B160000]00    <1>     mov byte [input_buffer + rcx], 0
   130 00001874 E8FAE8FFFF          <1>     call vga_print_char
   131 00001879 EB33                <1>     jmp .done
   132                              <1> 
   133                              <1> .handle_enter:
   134 0000187B 488B0D11FEFFFF      <1>     mov rcx, [input_len]
   135 00001882 C681[9B160000]00    <1>     mov byte [input_buffer + rcx], 0
   136 00001889 C605FFFDFFFF01      <1>     mov byte [line_ready], 1
   137 00001890 E8DEE8FFFF          <1>     call vga_print_char
   138 00001895 B00A                <1>     mov al, 0x0A
   139 00001897 E8D7E8FFFF          <1>     call vga_print_char
   140 0000189C EB10                <1>     jmp .done
   141                              <1> 
   142                              <1> .shift_down:
   143 0000189E C605E9FDFFFF01      <1>     mov byte [shift_state], 1
   144 000018A5 EB07                <1>     jmp .done
   145                              <1> 
   146                              <1> .shift_up:
   147 000018A7 C605E0FDFFFF00      <1>     mov byte [shift_state], 0
   148                              <1> 
   149                              <1> .done:
   150 000018AE 5A                  <1>     pop rdx
   151 000018AF 59                  <1>     pop rcx
   152 000018B0 5B                  <1>     pop rbx
   153 000018B1 58                  <1>     pop rax
   154 000018B2 C3                  <1>     ret
   155                              <1> 
   156                              <1> ; ------------------------------------------------------------------------------
   157                              <1> ; keyboard_clear_buffer: Resets line input buffer for next command
   158                              <1> ; ------------------------------------------------------------------------------
   159                              <1> keyboard_clear_buffer:
   160 000018B3 50                  <1>     push rax
   161 000018B4 48C705D4FDFFFF0000- <1>     mov qword [input_len], 0
   161 000018BD 0000                <1>
   162 000018BF C605C9FDFFFF00      <1>     mov byte [line_ready], 0
   163 000018C6 C605C3FDFFFF00      <1>     mov byte [tab_requested], 0
   164 000018CD C605C7FDFFFF00      <1>     mov byte [input_buffer], 0
   165 000018D4 58                  <1>     pop rax
   166 000018D5 C3                  <1>     ret
   121                                  %include "ata.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-Bit ATA PIO Hard Disk Controller Driver
     3                              <1> ; Reads and writes 512-byte raw sectors via Primary ATA Bus (Ports 0x1F0-0x1F7)
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ; Primary ATA Bus I/O Ports
     9                              <1> ATA_DATA        equ 0x1F0
    10                              <1> ATA_ERROR       equ 0x1F1
    11                              <1> ATA_SECT_CNT    equ 0x1F2
    12                              <1> ATA_LBA_LOW     equ 0x1F3
    13                              <1> ATA_LBA_MID     equ 0x1F4
    14                              <1> ATA_LBA_HIGH    equ 0x1F5
    15                              <1> ATA_DRIVE_HEAD  equ 0x1F6
    16                              <1> ATA_STATUS_CMD  equ 0x1F7
    17                              <1> 
    18                              <1> ; ATA Commands
    19                              <1> ATA_CMD_READ    equ 0x20
    20                              <1> ATA_CMD_WRITE   equ 0x30
    21                              <1> ATA_CMD_FLUSH   equ 0xE7
    22                              <1> 
    23                              <1> ; ATA Status Bits
    24                              <1> ATA_STATUS_BSY  equ 0x80        ; Drive is preparing/busy
    25                              <1> ATA_STATUS_DRQ  equ 0x08        ; Data Request ready
    26                              <1> ATA_STATUS_ERR  equ 0x01        ; Error occurred
    27                              <1> ATA_STATUS_DF   equ 0x20        ; Device Fault
    28                              <1> 
    29                              <1> ; ------------------------------------------------------------------------------
    30                              <1> ; ata_wait_bsy: Polls until BSY flag (bit 7) is cleared
    31                              <1> ; ------------------------------------------------------------------------------
    32                              <1> ata_wait_bsy:
    33 000018D6 52                  <1>     push rdx
    34 000018D7 66BAF701            <1>     mov dx, ATA_STATUS_CMD
    35                              <1> .loop:
    36 000018DB EC                  <1>     in al, dx
    37 000018DC A880                <1>     test al, ATA_STATUS_BSY
    38 000018DE 75FB                <1>     jnz .loop
    39 000018E0 5A                  <1>     pop rdx
    40 000018E1 C3                  <1>     ret
    41                              <1> 
    42                              <1> ; ------------------------------------------------------------------------------
    43                              <1> ; ata_wait_ready: Waits 400ns, then polls until BSY=0 and DRQ=1
    44                              <1> ; Returns: RAX = 0 (Success), RAX = 1 (Error)
    45                              <1> ; ------------------------------------------------------------------------------
    46                              <1> ata_wait_ready:
    47 000018E2 52                  <1>     push rdx
    48                              <1> 
    49                              <1>     ; Read status 4 times for standard 400ns ATA bus recovery
    50 000018E3 66BAF701            <1>     mov dx, ATA_STATUS_CMD
    51 000018E7 EC                  <1>     in al, dx
    52 000018E8 EC                  <1>     in al, dx
    53 000018E9 EC                  <1>     in al, dx
    54 000018EA EC                  <1>     in al, dx
    55                              <1> 
    56                              <1> .poll:
    57 000018EB EC                  <1>     in al, dx
    58 000018EC A880                <1>     test al, ATA_STATUS_BSY
    59 000018EE 75FB                <1>     jnz .poll                   ; Wait if still busy
    60                              <1> 
    61 000018F0 A801                <1>     test al, ATA_STATUS_ERR
    62 000018F2 750D                <1>     jnz .fail
    63 000018F4 A820                <1>     test al, ATA_STATUS_DF
    64 000018F6 7509                <1>     jnz .fail
    65                              <1> 
    66 000018F8 A808                <1>     test al, ATA_STATUS_DRQ
    67 000018FA 74EF                <1>     jz .poll                    ; Wait until data request ready
    68                              <1> 
    69 000018FC 4831C0              <1>     xor rax, rax                ; Success
    70 000018FF 5A                  <1>     pop rdx
    71 00001900 C3                  <1>     ret
    72                              <1> 
    73                              <1> .fail:
    74 00001901 B801000000          <1>     mov rax, 1                  ; Error
    75 00001906 5A                  <1>     pop rdx
    76 00001907 C3                  <1>     ret
    77                              <1> 
    78                              <1> ; ------------------------------------------------------------------------------
    79                              <1> ; ata_read_sector: Reads one 512-byte sector from disk into RAM
    80                              <1> ; Input:
    81                              <1> ;   RAX = 28-bit LBA sector address
    82                              <1> ;   RDI = Destination buffer in memory (512 bytes)
    83                              <1> ; Returns:
    84                              <1> ;   RAX = 0 on success, 1 on failure
    85                              <1> ; ------------------------------------------------------------------------------
    86                              <1> ata_read_sector:
    87 00001908 53                  <1>     push rbx
    88 00001909 51                  <1>     push rcx
    89 0000190A 52                  <1>     push rdx
    90 0000190B 57                  <1>     push rdi
    91                              <1> 
    92 0000190C 4889C3              <1>     mov rbx, rax                ; RBX = LBA sector
    93                              <1> 
    94 0000190F E8C2FFFFFF          <1>     call ata_wait_bsy
    95                              <1> 
    96                              <1>     ; Send 0xE0 | LBA[27:24] to Drive/Head port
    97 00001914 4889D8              <1>     mov rax, rbx
    98 00001917 48C1E818            <1>     shr rax, 24
    99 0000191B 240F                <1>     and al, 0x0F
   100 0000191D 0CE0                <1>     or al, 0xE0                 ; Master drive, LBA28 mode
   101 0000191F 66BAF601            <1>     mov dx, ATA_DRIVE_HEAD
   102 00001923 EE                  <1>     out dx, al
   103                              <1> 
   104                              <1>     ; Sector count = 1
   105 00001924 66BAF201            <1>     mov dx, ATA_SECT_CNT
   106 00001928 B001                <1>     mov al, 1
   107 0000192A EE                  <1>     out dx, al
   108                              <1> 
   109                              <1>     ; LBA bits 0-7
   110 0000192B 4889D8              <1>     mov rax, rbx
   111 0000192E 66BAF301            <1>     mov dx, ATA_LBA_LOW
   112 00001932 EE                  <1>     out dx, al
   113                              <1> 
   114                              <1>     ; LBA bits 8-15
   115 00001933 48C1E808            <1>     shr rax, 8
   116 00001937 66BAF401            <1>     mov dx, ATA_LBA_MID
   117 0000193B EE                  <1>     out dx, al
   118                              <1> 
   119                              <1>     ; LBA bits 16-23
   120 0000193C 48C1E808            <1>     shr rax, 8
   121 00001940 66BAF501            <1>     mov dx, ATA_LBA_HIGH
   122 00001944 EE                  <1>     out dx, al
   123                              <1> 
   124                              <1>     ; Send Read command (0x20)
   125 00001945 66BAF701            <1>     mov dx, ATA_STATUS_CMD
   126 00001949 B020                <1>     mov al, ATA_CMD_READ
   127 0000194B EE                  <1>     out dx, al
   128                              <1> 
   129                              <1>     ; Wait until data is ready in buffer
   130 0000194C E891FFFFFF          <1>     call ata_wait_ready
   131 00001951 4885C0              <1>     test rax, rax
   132 00001954 7519                <1>     jnz .error
   133                              <1> 
   134                              <1>     ; Read 256 16-bit words (512 bytes) from Data port
   135 00001956 66BAF001            <1>     mov dx, ATA_DATA
   136 0000195A B900010000          <1>     mov rcx, 256
   137                              <1> .read_loop:
   138 0000195F 66ED                <1>     in ax, dx
   139 00001961 668907              <1>     mov [rdi], ax
   140 00001964 4883C702            <1>     add rdi, 2
   141 00001968 E2F5                <1>     loop .read_loop
   142                              <1> 
   143 0000196A 4831C0              <1>     xor rax, rax                ; Success
   144 0000196D EB05                <1>     jmp .done
   145                              <1> 
   146                              <1> .error:
   147 0000196F B801000000          <1>     mov rax, 1
   148                              <1> 
   149                              <1> .done:
   150 00001974 5F                  <1>     pop rdi
   151 00001975 5A                  <1>     pop rdx
   152 00001976 59                  <1>     pop rcx
   153 00001977 5B                  <1>     pop rbx
   154 00001978 C3                  <1>     ret
   155                              <1> 
   156                              <1> ; ------------------------------------------------------------------------------
   157                              <1> ; ata_write_sector: Writes one 512-byte sector from RAM to disk
   158                              <1> ; Input:
   159                              <1> ;   RAX = 28-bit LBA sector address
   160                              <1> ;   RSI = Source buffer in memory (512 bytes)
   161                              <1> ; Returns:
   162                              <1> ;   RAX = 0 on success, 1 on failure
   163                              <1> ; ------------------------------------------------------------------------------
   164                              <1> ata_write_sector:
   165 00001979 53                  <1>     push rbx
   166 0000197A 51                  <1>     push rcx
   167 0000197B 52                  <1>     push rdx
   168 0000197C 56                  <1>     push rsi
   169                              <1> 
   170 0000197D 4889C3              <1>     mov rbx, rax                ; RBX = LBA sector
   171                              <1> 
   172 00001980 E851FFFFFF          <1>     call ata_wait_bsy
   173                              <1> 
   174                              <1>     ; Send 0xE0 | LBA[27:24] to Drive/Head port
   175 00001985 4889D8              <1>     mov rax, rbx
   176 00001988 48C1E818            <1>     shr rax, 24
   177 0000198C 240F                <1>     and al, 0x0F
   178 0000198E 0CE0                <1>     or al, 0xE0
   179 00001990 66BAF601            <1>     mov dx, ATA_DRIVE_HEAD
   180 00001994 EE                  <1>     out dx, al
   181                              <1> 
   182                              <1>     ; Sector count = 1
   183 00001995 66BAF201            <1>     mov dx, ATA_SECT_CNT
   184 00001999 B001                <1>     mov al, 1
   185 0000199B EE                  <1>     out dx, al
   186                              <1> 
   187                              <1>     ; LBA bits 0-7
   188 0000199C 4889D8              <1>     mov rax, rbx
   189 0000199F 66BAF301            <1>     mov dx, ATA_LBA_LOW
   190 000019A3 EE                  <1>     out dx, al
   191                              <1> 
   192                              <1>     ; LBA bits 8-15
   193 000019A4 48C1E808            <1>     shr rax, 8
   194 000019A8 66BAF401            <1>     mov dx, ATA_LBA_MID
   195 000019AC EE                  <1>     out dx, al
   196                              <1> 
   197                              <1>     ; LBA bits 16-23
   198 000019AD 48C1E808            <1>     shr rax, 8
   199 000019B1 66BAF501            <1>     mov dx, ATA_LBA_HIGH
   200 000019B5 EE                  <1>     out dx, al
   201                              <1> 
   202                              <1>     ; Send Write command (0x30)
   203 000019B6 66BAF701            <1>     mov dx, ATA_STATUS_CMD
   204 000019BA B030                <1>     mov al, ATA_CMD_WRITE
   205 000019BC EE                  <1>     out dx, al
   206                              <1> 
   207                              <1>     ; Wait until drive is ready to receive data
   208 000019BD E820FFFFFF          <1>     call ata_wait_ready
   209 000019C2 4885C0              <1>     test rax, rax
   210 000019C5 752A                <1>     jnz .error
   211                              <1> 
   212                              <1>     ; Write 256 16-bit words (512 bytes) to Data port
   213 000019C7 66BAF001            <1>     mov dx, ATA_DATA
   214 000019CB B900010000          <1>     mov rcx, 256
   215                              <1> .write_loop:
   216 000019D0 668B06              <1>     mov ax, [rsi]
   217 000019D3 66EF                <1>     out dx, ax
   218 000019D5 4883C602            <1>     add rsi, 2
   219 000019D9 E2F5                <1>     loop .write_loop
   220                              <1> 
   221                              <1>     ; Flush hardware write cache to commit data to physical disk
   222 000019DB E8F6FEFFFF          <1>     call ata_wait_bsy
   223 000019E0 66BAF701            <1>     mov dx, ATA_STATUS_CMD
   224 000019E4 B0E7                <1>     mov al, ATA_CMD_FLUSH
   225 000019E6 EE                  <1>     out dx, al
   226 000019E7 E8EAFEFFFF          <1>     call ata_wait_bsy
   227                              <1> 
   228 000019EC 4831C0              <1>     xor rax, rax                ; Success
   229 000019EF EB05                <1>     jmp .done
   230                              <1> 
   231                              <1> .error:
   232 000019F1 B801000000          <1>     mov rax, 1
   233                              <1> 
   234                              <1> .done:
   235 000019F6 5E                  <1>     pop rsi
   236 000019F7 5A                  <1>     pop rdx
   237 000019F8 59                  <1>     pop rcx
   238 000019F9 5B                  <1>     pop rbx
   239 000019FA C3                  <1>     ret
   122                                  %include "fs.asm"
     1                              <1> ; ==============================================================================
     2                              <1> ; Antigravity OS - 64-Bit AntigravityFS (AFS) Storage Subsystem
     3                              <1> ; Superblock, Inode Table, and Persistent File Management via ATA PIO
     4                              <1> ; ==============================================================================
     5                              <1> 
     6                              <1> [bits 64]
     7                              <1> 
     8                              <1> ; Disk Layout Constants
     9                              <1> FS_SUPERBLOCK_LBA   equ 129     ; LBA sector for AFS Superblock
    10                              <1> FS_INODE_LBA        equ 130     ; Starting LBA for Inode Table (2 sectors = 130, 131)
    11                              <1> FS_DATA_LBA         equ 132     ; Starting LBA for Data Blocks
    12                              <1> FS_TOTAL_SECTORS    equ 512     ; Disk size in sectors (256 KB)
    13                              <1> FS_MAX_INODES       equ 32      ; Maximum files supported
    14                              <1> FS_INODE_SIZE       equ 32      ; 32 bytes per inode (32 * 32 = 1024 bytes)
    15                              <1> 
    16                              <1> FS_MAGIC            equ 0x31534641 ; "AFS1" in little-endian ASCII
    17                              <1> 
    18                              <1> ; Inode Flags
    19                              <1> FS_FLAG_ALLOC       equ 0x01    ; Entry is in-use
    20                              <1> FS_FLAG_RO          equ 0x02    ; Read-only file
    21                              <1> 
    22                              <1> ; In-Memory Data Buffers
    23 000019FB 00                  <1> fs_mounted:         db 0
    24 000019FC 90<rep 4h>          <1> align 16
    25 00001A00 00<rep 400h>        <1> fs_inode_table:     times 1024 db 0     ; Cached 32 inodes in RAM
    26                              <1> align 16
    27 00001E00 00<rep 200h>        <1> fs_sector_buf:      times 512 db 0      ; Scratch sector buffer
