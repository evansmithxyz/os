   164                              <1> ; ------------------------------------------------------------------------------
   165                              <1> ; arp_handle_packet: Processes incoming ARP Requests and Replies
   166                              <1> ; Input:
   167                              <1> ;   RSI = Pointer to ARP packet data
   168                              <1> ;   RCX = Packet length
   169                              <1> ; ------------------------------------------------------------------------------
   170                              <1> arp_handle_packet:
   171 00003D01 50                  <1>     push rax
   172 00003D02 53                  <1>     push rbx
   173 00003D03 51                  <1>     push rcx
   174 00003D04 52                  <1>     push rdx
   175 00003D05 56                  <1>     push rsi
   176 00003D06 57                  <1>     push rdi
   177                              <1> 
   178 00003D07 4883F91C            <1>     cmp rcx, 28
