   188 00008FFA 7D71                <1>     jge .chk_mouse
   189 00008FFC C70570EFFFFF000000- <1>     mov dword [mouse_x], 0
   189 00009005 00                  <1>
   190 00009006 EB65                <1>     jmp .chk_mouse
   191                              <1> 
   192                              <1> .nudge_right:
