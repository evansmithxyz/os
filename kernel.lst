   510 00003FD5 488D355CF5FFFF      <1>     lea rsi, [gateway_mac]
   511 00003FDC B906000000          <1>     mov rcx, 6
   512 00003FE1 F3A4                <1>     rep movsb
   513 00003FE3 4831C0              <1>     xor rax, rax
   514 00003FE6 EB17                <1>     jmp .done
